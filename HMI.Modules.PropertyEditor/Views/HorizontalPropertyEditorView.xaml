<UserControl x:Class="HMI.Modules.PropertyEditor.Views.HorizontalPropertyEditorView" 
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
             xmlns:rad="http://schemas.telerik.com/2008/xaml/presentation">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/HMI.Modules.PropertyEditor;component/Themes/PropertyEditorStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <!--ShowInsertRow="False"-->
    <rad:RadGridView Name="uxPropertyGrid" 
                     AutoGenerateColumns="False" 
                     CanUserDeleteRows="False"
                     CanUserFreezeColumns="False"
                     CanUserInsertRows="False" 
                     CanUserReorderColumns="False" 
                     CanUserResizeColumns="True" 
                     CanUserSelect="True" 
                     ReorderColumnsMode="None" 
                     RowIndicatorVisibility="Visible" 
                     SelectionMode="Single" 
                     ShowColumnFooters="False" 
                     ShowColumnHeaders="True" 
                     ShowGroupPanel="False" 
                     rad:AnimationManager.IsAnimationEnabled="False" 
                     ItemsSource="{Binding Items}" 
                     SelectedItem="{Binding Path=SelectedItem, Mode=TwoWay}" />
</UserControl>