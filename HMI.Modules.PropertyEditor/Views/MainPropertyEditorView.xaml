<UserControl x:Class="HMI.Modules.PropertyEditor.Views.MainPropertyEditorView" 
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hmi="clr-namespace:HMI.Infrastructure;assembly=HMI.Infrastructure"
             xmlns:pe="clr-namespace:HMI.Modules.PropertyEditor">
    <ItemsControl hmi:RegionManager.RegionName="{x:Static pe:RegionNames.PropertyEditor}" FocusManager.IsFocusScope="True">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <Grid />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
    </ItemsControl>
</UserControl>