<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:Infrastructure="clr-namespace:HMI.Infrastructure.Converters;assembly=HMI.Infrastructure.Converters"
                    xmlns:rad="clr-namespace:Telerik.Windows.Controls;assembly=Telerik.Windows.Controls"
                    xmlns:Controls="clr-namespace:HMI.Modules.Design.Controls">
    <Infrastructure:TimeSpanToDoubleConverter x:Key="TimeSpanToDoubleConverter" />
    <Style x:Key="{x:Type Controls:AudioPlayer}" TargetType="{x:Type Controls:AudioPlayer}">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Controls:AudioPlayer}">
                    <Grid Background="#FF000000">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <MediaElement Name="uxMediaElement" LoadedBehavior="Manual" Source="{TemplateBinding Controls:AudioPlayer.MediaUri}" UnloadedBehavior="Stop" Visibility="Hidden" />
                        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <Image Name="uxPlay" Source="/HMI.Modules.Design;component/Resources/Images/PlayHS.png" Stretch="None" />
                            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.5*" />
                                    <ColumnDefinition Width="0.5*" />
                                </Grid.ColumnDefinitions>
                                <Image Name="uxPause" Margin="0" HorizontalAlignment="Right" Source="/HMI.Modules.Design;component/Resources/Images/PauseHS.png" Stretch="None" Visibility="Hidden" />
                                <Image Name="uxStop" Grid.Column="1" HorizontalAlignment="Left" Source="/HMI.Modules.Design;component/Resources/Images/StopHS.png" Stretch="None" Visibility="Hidden" />
                            </Grid>
                        </Grid>
                        <Grid Grid.Row="4" Height="28" VerticalAlignment="Top">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Image Name="uxVolumeIcon" Grid.Column="0" Width="Auto" Margin="0,5,-5,5" VerticalAlignment="Center" Source="/HMI.Modules.Design;component/Resources/Images/Volume.png" Stretch="None" />
                            <rad:RadSlider Name="uxVolume" Grid.Column="1" Width="100" Margin="0,5,5,5" VerticalAlignment="Center" Maximum="1" Minimum="0" Orientation="Horizontal" Value="{Binding Volume, ElementName=uxMediaElement, Mode=TwoWay}" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>