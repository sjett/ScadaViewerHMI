<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rad2="http://schemas.telerik.com/2008/xaml/presentation"
                    xmlns:Controls="clr-namespace:HMI.Modules.Design.Controls">
    <Style x:Key="{x:Type Controls:SliderBox}" TargetType="{x:Type Controls:SliderBox}">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Controls:SliderBox}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <rad2:RadNumericUpDown Name="uxTextValue" Control.FontFamily="{TemplateBinding Control.FontFamily}" Control.FontSize="{TemplateBinding Control.FontSize}" Control.FontStretch="{TemplateBinding Control.FontStretch}" Control.FontStyle="{TemplateBinding Control.FontStyle}" Control.FontWeight="{TemplateBinding Control.FontWeight}" IsInteger="{TemplateBinding Controls:SliderBox.IsInteger}" rad2:RadRangeBase.Maximum="{TemplateBinding Controls:SliderBox.MaxValue}" rad2:RadRangeBase.Minimum="{TemplateBinding Controls:SliderBox.MinValue}" ShowButtons="False" rad2:RadRangeBase.Value="{Binding Value, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                        <rad2:RadButton Name="uxExpandSlider" Grid.Column="2" Width="20">
                            <Path Data="M0,0L3.5,4 7,0z" Fill="{TemplateBinding Control.Foreground}" Stroke="{TemplateBinding Control.Foreground}" />
                        </rad2:RadButton>
                        <Popup Name="uxExpandSliderPopup" StaysOpen="False" PlacementTarget="{Binding ElementName=uxExpandSlider}">
                            <Border Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="1">
                                <rad2:RadSlider Name="uxSlider" Height="100" IsSnapToTickEnabled="{TemplateBinding Controls:SliderBox.IsInteger}" LargeChange="{TemplateBinding Controls:SliderBox.LargeIncrement}" Maximum="{TemplateBinding Controls:SliderBox.MaxValue}" Minimum="{TemplateBinding Controls:SliderBox.MinValue}" Orientation="Vertical" SmallChange="{TemplateBinding Controls:SliderBox.SmallIncrement}" TickFrequency="1" Value="{Binding Value, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                            </Border>
                        </Popup>
                        <Grid.Triggers>
                            <EventTrigger RoutedEvent="Button.Click" SourceName="uxExpandSlider">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <BooleanAnimationUsingKeyFrames Storyboard.TargetProperty="IsOpen" Storyboard.Target="{Binding ElementName=uxExpandSliderPopup}">
                                            <DiscreteBooleanKeyFrame KeyTime="0:0:0" Value="False" />
                                            <DiscreteBooleanKeyFrame KeyTime="0:0:0.1" Value="True" />
                                        </BooleanAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Grid.Triggers>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>