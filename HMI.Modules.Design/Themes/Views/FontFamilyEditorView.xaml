<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rad="http://schemas.telerik.com/2008/xaml/presentation"
                    xmlns:localize="clr-namespace:HMI.Common.Presentation.Localization;assembly=HMI.Common.Presentation"
                    xmlns:Views="clr-namespace:HMI.Modules.Design.Views"
                    >
    <Style x:Key="{x:Type Views:FontFamilyEditorView}" TargetType="{x:Type Views:FontFamilyEditorView}">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Views:FontFamilyEditorView}">
                    <rad:RadComboBox Name="uxEditor" Validation.ErrorTemplate="{TemplateBinding Validation.ErrorTemplate}" ItemsSource="{Binding Fonts, RelativeSource={RelativeSource TemplatedParent}}">
                        <rad:RadComboBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="300">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0.5*" />
                                        <ColumnDefinition Width="0.5*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" HorizontalAlignment="Left" Text="{Binding}" />
                                    <TextBlock Grid.Column="1" HorizontalAlignment="Left" TextBlock.FontFamily="{Binding}" Text="{localize:Resx ResxName=HMI.Modules.Design.Resources.EditorsTexts, Key=FontTest}" />
                                </Grid>
                            </DataTemplate>
                        </rad:RadComboBox.ItemTemplate>
                    </rad:RadComboBox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>