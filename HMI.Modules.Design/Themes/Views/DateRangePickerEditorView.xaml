<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
                    xmlns:rad="http://schemas.telerik.com/2008/xaml/presentation"
                    xmlns:Views="clr-namespace:HMI.Modules.Design.Views"
                    xmlns:localize="clr-namespace:HMI.Common.Presentation.Localization;assembly=HMI.Common.Presentation"
                    xmlns:gh="clr-namespace:HMI.Infrastructure.Converters;assembly=HMI.Infrastructure.Converters"
                    xmlns:Presentation="clr-namespace:HMI.Infrastructure.Presentation;assembly=HMI.Infrastructure.Interfaces"
                    xmlns:rtsc="clr-namespace:HMI.Modules.Design.Converters">
    <gh:ObjectEqualityToVisibilityConverter x:Key="ObjectEqualityToVisibilityConverter" />
    <rtsc:RangeToStringConverter x:Key="RangeToStringConverter" />
    <Style x:Key="DatePickerStyle" TargetType="{x:Type rad:RadDatePicker}">
        <Setter Property="FrameworkElement.Margin" Value="5" />
        <Setter Property="FrameworkElement.Width" Value="85" />
    </Style>
    <Style x:Key="{x:Type Views:DateRangePickerEditorView}" TargetType="{x:Type Views:DateRangePickerEditorView}">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Views:DateRangePickerEditorView}">
                    <Grid>
                        <rad:RadDropDownButton Name="uxEditor" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Content="{Binding Range, Mode=OneWay, Converter={StaticResource RangeToStringConverter}, RelativeSource={RelativeSource TemplatedParent}}" ToolTip="{Binding Range, Mode=OneWay, Converter={StaticResource RangeToStringConverter}, RelativeSource={RelativeSource TemplatedParent}}">
                            <rad:RadDropDownButton.DropDownContent>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <rad:RadComboBox Width="190" Margin="5" DisplayMemberPath="Text" SelectedValuePath="Range" ItemsSource="{Binding DateRanges, RelativeSource={RelativeSource TemplatedParent}}" SelectedValue="{Binding SelectedDateRange, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                                    <rad:RadDatePicker Grid.Row="1" DateSelectionMode="Day" Style="{StaticResource DatePickerStyle}" SelectedDate="{Binding StartDate, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Visibility="{Binding SelectedDateRange, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ObjectEqualityToVisibilityConverter}, ConverterParameter={x:Static Presentation:DateRange.Day}}" />
                                    <rad:RadDatePicker Grid.Row="1" DateSelectionMode="Day" Style="{StaticResource DatePickerStyle}" SelectedDate="{Binding StartDate, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Visibility="{Binding SelectedDateRange, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ObjectEqualityToVisibilityConverter}, ConverterParameter={x:Static Presentation:DateRange.Week}}" />
                                    <rad:RadDatePicker Grid.Row="1" DateSelectionMode="Month" Style="{StaticResource DatePickerStyle}" SelectedDate="{Binding StartDate, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Visibility="{Binding SelectedDateRange, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ObjectEqualityToVisibilityConverter}, ConverterParameter={x:Static Presentation:DateRange.Month}}" />
                                    <rad:RadDatePicker Grid.Row="1" DateSelectionMode="Year" Style="{StaticResource DatePickerStyle}" SelectedDate="{Binding StartDate, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Visibility="{Binding SelectedDateRange, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ObjectEqualityToVisibilityConverter}, ConverterParameter={x:Static Presentation:DateRange.Year}}" />
                                    <Grid Grid.Row="1" Visibility="{Binding SelectedDateRange, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ObjectEqualityToVisibilityConverter}, ConverterParameter={x:Static Presentation:DateRange.Range}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <rad:RadDatePicker Grid.Column="0" DateSelectionMode="Day" Style="{StaticResource DatePickerStyle}" SelectableDateEnd="{Binding EndDate, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" SelectedDate="{Binding StartDate, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                                        <rad:RadDatePicker Grid.Column="1" DateSelectionMode="Day" Style="{StaticResource DatePickerStyle}" SelectableDateStart="{Binding StartDate, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" SelectedDate="{Binding EndDate, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                                    </Grid>
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Visibility="{Binding SelectedDateRange, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ObjectEqualityToVisibilityConverter}, ConverterParameter={x:Static Presentation:DateRange.LastNDays}}">
                                        <TextBlock Margin="5" Text="{localize:Resx ResxName=HMI.Modules.Design.Resources.DateRangeTexts, Key=NumberOfDays}" />
                                        <rad:RadNumericUpDown Margin="5" IsInteger="True" Minimum="0" Value="{Binding Number, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Visibility="{Binding SelectedDateRange, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ObjectEqualityToVisibilityConverter}, ConverterParameter={x:Static Presentation:DateRange.LastNHours}}">
                                        <TextBlock Margin="5" Text="{localize:Resx ResxName=HMI.Modules.Design.Resources.DateRangeTexts, Key=NumberOfHours}" />
                                        <rad:RadNumericUpDown Margin="5" IsInteger="True" Minimum="0" Value="{Binding Number, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Visibility="{Binding SelectedDateRange, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ObjectEqualityToVisibilityConverter}, ConverterParameter={x:Static Presentation:DateRange.LastNMinutes}}">
                                        <TextBlock Margin="5" Text="{localize:Resx ResxName=HMI.Modules.Design.Resources.DateRangeTexts, Key=NumberOfMinutes}" />
                                        <rad:RadNumericUpDown Margin="5" IsInteger="True" Minimum="0" Value="{Binding Number, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                                    </StackPanel>
                                </Grid>
                            </rad:RadDropDownButton.DropDownContent>
                        </rad:RadDropDownButton>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>