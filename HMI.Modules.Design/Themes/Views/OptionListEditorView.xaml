<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rad="http://schemas.telerik.com/2008/xaml/presentation"
                    xmlns:localize="clr-namespace:HMI.Common.Presentation.Localization;assembly=HMI.Common.Presentation"
                    xmlns:Views="clr-namespace:HMI.Modules.Design.Views">
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <Style x:Key="{x:Type Views:OptionListEditorView}" TargetType="{x:Type Views:OptionListEditorView}">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Views:OptionListEditorView}">
                    <rad:RadComboBox Name="uxEditor" DisplayMemberPath="{TemplateBinding ItemsControl.DisplayMemberPath}" IsEditable="{TemplateBinding Views:OptionListEditorView.IsEditable}" ItemsSource="{TemplateBinding ItemsControl.ItemsSource}" Validation.ErrorTemplate="{TemplateBinding Validation.ErrorTemplate}" ClearSelectionButtonContent="{localize:Resx ResxName=HMI.Modules.Design.Resources.EditorsTexts, Key=Clear}" ClearSelectionButtonVisibility="{Binding IsUnselectable, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>