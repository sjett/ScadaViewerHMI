<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rad="http://schemas.telerik.com/2008/xaml/presentation"
                    xmlns:localize="clr-namespace:HMI.Common.Presentation.Localization;assembly=HMI.Common.Presentation"
                    
                    xmlns:Views="clr-namespace:HMI.Modules.Design.Views">
    <Style x:Key="{x:Type Views:CollectionEditorView}" TargetType="{x:Type Views:CollectionEditorView}">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Views:CollectionEditorView}">
                    <rad:RadButton Name="uxBrowse" Content="{localize:Resx ResxName=HMI.Modules.Design.Resources.EditorsTexts, Key=Browse}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>