<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:Views="clr-namespace:HMI.Modules.Design.Views"
                    xmlns:sb="clr-namespace:HMI.Modules.Design.Controls">
    <Style x:Key="{x:Type Views:OpacityEditorView}" TargetType="{x:Type Views:OpacityEditorView}">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Views:OpacityEditorView}">
                    <sb:SliderBox x:Name="uxEditor" LargeIncrement="0.1" MaxValue="1" MinValue="0" SmallIncrement="0.01" Validation.ErrorTemplate="{TemplateBinding Validation.ErrorTemplate}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>