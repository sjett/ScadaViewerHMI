<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    
                    xmlns:Views="clr-namespace:HMI.Modules.Design.Views">
  <Style x:Key="{x:Type Views:BooleanEditorView}" TargetType="{x:Type Views:BooleanEditorView}">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Views:BooleanEditorView}">
          <CheckBox Name="uxEditor" Validation.ErrorTemplate="{TemplateBinding Validation.ErrorTemplate}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>