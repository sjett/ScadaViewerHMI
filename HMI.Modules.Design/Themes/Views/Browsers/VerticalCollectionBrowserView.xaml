<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rad="http://schemas.telerik.com/2008/xaml/presentation"
                    xmlns:localize="clr-namespace:HMI.Common.Presentation.Localization;assembly=HMI.Common.Presentation"
                    xmlns:gh="clr-namespace:HMI.Infrastructure.Converters;assembly=HMI.Infrastructure.Converters"
                    xmlns:Browsers="clr-namespace:HMI.Modules.Design.Views.Browsers"
                    >
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/HMI.Modules.Design;component/Themes/Views/Browsers/Common.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <gh:InvertedBoolVisibilityConverter x:Key="InvertedBoolVisibilityConverter" />
    <Style x:Key="{x:Type Browsers:VerticalCollectionBrowserView}" TargetType="{x:Type Browsers:VerticalCollectionBrowserView}">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Browsers:VerticalCollectionBrowserView}">
                    <Grid Margin="7">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300" MinWidth="300" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{localize:Resx ResxName=HMI.Modules.Design.Resources.BrowserTexts, Key=Items}" />
                        <TextBlock Grid.Column="2" Margin="7,0,0,0" Text="{localize:Resx ResxName=HMI.Modules.Design.Resources.BrowserTexts, Key=Properties}" />
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            
                            <!--ShowInsertRow="False"-->
                            <rad:RadGridView Name="uxItemsGrid" Grid.Row="0" Grid.Column="0" AutoGenerateColumns="False" CanUserFreezeColumns="False" CanUserResizeColumns="False" RowIndicatorVisibility="Collapsed" ShowColumnFooters="False" ShowColumnHeaders="False" ShowGroupPanel="False" 
                                             CanUserInsertRows="False" 
                                             AutoExpandGroups="{Binding ExpandAllGroups}" CanUserDeleteRows="{Binding IsCollectionEditable}" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
                                <rad:RadGridView.Columns>
                                    <rad:GridViewDataColumn Width="*" IsReadOnly="True" DataMemberBinding="{Binding DisplayText}" />
                                </rad:RadGridView.Columns>
                            </rad:RadGridView>
                            <ItemsControl Grid.Row="1" hmi:RegionManager.RegionName="{x:Static Browsers:Regions.CollectionBrowserButtonsRegion}" Visibility="{Binding IsCollectionReadOnly, Converter={StaticResource InvertedBoolVisibilityConverter}}" xmlns:hmi="clr-namespace:HMI.Infrastructure;assembly=HMI.Infrastructure">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Grid />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Grid>
                        <GridSplitter Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Width="7" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#00FFFFFF" ResizeDirection="Columns" />
                        <ItemsControl Grid.Row="1" Grid.Column="2" hmi:RegionManager.RegionName="PropertyEditorRegion" xmlns:hmi="clr-namespace:HMI.Infrastructure;assembly=HMI.Infrastructure">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Grid />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>