<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rad="http://schemas.telerik.com/2008/xaml/presentation"
                    xmlns:gh="clr-namespace:HMI.Infrastructure.Converters;assembly=HMI.Infrastructure.Converters"
                    xmlns:Browsers="clr-namespace:HMI.Modules.Design.Views.Browsers">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/HMI.Modules.Design;component/Themes/Views/Browsers/Common.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <gh:InvertedBoolVisibilityConverter x:Key="InvertedBoolVisibilityConverter" />
    <Style x:Key="{x:Type Browsers:HorizontalCollectionBrowserView}" TargetType="{x:Type Browsers:HorizontalCollectionBrowserView}">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Browsers:HorizontalCollectionBrowserView}">
                    <Grid Margin="7">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ItemsControl Grid.Row="0" hmi:RegionManager.RegionName="HorizontalPropertyEditorRegion" DataContext="{Binding HorizontalPropertyEditorViewModel}" xmlns:hmi="clr-namespace:HMI.Infrastructure;assembly=HMI.Infrastructure">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Grid />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <ItemsControl Grid.Row="1" hmi:RegionManager.RegionName="{x:Static Browsers:Regions.CollectionBrowserButtonsRegion}" Visibility="{Binding IsCollectionReadOnly, Converter={StaticResource InvertedBoolVisibilityConverter}}" xmlns:hmi="clr-namespace:HMI.Infrastructure;assembly=HMI.Infrastructure">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Grid />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>