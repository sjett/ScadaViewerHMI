<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
                    xmlns:rad="http://schemas.telerik.com/2008/xaml/presentation"
                    xmlns:niss="clr-namespace:HMI.Modules.Design.Views.Browsers">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/HMI.Common.Browsers;component/Themes/Common.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <niss:NullItemStyleSelector x:Key="NullItemStyleSelector">
    <niss:NullItemStyleSelector.NullStyle>
      <Style TargetType="{x:Type rad:GridViewCell}">
        <Setter Property="Control.FontWeight" Value="Bold" />
        <Setter Property="Control.FontStyle" Value="Italic" />
      </Style>
    </niss:NullItemStyleSelector.NullStyle>
  </niss:NullItemStyleSelector>
</ResourceDictionary>