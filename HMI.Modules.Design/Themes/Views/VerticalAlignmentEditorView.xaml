<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rad="http://schemas.telerik.com/2008/xaml/presentation"
                    xmlns:gh="clr-namespace:HMI.Infrastructure.Converters;assembly=HMI.Infrastructure.Converters"
                    xmlns:Views="clr-namespace:HMI.Modules.Design.Views">
    <gh:VerticalAlignmentToBooleanConverter x:Key="VerticalAlignmentToBooleanConverter" />
    <Style x:Key="VerticalAlignmentEditorViewToggleButtonStyle" TargetType="{x:Type ToggleButton}">
        <Setter Property="FrameworkElement.Margin" Value="1" />
        <Setter Property="Control.BorderThickness" Value="1" />
        <Setter Property="Control.Padding" Value="2" />
    </Style>
    <Style x:Key="VerticalAlignmentEditorViewToggleButtonPathStyle" TargetType="{x:Type Path}">
        <Setter Property="FrameworkElement.Width" Value="18" />
        <Setter Property="FrameworkElement.Height" Value="16" />
        <Setter Property="Shape.Stretch" Value="Uniform" />
        <Setter Property="Shape.Fill" Value="#FF141414" />
    </Style>
    <Style x:Key="{x:Type Views:VerticalAlignmentEditorView}" TargetType="{x:Type Views:VerticalAlignmentEditorView}">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Views:VerticalAlignmentEditorView}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <rad:RadToggleButton Grid.Column="0" Style="{StaticResource VerticalAlignmentEditorViewToggleButtonStyle}" IsChecked="{Binding Alignment, ConverterParameter=Top, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource VerticalAlignmentToBooleanConverter}, Mode=TwoWay}">
                            <Path Data="M0,2L0,14 2,14 2,2z M4,4L14,4 14,7 4,7z M4,12L10,12 10,9 4,9z M18,2L18,14 17.5,14 17.5,2z" RenderTransformOrigin=".5,.5" Style="{StaticResource VerticalAlignmentEditorViewToggleButtonPathStyle}">
                                <Path.RenderTransform>
                                    <TransformGroup>
                                        <RotateTransform Angle="90" />
                                        <ScaleTransform ScaleX="-1" />
                                    </TransformGroup>
                                </Path.RenderTransform>
                            </Path>
                        </rad:RadToggleButton>
                        <rad:RadToggleButton Grid.Column="1" Style="{StaticResource VerticalAlignmentEditorViewToggleButtonStyle}" IsChecked="{Binding Alignment, ConverterParameter=Center, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource VerticalAlignmentToBooleanConverter}, Mode=TwoWay}">
                            <Path Data="M0,2L0,14 0.5,14 0.5,2z M4,4L14,4 14,7 4,7z M6,12L12,12 12,9 6,9z M18,2L18,14 17.5,14 17.5,2z M10,2L10,3 8,3 8,2z M10,7.5L10,8.5 8,8.5 8,7.5z M10,13L10,14 8,14 8,13z" RenderTransformOrigin=".5,.5" Style="{StaticResource VerticalAlignmentEditorViewToggleButtonPathStyle}">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="-90" />
                                </Path.RenderTransform>
                            </Path>
                        </rad:RadToggleButton>
                        <rad:RadToggleButton Grid.Column="2" Style="{StaticResource VerticalAlignmentEditorViewToggleButtonStyle}" IsChecked="{Binding Alignment, ConverterParameter=Bottom, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource VerticalAlignmentToBooleanConverter}, Mode=TwoWay}">
                            <Path Data="M0,2L0,14 0.5,14 0.5,2z M4,4L14,4 14,7 4,7z M14,12L8,12 8,9 14,9z M18,2L18,14 16,14 16,2z" RenderTransformOrigin=".5,.5" Style="{StaticResource VerticalAlignmentEditorViewToggleButtonPathStyle}">
                                <Path.RenderTransform>
                                    <TransformGroup>
                                        <RotateTransform Angle="90" />
                                        <ScaleTransform ScaleX="-1" />
                                    </TransformGroup>
                                </Path.RenderTransform>
                            </Path>
                        </rad:RadToggleButton>
                        <rad:RadToggleButton Grid.Column="3" Style="{StaticResource VerticalAlignmentEditorViewToggleButtonStyle}" IsChecked="{Binding Alignment, ConverterParameter=Stretch, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource VerticalAlignmentToBooleanConverter}, Mode=TwoWay}">
                            <Path Data="M0,2L0,14 2,14 2,2z M4,4L14,4 14,7 4,7z M4,12L14,12 14,9 4,9z M18,2L18,14 16,14 16,2z" RenderTransformOrigin=".5,.5" Style="{StaticResource VerticalAlignmentEditorViewToggleButtonPathStyle}">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="90" />
                                </Path.RenderTransform>
                            </Path>
                        </rad:RadToggleButton>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>