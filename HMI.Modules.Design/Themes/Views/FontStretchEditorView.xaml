<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rad="http://schemas.telerik.com/2008/xaml/presentation"
                    xmlns:Views="clr-namespace:HMI.Modules.Design.Views"
                    >
    <Style x:Key="{x:Type Views:FontStretchEditorView}" TargetType="{x:Type Views:FontStretchEditorView}">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Views:FontStretchEditorView}">
                    <rad:RadComboBox Name="uxEditor" Validation.ErrorTemplate="{TemplateBinding Validation.ErrorTemplate}" ItemsSource="{Binding Stretches, RelativeSource={RelativeSource TemplatedParent}}">
                        <rad:RadComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock TextBlock.FontStretch="{Binding}" Text="{Binding}" />
                            </DataTemplate>
                        </rad:RadComboBox.ItemTemplate>
                    </rad:RadComboBox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>