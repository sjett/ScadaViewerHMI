<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
                    xmlns:Views="clr-namespace:HMI.Modules.Design.Views">
    <Style x:Key="{x:Type Views:ColorEditorView}" TargetType="{x:Type Views:ColorEditorView}">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Views:ColorEditorView}">
                    <xctk:ColorPicker Name="uxEditor" AllowDrop="True" DisplayColorAndName="True" ShowRecentColors="True" Validation.ErrorTemplate="{TemplateBinding Validation.ErrorTemplate}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>