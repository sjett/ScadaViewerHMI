<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rad="http://schemas.telerik.com/2008/xaml/presentation"
                    xmlns:Views="clr-namespace:HMI.Modules.Design.Views">
    <Style x:Key="{x:Type Views:EnumEditorView}" TargetType="{x:Type Views:EnumEditorView}">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Views:EnumEditorView}">
                    <rad:RadComboBox Name="uxEditor" Validation.ErrorTemplate="{TemplateBinding Validation.ErrorTemplate}" ItemsSource="{Binding Values, RelativeSource={RelativeSource TemplatedParent}}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>