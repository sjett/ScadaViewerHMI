<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rad="http://schemas.telerik.com/2008/xaml/presentation"
                    xmlns:localize="clr-namespace:HMI.Common.Presentation.Localization;assembly=HMI.Common.Presentation"
                    xmlns:Views="clr-namespace:HMI.Modules.Design.Views">
    <Style x:Key="{x:Type Views:BrowserEditorView}" TargetType="{x:Type Views:BrowserEditorView}">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Views:BrowserEditorView}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" MinWidth="30" />
                        </Grid.ColumnDefinitions>
                        <TextBox Name="uxEditor" Validation.ErrorTemplate="{TemplateBinding Validation.ErrorTemplate}" />
                        <rad:RadButton Name="uxBrowse" Grid.Column="1" Content="{localize:Resx ResxName=HMI.Modules.Design.Resources.EditorsTexts, Key=Browse}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>