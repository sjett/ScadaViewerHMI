<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:Views="clr-namespace:HMI.Modules.Design.Views">
    <Style x:Key="{x:Type Views:TextEditorView}" TargetType="{x:Type Views:TextEditorView}">
        <Setter Property="FrameworkElement.Height" Value="22" />
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Views:TextEditorView}">
                    <Grid>
                        <TextBox Name="uxEditor" IsReadOnly="{TemplateBinding Views:TextEditorView.IsReadOnly}" Validation.ErrorTemplate="{TemplateBinding Validation.ErrorTemplate}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>