<my:SelectorBrowserWindow x:Class="HMI.Modules.Design.Views.Browsers.XamlBrowser" 
                          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
                           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
                          xmlns:rad="http://schemas.telerik.com/2008/xaml/presentation"
                           xmlns:my="clr-namespace:HMI.Common.Browsers.Views;assembly=HMI.Common.Browsers" 
                    xmlns:localize="clr-namespace:HMI.Common.Presentation.Localization;assembly=HMI.Common.Presentation"
                          
                           Width="700" Height="500" ResizeMode="NoResize" 
                          FontFamily="NSimSun"  TextOptions.TextFormattingMode="Display"
                           Header="{localize:Resx ResxName=HMI.Modules.Design.Resources.BrowserTexts, Key=XamlBrowserTitle}" 
                          
                           xmlns:xsv="clr-namespace:HMI.Modules.Design.Views.Browsers">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <xsv:XamlSourceView Grid.Row="0" DataContext="{Binding ActivePage}" />
        <my:GenericBrowserStatusBarView Grid.Row="1" />
        <my:OKCancelPanelView Grid.Row="2" />
    </Grid>
</my:SelectorBrowserWindow>