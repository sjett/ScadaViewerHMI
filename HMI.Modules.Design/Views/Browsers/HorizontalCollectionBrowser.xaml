<bw:BrowserWindowInstance x:Class="HMI.Modules.Design.Views.Browsers.HorizontalCollectionBrowser" 
                  Width="800" Height="600" 
                          FontFamily="NSimSun"  TextOptions.TextFormattingMode="Display"
                  Header="{localize:Resx ResxName=HMI.Modules.Design.Resources.BrowserTexts, Key=CollectionBrowserTitle}" 
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
                  xmlns:bw="clr-namespace:HMI.Common.Browsers.Views;assembly=HMI.Common.Browsers"
                          xmlns:localize="clr-namespace:HMI.Common.Presentation.Localization;assembly=HMI.Common.Presentation"
                  xmlns:local="clr-namespace:HMI.Modules.Design.Views.Browsers"
                  xmlns:hmi="clr-namespace:HMI.Infrastructure;assembly=HMI.Infrastructure"
                  >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ItemsControl Grid.Row="0" Margin="5,0,5,0" 
                      hmi:RegionManager.RegionName="{x:Static local:Regions.HorizontalCollectionBrowserView}" 
                      >
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
        <ItemsControl Grid.Row="1" Margin="5" 
                      hmi:RegionManager.RegionName="{x:Static local:Regions.OKCancelButtonPanel}" >
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
    </Grid>
</bw:BrowserWindowInstance>