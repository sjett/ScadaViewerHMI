<UserControl x:Class="HMI.Modules.Explorer.Views.ExplorerView" 
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rad="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:localize="clr-namespace:HMI.Common.Presentation.Localization;assembly=HMI.Common.Presentation"
             xmlns:eic="clr-namespace:HMI.Modules.Explorer.Converters" 
             xmlns:ess="clr-namespace:HMI.Modules.Explorer">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/HMI.Modules.Explorer;component/Views/ExplorerTreeViewItemTemplate.xaml" />
                <ResourceDictionary Source="/HMI.Modules.Explorer;component/Views/ExplorerContextMenu.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <eic:ExplorerImageConverter x:Key="ExplorerImageConverter" />
            <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFF" />
            <HierarchicalDataTemplate x:Key="ExplorerItemTemplate" ItemsSource="{Binding Children}">
                <TextBlock Text="{Binding}" />
            </HierarchicalDataTemplate>
            <Style x:Key="ExplorerTreeItemContainerStyle" TargetType="{x:Type rad:RadTreeViewItem}">
                <Setter Property="HeaderedItemsControl.Header" Value="{Binding ID, Mode=TwoWay}" />
                <Setter Property="rad:RadTreeViewItem.DefaultImageSrc" Value="{Binding Converter={StaticResource ExplorerImageConverter}}" />
                <Setter Property="Control.Template" Value="{StaticResource ExplorerTreeViewItemTemplate}" />
                <Setter Property="rad:RadTreeViewItem.IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                <Setter Property="rad:RadTreeViewItem.IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                <Setter Property="rad:EditableHeaderedItemsControl.IsEditable" Value="{Binding IsEditable}" />
                <Setter Property="FrameworkElement.MinHeight" Value="18" />
            </Style>
            <Style x:Key="OrphanNavigationItemStyle" BasedOn="{StaticResource ExplorerTreeItemContainerStyle}" TargetType="{x:Type rad:RadTreeViewItem}">
                <Setter Property="HeaderedItemsControl.Header" Value="{localize:Resx ResxName=HMI.Modules.Explorer.Resources.ExplorerTexts, Key=NoNavigationTarget}" />
                <Setter Property="rad:RadTreeViewItem.IsSelected" Value="False" />
                <Setter Property="UIElement.Focusable" Value="False" />
            </Style>
            <Style x:Key="ProjectTreeItemContainerStyle" BasedOn="{StaticResource ExplorerTreeItemContainerStyle}" TargetType="{x:Type rad:RadTreeViewItem}" />
            <Style x:Key="ControlTreeItemContainerStyle" BasedOn="{StaticResource ExplorerTreeItemContainerStyle}" TargetType="{x:Type rad:RadTreeViewItem}">
                <Setter Property="Control.Template" Value="{StaticResource ControlTreeViewItemTemplate}" />
            </Style>
            <ess:ExplorerStyleSelector x:Key="ExplorerItemStyleSelector" ControlStyle="{StaticResource ControlTreeItemContainerStyle}" NavigationItemStyle="{StaticResource ExplorerTreeItemContainerStyle}" OrphanNavigationItemStyle="{StaticResource OrphanNavigationItemStyle}" PageStyle="{StaticResource ExplorerTreeItemContainerStyle}" ProjectStyle="{StaticResource ProjectTreeItemContainerStyle}" TemplatePageStyle="{StaticResource ExplorerTreeItemContainerStyle}" />
        </ResourceDictionary>
    </UserControl.Resources>
    <rad:RadTreeView Name="uxExplorerTree" 
                     FrameworkElement.HorizontalAlignment="Stretch" 
                     FrameworkElement.VerticalAlignment="Stretch" 
                     Control.Background="{StaticResource WindowBackgroundBrush}" 
                     FrameworkElement.ContextMenu="{StaticResource ExplorerContextMenu}" 
                     FocusManager.IsFocusScope="True" 
                     IsDragDropEnabled="True" 
                     IsDragPreviewEnabled="False" 
                     IsEditable="True" 
                     IsExpandOnDblClickEnabled="False" 
                     IsRootLinesEnabled="True" 
                     ItemsControl.ItemContainerStyleSelector="{StaticResource ExplorerItemStyleSelector}" 
                     ItemsControl.ItemTemplate="{StaticResource ExplorerItemTemplate}" PathSeparator="/" 
                     SelectionMode="Multiple" 
                     rad:AnimationManager.IsAnimationEnabled="False" 
                     TextSearch.TextPath="ID" 
                     IsVirtualizing="True"
                    
                     ItemsControl.ItemsSource="{Binding ProjectManager.RootItems}" 
                     SelectedItem="{Binding ProjectManager.SelectedItem, Mode=TwoWay}" 
                     Selected="uxExplorerTree_Selected"
                     SelectionChanged="uxExplorerTree_SelectionChanged"/>
    <!--rad:TreeViewPanel.IsVirtualizing="True" 
rad:TreeViewPanel.VirtualizationMode="Hierarchical"-->
</UserControl>