                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="2" Grid.ColumnSpan="6" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="2" />
                <Border Name="MouseOverVisual" Grid.Column="2" Grid.ColumnSpan="6" BorderBrush="#FFFFC92B" BorderThickness="1" CornerRadius="1" Opacity="0">
