                        <rad:Office_BlackTheme />
                    </rad:StyleManager.Theme>
                </CheckBox>
                <RadioButton Name="RadioButtonElement" Grid.Column="2" Margin="5,0,0,0" VerticalAlignment="Center" IsTabStop="False" Visibility="Collapsed">
                    <rad:StyleManager.Theme>
                        <rad:Office_BlackTheme />
                    </rad:StyleManager.Theme>
                </RadioButton>
                <Image Name="Image" Grid.Column="3" MaxWidth="16" MaxHeight="16" Margin="2" HorizontalAlignment="Center" VerticalAlignment="Center" Tag="Wow" Visibility="Hidden" />
                <Viewbox Grid.Column="3" Width="16" Height="16" MaxWidth="16" MaxHeight="16" Margin="2" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Stretch="Uniform">
                    <ContentPresenter MinWidth="50" MinHeight="50" Content="{Binding Converter={StaticResource ControlBuilder}}" />
                </Viewbox>
                <Rectangle Name="FocusVisual" Grid.Column="2" Grid.ColumnSpan="6" IsHitTestVisible="False" RadiusX="3" RadiusY="3" Stroke="#FF000000" StrokeDashArray="1 2" StrokeThickness="1" Visibility="Collapsed" />
