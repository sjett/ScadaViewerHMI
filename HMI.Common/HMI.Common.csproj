<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.5" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="EventBus\**" />
    <Compile Remove="Instrumentation\ErrorHandling\**" />
    <EmbeddedResource Remove="EventBus\**" />
    <EmbeddedResource Remove="Instrumentation\ErrorHandling\**" />
    <None Remove="EventBus\**" />
    <None Remove="Instrumentation\ErrorHandling\**" />
    <Page Remove="EventBus\**" />
    <Page Remove="Instrumentation\ErrorHandling\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="ITraceContributor.cs" />
    <Compile Remove="Modularity\UnityContainerExtensions.cs" />
    <Compile Remove="TraceContributor.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Instrumentation\ErrorHandling\Contract.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Resources\Errors.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Errors.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\Errors.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Errors.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
