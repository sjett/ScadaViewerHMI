<rad:RadRibbonWindow x:Class="HMI.Editor.Shell"
                     Name="Window" Width="1000" Height="850" UseLayoutRounding="True" 
                     FontFamily="NSimSun" TextOptions.TextFormattingMode="Display"
                     
                     csb:CommandSinkBinding.CommandSink="{Binding CommandSink}" 
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
                     xmlns:rad="http://schemas.telerik.com/2008/xaml/presentation"
                     xmlns:gh="clr-namespace:HMI.Infrastructure;assembly=HMI.Infrastructure"
                     xmlns:csb="clr-namespace:HMI.Infrastructure.Commanding;assembly=HMI.Infrastructure" 
                     xmlns:kb="clr-namespace:System.Windows.Input;assembly=PresentationCore" 
                     xmlns:TabControl="clr-namespace:Telerik.Windows.Controls.TabControl;assembly=Telerik.Windows.Controls.Navigation"
                     xmlns:hmi="clr-namespace:HMI.Infrastructure;assembly=HMI.Infrastructure"
                     xmlns:locaize="clr-namespace:HMI.Common.Presentation.Localization;assembly=HMI.Common.Presentation"
                     xmlns:local="clr-namespace:HMI.Editor" WindowStartupLocation="CenterScreen" >
    <!--Title="{PriorityBinding {Binding FallbackValue=, Path=CommandSink.Project.ID, TargetNullValue=, StringFormat={locaize:Resx ResxName=HMI.Editor.Resources.RibbonBarTexts, Key=TitleAndProjectFormat}}}"-->
    <rad:RadRibbonWindow.Title>
        <PriorityBinding>
            <Binding Path="CommandSink.Project.ID" StringFormat="{locaize:Resx ResxName=HMI.Editor.Resources.RibbonBarTexts, Key=TitleAndProjectFormat}"></Binding>
        </PriorityBinding>
    </rad:RadRibbonWindow.Title>
    
    <rad:RadRibbonWindow.CommandBindings>
        <csb:CommandSinkBinding Command="{x:Static ApplicationCommands.New}" />
        <csb:CommandSinkBinding Command="{x:Static ApplicationCommands.Open}" />
        <csb:CommandSinkBinding Command="{x:Static ApplicationCommands.Save}" />
        <csb:CommandSinkBinding Command="{x:Static ApplicationCommands.SaveAs}" />
        <csb:CommandSinkBinding Command="{x:Static ApplicationCommands.Close}" />
        <csb:CommandSinkBinding Command="{x:Static ApplicationCommands.Copy}" />
        <csb:CommandSinkBinding Command="{x:Static ApplicationCommands.Paste}" />
        <csb:CommandSinkBinding Command="{x:Static ApplicationCommands.Delete}" />
        <csb:CommandSinkBinding Command="{x:Static ApplicationCommands.Cut}" />
        <csb:CommandSinkBinding Command="{x:Static ApplicationCommands.Undo}" />
        <csb:CommandSinkBinding Command="{x:Static ApplicationCommands.Redo}" />
        <csb:CommandSinkBinding Command="{x:Static ApplicationCommands.SelectAll}" />
        <csb:CommandSinkBinding Command="{x:Static gh:EditorCommands.AddNavigationPage}" />
        <csb:CommandSinkBinding Command="{x:Static gh:EditorCommands.AddTemplatePage}" />
        <csb:CommandSinkBinding Command="{x:Static gh:EditorCommands.RemovePage}" />
        <csb:CommandSinkBinding Command="{x:Static gh:EditorCommands.Rename}" />
        <csb:CommandSinkBinding Command="{x:Static gh:EditorCommands.OpenMruItem}" />
        <csb:CommandSinkBinding Command="{x:Static gh:EditorCommands.Build}" />
        <csb:CommandSinkBinding Command="{x:Static gh:EditorCommands.SelectLanguage}" />
        <csb:CommandSinkBinding Command="{x:Static gh:DesignerCanvasCommands.AlignLeft}" />
        <csb:CommandSinkBinding Command="{x:Static gh:DesignerCanvasCommands.AlignCenter}" />
        <csb:CommandSinkBinding Command="{x:Static gh:DesignerCanvasCommands.AlignRight}" />
        <csb:CommandSinkBinding Command="{x:Static gh:DesignerCanvasCommands.AlignTop}" />
        <csb:CommandSinkBinding Command="{x:Static gh:DesignerCanvasCommands.AlignMiddle}" />
        <csb:CommandSinkBinding Command="{x:Static gh:DesignerCanvasCommands.AlignBottom}" />
        <csb:CommandSinkBinding Command="{x:Static gh:DesignerCanvasCommands.DistributeHorizontal}" />
        <csb:CommandSinkBinding Command="{x:Static gh:DesignerCanvasCommands.DistributeVertical}" />
        <csb:CommandSinkBinding Command="{x:Static gh:DesignerCanvasCommands.BringForward}" />
        <csb:CommandSinkBinding Command="{x:Static gh:DesignerCanvasCommands.BringToFront}" />
        <csb:CommandSinkBinding Command="{x:Static gh:DesignerCanvasCommands.SendBackward}" />
        <csb:CommandSinkBinding Command="{x:Static gh:DesignerCanvasCommands.SendToBack}" />
        <csb:CommandSinkBinding Command="{x:Static gh:DesignerCanvasCommands.MakeSameWidth}" />
        <csb:CommandSinkBinding Command="{x:Static gh:DesignerCanvasCommands.MakeSameHeight}" />
        <csb:CommandSinkBinding Command="{x:Static gh:DesignerCanvasCommands.Group}" />
        <csb:CommandSinkBinding Command="{x:Static gh:DesignerCanvasCommands.Ungroup}" />
    </rad:RadRibbonWindow.CommandBindings>
    
    <rad:RadRibbonWindow.InputBindings>
        <kb:KeyBinding Key="F5" Command="{x:Static gh:EditorCommands.Build}" />
        <kb:KeyBinding Key="F2" Command="{x:Static gh:EditorCommands.Rename}" />
        <kb:MouseBinding Command="{x:Static gh:EditorCommands.Rename}" Gesture="LeftDoubleClick" />
    </rad:RadRibbonWindow.InputBindings>
    
    <rad:RadRibbonWindow.Resources>
        <DataTemplate x:Key="ProjectHeaderTemplate">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding}" />
                <!--<Image Width="16" Height="16" Source="Resources/Images/Tools.png" />-->
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="ToolboxHeaderTemplate">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding}" />
                <!--<Image Width="16" Height="16" Source="Resources/Images/Tools.png" />-->
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="ExplorerHeaderTemplate">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding}" />
                <!--<Image Width="16" Height="16" Source="Resources/Images/Explore.png" />-->
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="PropertyInspectorHeaderTemplate">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding}" />
                <!--<Image Width="16" Height="16" Source="Resources/Images/Properties.png" />-->
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="AcionEffectHeaderTemplate">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding}" />
                <!--<Image Width="16" Height="16" Source="Resources/Images/Properties.png" />-->
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="LogHeaderTemplate">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding}" />
                <!--<Image Width="16" Height="16" Source="Resources/Images/Task.png" />-->
            </StackPanel>
        </DataTemplate>
        <Style x:Key="DropDownMenuStyle" TargetType="{x:Type TabControl:DropDownMenu}">
            <Setter Property="TabControl:DropDownMenu.IconColumnWidth" Value="0" />
            <Setter Property="Control.BorderThickness" Value="1" />
            <Setter Property="Control.Background" Value="#FFFFFFFF" />
            <Setter Property="Control.BorderBrush" Value="#FF848484" />
            <Setter Property="Control.Foreground" Value="#FF000000" />
            <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
            <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabControl:DropDownMenu}">
                        <Grid>
                            <Grid Name="PopupContentElement">
                                <Border Background="#FFFFFFFF" BorderBrush="#FF848484" BorderThickness="{TemplateBinding Control.BorderThickness}">
                                    <Grid>
                                        <Grid HorizontalAlignment="Left" Width="{Binding IconColumnWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                            <Rectangle Margin="0,0,2,0" Fill="#FFF0F0F0" />
                                            <Grid Margin="0" HorizontalAlignment="Right">
                                                <Rectangle Width="1" Margin="0,0,1,0" HorizontalAlignment="Right" Fill="#FF848484" />
                                                <Rectangle Width="1" Margin="0" HorizontalAlignment="Right" Fill="#00FFFFFF" />
                                            </Grid>
                                        </Grid>
                                        <ScrollViewer ScrollViewer.VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter Margin="1" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </rad:RadRibbonWindow.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="23*"/>
            <ColumnDefinition Width="77*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        
        <local:RibbonBar x:Name="uxRibbonBar" Grid.ColumnSpan="2" Margin="0,0,0,692" Grid.RowSpan="3" />
        
        <rad:RadBusyIndicator Name="uxBusyIndicator" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,143,0,0">
            <rad:RadDocking Name="uxRadDocking" rad:AnimationManager.IsAnimationEnabled="False" SerializationTag="uxRadDocking">
                <rad:RadSplitContainer InitialPosition="DockedLeft" Orientation="Vertical">
                    <rad:RadPaneGroup>
                        <rad:RadPane Name="uxProjectPane" CanDockInDocumentHost="False" HeaderTemplate="{StaticResource ProjectHeaderTemplate}" rad:RadDocking.SerializationTag="ProjectPane" ContextMenuTemplate="{x:Null}" Header="{locaize:Resx ResxName=HMI.Editor.Resources.RibbonBarTexts, Key=ProjectTitle}">
                            <ItemsControl  hmi:RegionManager.RegionName="{x:Static local:RegionNames.ProjectTree}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Grid />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </rad:RadPane>
                        <rad:RadPane Name="uxExplorerPane" CanDockInDocumentHost="False" HeaderTemplate="{StaticResource ExplorerHeaderTemplate}" rad:RadDocking.SerializationTag="ExplorerPane" ContextMenuTemplate="{x:Null}" Header="{locaize:Resx ResxName=HMI.Editor.Resources.RibbonBarTexts, Key=ExplorerTitle}">
                            <ItemsControl  hmi:RegionManager.RegionName="{x:Static local:RegionNames.Explorer}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Grid />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </rad:RadPane>
                        <rad:RadPane Name="uxToolboxPane" CanDockInDocumentHost="False" HeaderTemplate="{StaticResource ToolboxHeaderTemplate}" rad:RadDocking.SerializationTag="ToolboxPane" ContextMenuTemplate="{x:Null}" Header="{locaize:Resx ResxName=HMI.Editor.Resources.RibbonBarTexts, Key=ToolboxTitle}">
                            <ItemsControl  hmi:RegionManager.RegionName="{x:Static local:RegionNames.ControlTree}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Grid />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </rad:RadPane>

                    </rad:RadPaneGroup>
                </rad:RadSplitContainer>
                <rad:RadSplitContainer InitialPosition="DockedRight" Orientation="Vertical">
                    <rad:RadPaneGroup>
                        <rad:RadPane Name="uxPropertyInspectorPane" CanDockInDocumentHost="False" HeaderTemplate="{StaticResource PropertyInspectorHeaderTemplate}" rad:RadDocking.SerializationTag="PropertyInspectorPane" ContextMenuTemplate="{x:Null}" Header="{locaize:Resx ResxName=HMI.Editor.Resources.RibbonBarTexts, Key=PropertyInspectorTitle}">
                            <ItemsControl hmi:RegionManager.RegionName="{x:Static local:RegionNames.MainPropertyEditor}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Grid />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </rad:RadPane>
                        <rad:RadPane Name="uxAcionEffectPane" CanDockInDocumentHost="False" HeaderTemplate="{StaticResource AcionEffectHeaderTemplate}" rad:RadDocking.SerializationTag="AcionEffectPane" ContextMenuTemplate="{x:Null}" Header="{locaize:Resx ResxName=HMI.Editor.Resources.RibbonBarTexts, Key=AcionEffectTitle}">
                            <ItemsControl  hmi:RegionManager.RegionName="{x:Static local:RegionNames.AcionEffectEditor}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Grid />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </rad:RadPane>
                    </rad:RadPaneGroup>
                </rad:RadSplitContainer>
                <rad:RadSplitContainer InitialPosition="DockedBottom" Orientation="Horizontal">
                    <rad:RadPaneGroup>
                        <rad:RadPane Name="uxLogPane" CanDockInDocumentHost="False" HeaderTemplate="{StaticResource LogHeaderTemplate}" rad:RadDocking.SerializationTag="LogPane" ContextMenuTemplate="{x:Null}" Header="{locaize:Resx ResxName=HMI.Editor.Resources.RibbonBarTexts, Key=LogTitle}">
                            <Grid>
                                <TextBox Name="uxLog" Margin="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" VerticalContentAlignment="Top" IsReadOnly="True" IsReadOnlyCaretVisible="True" MinLines="10" VerticalScrollBarVisibility="Auto" />
                            </Grid>
                        </rad:RadPane>
                    </rad:RadPaneGroup>
                </rad:RadSplitContainer>
                <rad:RadDocking.DocumentHost>
                    <rad:RadSplitContainer>
                        <rad:RadPaneGroup Name="uxDocumentPaneGroup" DropDownDisplayMode="Visible" DropDownStyle="{DynamicResource DropDownMenuStyle}" kb:FocusManager.IsFocusScope="True" OverflowMode="Scroll" ScrollMode="Item" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                    </rad:RadSplitContainer>
                </rad:RadDocking.DocumentHost>
            </rad:RadDocking>
        </rad:RadBusyIndicator>

        <rad:RadAIPromptButton HorizontalAlignment="Right"
                                               VerticalAlignment="Bottom"
                                               Grid.Row="2"
                                                Grid.ColumnSpan="2"
                                               Margin="0 0 40 20"
                                               IsPopupOpen="True">
            <rad:RadAIPromptButton.AIPrompt>
                <rad:RadAIPrompt OutputItems="{Binding AIPrompt.OutputItems}"
                                                 AreSuggestionsVisible="True" SuggestionsHeaderContent="快捷生成建议"
                                                 Suggestions="{Binding AIPrompt.Suggestions}"
                                                 Commands="{Binding AIPrompt.Commands}"
                                                 InputText="{Binding AIPrompt.InputText}"
                                                 PromptRequestCommand="{Binding AIPrompt.PromptRequestCommand}"
                                                 OutputItemRetryCommand="{Binding AIPrompt.OutputItemRetryCommand}">
                    <rad:RadAIPromptInputItem Header="询问 AI" />
                    <rad:RadAIPromptOutputItem Header="输出" />
                    <rad:RadAIPromptCommandsItem Header="命令"/>
                </rad:RadAIPrompt>
            </rad:RadAIPromptButton.AIPrompt>
        </rad:RadAIPromptButton>
        
    </Grid>
</rad:RadRibbonWindow>
 

 
