<UserControl x:Class="HMI.Editor.Views.ErrorNotification"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rad="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:localize="clr-namespace:HMI.Common.Presentation.Localization;assembly=HMI.Common.Presentation"
             >
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="NotificationButtonStyle" TargetType="{x:Type rad:RadButton}">
            <Setter Property="FrameworkElement.MinWidth" Value="100" />
            <Setter Property="FrameworkElement.Margin" Value="2,0,2,0" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="60" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Image Width="48" Height="48" MinWidth="48" MinHeight="48" Margin="0,10,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5" Stretch="None" Source="{Binding Image}" />
        <TextBlock Name="uxMessage" Grid.Column="1" Margin="5,10,5,5" TextWrapping="Wrap" Text="{Binding Message}" />
        <HeaderedContentControl Grid.Row="1" Grid.ColumnSpan="2" Margin="5" HorizontalAlignment="Stretch" Header="{localize:Resx Key=Details, ResxName=HMI.Editor.Resources.ErrorNotificationTexts}" Visibility="{Binding IsDetailsPanelVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBox Height="100" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalContentAlignment="Top" AcceptsReturn="True" HorizontalScrollBarVisibility="Auto" IsReadOnly="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" Text="{Binding Details}" />
                <rad:RadButton Name="uxCopyToClipboard" Grid.Row="1" Click="uxCopyToClipboard_Click">
                    <StackPanel Orientation="Horizontal">
                        <Image Width="16" Height="16" Source="/Resources/Images/copy.png" />
                        <TextBlock Margin="5,0,0,0" Text="{localize:Resx Key=CopyToClipboard, ResxName=HMI.Editor.Resources.ErrorNotificationTexts}" />
                    </StackPanel>
                </rad:RadButton>
            </Grid>
        </HeaderedContentControl>
        <Border Grid.Row="3" Grid.ColumnSpan="2" Margin="5,5,5,5" HorizontalAlignment="Stretch" BorderBrush="#FFD3D3D3" BorderThickness="0,1,0,0">
            <StackPanel Margin="0,3,0,3" HorizontalAlignment="Center" Orientation="Horizontal">
                <rad:RadButton Name="uxOK" FrameworkElement.Style="{StaticResource NotificationButtonStyle}" ContentControl.Content="{localize:Resx Key=OK, ResxName=HMI.Editor.Resources.ErrorNotificationTexts}" UIElement.Visibility="{Binding IsOKButtonVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Click="uxOK_Click" />
                <rad:RadButton Name="uxYes" FrameworkElement.Style="{StaticResource NotificationButtonStyle}" ContentControl.Content="{localize:Resx Key=Yes, ResxName=HMI.Editor.Resources.ErrorNotificationTexts}" UIElement.Visibility="{Binding IsYesButtonVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Click="uxYes_Click" />
                <rad:RadButton Name="uxNo" FrameworkElement.Style="{StaticResource NotificationButtonStyle}" ContentControl.Content="{localize:Resx Key=No, ResxName=HMI.Editor.Resources.ErrorNotificationTexts}" UIElement.Visibility="{Binding IsNoButtonVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Click="uxNo_Click" />
                <rad:RadButton Name="uxCancel" FrameworkElement.Style="{StaticResource NotificationButtonStyle}" ContentControl.Content="{localize:Resx Key=Cancel, ResxName=HMI.Editor.Resources.ErrorNotificationTexts}" UIElement.Visibility="{Binding IsCancelButtonVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Click="uxCancel_Click" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
