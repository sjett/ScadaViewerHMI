<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
                    xmlns:gh="clr-namespace:HMI.Infrastructure.Converters;assembly=HMI.Infrastructure.Converters"
                    xmlns:d="clr-namespace:System;assembly=mscorlib"
                    xmlns:Transformations="clr-namespace:HMI.Editor.Surface.Transformations">
    <gh:ScaleDoubleConverter x:Key="ScaleDoubleConverter" />
    <gh:ScaleThicknessConverter x:Key="ScaleThicknessConverter" />
    <gh:CursorAngleConverter x:Key="CursorAngleConverter" />
    <BooleanToVisibilityConverter x:Key="BooleanVisibilityConverter" />
    <Style x:Key="{x:Type Transformations:SelectionDecorator}" TargetType="{x:Type Transformations:SelectionDecorator}">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Transformations:SelectionDecorator}">
                    <Rectangle Width="{TemplateBinding FrameworkElement.ActualWidth}" Height="{TemplateBinding FrameworkElement.ActualHeight}" Stroke="#FF000000" StrokeThickness="{Binding InverseScale, Converter={StaticResource ScaleDoubleConverter}, ConverterParameter=1}">
                        <Rectangle.StrokeDashArray>
                            <d:Double>5.0</d:Double>
                        </Rectangle.StrokeDashArray>
                    </Rectangle>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SelectionPreviewStyle" TargetType="{x:Type Transformations:SelectionDecorator}">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Transformations:SelectionDecorator}">
                    <Grid Width="{TemplateBinding FrameworkElement.ActualWidth}" Height="{TemplateBinding FrameworkElement.ActualHeight}">
                        <Rectangle Stroke="#FF7DA2CE" RadiusX="{Binding InverseScale, Converter={StaticResource ScaleDoubleConverter}, ConverterParameter=2}" RadiusY="{Binding InverseScale, Converter={StaticResource ScaleDoubleConverter}, ConverterParameter=2}">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                    <GradientStop Offset="0" Color="#40DCEBFC" />
                                    <GradientStop Offset="1" Color="#40C1DBFC" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Rectangle Stroke="#FFEBF4FD" Fill="{x:Null}" RadiusX="{Binding InverseScale, Converter={StaticResource ScaleDoubleConverter}, ConverterParameter=2}" RadiusY="{Binding InverseScale, Converter={StaticResource ScaleDoubleConverter}, ConverterParameter=2}" Margin="{Binding Converter={StaticResource ScaleThicknessConverter}, ConverterParameter=1 1 1 1, Path=InverseScale}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>