<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:gh="clr-namespace:HMI.Infrastructure.Converters;assembly=HMI.Infrastructure.Converters"
                    xmlns:rh="clr-namespace:HMI.Editor.Surface.Transformations">
    
    <gh:ScaleDoubleConverter x:Key="ScaleDoubleConverter" />
    <gh:ScaleThicknessConverter x:Key="ScaleThicknessConverter" />
    <gh:CursorAngleConverter x:Key="CursorAngleConverter" />
    <BooleanToVisibilityConverter x:Key="BooleanVisibilityConverter" />
    
    <Style x:Key="{x:Type rh:ResizeHandle}" TargetType="{x:Type rh:ResizeHandle}">
        <Setter Property="Control.Background" Value="#FF008000" />
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type rh:ResizeHandle}">
                    <Canvas>
                        <Rectangle Fill="{TemplateBinding Control.Background}" Width="{Binding InverseScale, Converter={StaticResource ScaleDoubleConverter}, ConverterParameter=10}" Height="{Binding InverseScale, Converter={StaticResource ScaleDoubleConverter}, ConverterParameter=10}" Margin="{Binding Converter={StaticResource ScaleThicknessConverter}, ConverterParameter=-5 -5 0 0, Path=InverseScale}" />
                    </Canvas>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="{x:Type rh:ResizeDecorator}" TargetType="{x:Type rh:ResizeDecorator}">
        <Setter Property="Control.Background" Value="#FF000000" />
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type rh:ResizeDecorator}">
                    <Canvas>
                        <rh:ResizeHandle x:Name="uxResizeNV" Canvas.Left="0" Canvas.Top="0" Background="{TemplateBinding Control.Background}" HorizontalHandlePosition="Left" VerticalHandlePosition="Top" Cursor="{Binding Angle, Converter={StaticResource CursorAngleConverter}, ConverterParameter=SizeNV}" ResizeDecorator="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
                        <rh:ResizeHandle x:Name="uxResizeNE" Canvas.Top="0" Background="{TemplateBinding Control.Background}" HorizontalHandlePosition="Right" VerticalHandlePosition="Top" Canvas.Left="{Binding ControlWidth}" Cursor="{Binding Angle, Converter={StaticResource CursorAngleConverter}, ConverterParameter=SizeNE}" ResizeDecorator="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
                        <rh:ResizeHandle x:Name="uxResizeSE" Background="{TemplateBinding Control.Background}" HorizontalHandlePosition="Right" VerticalHandlePosition="Bottom" Canvas.Left="{Binding ControlWidth}" Canvas.Top="{Binding ControlHeight}" Cursor="{Binding Angle, Converter={StaticResource CursorAngleConverter}, ConverterParameter=SizeSE}" ResizeDecorator="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
                        <rh:ResizeHandle x:Name="uxResizeSV" Canvas.Left="0" Background="{TemplateBinding Control.Background}" HorizontalHandlePosition="Left" VerticalHandlePosition="Bottom" Canvas.Top="{Binding ControlHeight}" Cursor="{Binding Angle, Converter={StaticResource CursorAngleConverter}, ConverterParameter=SizeSV}" ResizeDecorator="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
                    </Canvas>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>