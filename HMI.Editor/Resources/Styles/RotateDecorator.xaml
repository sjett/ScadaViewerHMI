<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:gh="clr-namespace:HMI.Infrastructure.Converters;assembly=HMI.Infrastructure.Converters"
                    xmlns:rh="clr-namespace:HMI.Editor.Surface.Transformations">
    
    <gh:ScaleDoubleConverter x:Key="ScaleDoubleConverter" />
    <gh:ScaleThicknessConverter x:Key="ScaleThicknessConverter" />
    <gh:CursorAngleConverter x:Key="CursorAngleConverter" />
    <BooleanToVisibilityConverter x:Key="BooleanVisibilityConverter" />
    
    <Style x:Key="{x:Type rh:RotateHandle}" TargetType="{x:Type rh:RotateHandle}">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type rh:RotateHandle}">
                    <Ellipse Fill="#FF000000" Opacity="0.2" Width="{Binding InverseScale, Converter={StaticResource ScaleDoubleConverter}, ConverterParameter=30}" Height="{Binding InverseScale, Converter={StaticResource ScaleDoubleConverter}, ConverterParameter=30}" Margin="{Binding Converter={StaticResource ScaleThicknessConverter}, ConverterParameter=-15 -15 0 0, Path=InverseScale}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="{x:Type rh:RotateDecorator}" TargetType="{x:Type rh:RotateDecorator}">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type rh:RotateDecorator}">
                    <Canvas>
                        <rh:RotateHandle Canvas.Left="0" Canvas.Top="0" RotateDecorator="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
                        <rh:RotateHandle Canvas.Top="0" Canvas.Left="{Binding ControlWidth}" RotateDecorator="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
                        <rh:RotateHandle Canvas.Left="{Binding ControlWidth}" Canvas.Top="{Binding ControlHeight}" RotateDecorator="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
                        <rh:RotateHandle Canvas.Left="0" Canvas.Top="{Binding ControlHeight}" RotateDecorator="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
                    </Canvas>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>