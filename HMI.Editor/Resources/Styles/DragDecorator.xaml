<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:Transformations="clr-namespace:HMI.Editor.Surface.Transformations">
    <Style x:Key="{x:Type Transformations:DragDecorator}" TargetType="{x:Type Transformations:DragDecorator}">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Transformations:DragDecorator}">
                    <Border Background="#00FFFFFF" Opacity="0.5" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>