<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rad="http://schemas.telerik.com/2008/xaml/presentation"
                    xmlns:Common="clr-namespace:HMI.Editor.Common">
    <Style x:Key="{x:Type Common:ZoomSelector}" TargetType="{x:Type Common:ZoomSelector}">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Common:ZoomSelector}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <RepeatButton Name="uxDecreaseZoom" Content="-" Grid.Column="0" Width="20" />
                        <rad:RadSlider Name="uxZoomSlider" RangeBase.Minimum="0" RangeBase.Maximum="1" Grid.Column="1" RangeBase.SmallChange="0.01" RangeBase.LargeChange="0.05" RangeBase.Value="{Binding TickValue, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                        <RepeatButton Name="uxIncreaseZoom" Content="+" Grid.Column="2" Width="20" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>