<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:localize="clr-namespace:HMI.Common.Presentation.Localization;assembly=HMI.Common.Presentation"
                    xmlns:gh="clr-namespace:HMI.Infrastructure;assembly=HMI.Infrastructure">
    <ContextMenu x:Key="DesignerItemContextMenu">
        <MenuItem Command="{x:Static ApplicationCommands.Cut}" Header="{localize:Resx ResxName=HMI.Editor.Resources.EditingTexts, Key=Cut}">
            <MenuItem.Icon>
                <Image Width="16" Source="Images/Cut.png" />
            </MenuItem.Icon>
        </MenuItem>
        <MenuItem Command="{x:Static ApplicationCommands.Copy}" Header="{localize:Resx ResxName=HMI.Editor.Resources.EditingTexts, Key=Copy}">
            <MenuItem.Icon>
                <Image Width="16" Source="Images/Copy.png" />
            </MenuItem.Icon>
        </MenuItem>
        <MenuItem Command="{x:Static ApplicationCommands.Paste}" Header="{localize:Resx ResxName=HMI.Editor.Resources.EditingTexts, Key=Paste}">
            <MenuItem.Icon>
                <Image Width="16" Source="Images/Paste.png" />
            </MenuItem.Icon>
        </MenuItem>
        <MenuItem Command="{x:Static ApplicationCommands.Delete}" Header="{localize:Resx ResxName=HMI.Editor.Resources.EditingTexts, Key=Delete}">
            <MenuItem.Icon>
                <Image Width="16" Source="Images/Delete.png" />
            </MenuItem.Icon>
        </MenuItem>
        <Separator />
        <MenuItem Header="Order">
            <MenuItem Command="{x:Static gh:DesignerCanvasCommands.BringForward}" Header="{localize:Resx ResxName=HMI.Editor.Resources.EditingTexts, Key=BringForward}">
                <MenuItem.Icon>
                    <Image Width="16" Source="Images/BringForward.png" />
