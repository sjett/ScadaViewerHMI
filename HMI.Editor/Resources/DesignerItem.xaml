            </MenuItem.Icon>
        </MenuItem>
        <MenuItem Command="{x:Static ApplicationCommands.Paste}" Header="{localize:Resx ResxName=HMI.Editor.Resources.EditingTexts, Key=Paste}">
            <MenuItem.Icon>
                <Image Width="16" Source="Images/Paste.png" />
            </MenuItem.Icon>
        </MenuItem>
        <MenuItem Command="{x:Static ApplicationCommands.Delete}" Header="{localize:Resx ResxName=HMI.Editor.Resources.EditingTexts, Key=Delete}">
            <MenuItem.Icon>
                <Image Width="16" Source="Images/Delete.png" />
            </MenuItem.Icon>
        </MenuItem>
        <Separator />
        <MenuItem Header="Order">
            <MenuItem Command="{x:Static gh:DesignerCanvasCommands.BringForward}" Header="{localize:Resx ResxName=HMI.Editor.Resources.EditingTexts, Key=BringForward}">
