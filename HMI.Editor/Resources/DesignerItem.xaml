            </MenuItem>
            <MenuItem Command="{x:Static gh:DesignerCanvasCommands.SendBackward}" Header="{localize:Resx ResxName=HMI.Editor.Resources.EditingTexts, Key=SendBackward}">
                <MenuItem.Icon>
                    <Image Width="16" Source="Images/SendBackward.png" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Command="{x:Static gh:DesignerCanvasCommands.SendToBack}" Header="{localize:Resx ResxName=HMI.Editor.Resources.EditingTexts, Key=SendToBack}">
                <MenuItem.Icon>
                    <Image Width="16" Source="Images/SendToBack.png" />
                </MenuItem.Icon>
            </MenuItem>
        </MenuItem>
    </ContextMenu>
    <ContextMenu x:Key="PrimitiveDesignerItemContextMenu">
        <MenuItem Command="{x:Static ApplicationCommands.Cut}" Header="{localize:Resx ResxName=HMI.Editor.Resources.EditingTexts, Key=Cut}">
            <MenuItem.Icon>
                <Image Width="16" Source="Images/Cut.png" />
            </MenuItem.Icon>
        </MenuItem>
        <MenuItem Command="{x:Static ApplicationCommands.Copy}" Header="{localize:Resx ResxName=HMI.Editor.Resources.EditingTexts, Key=Copy}">
            <MenuItem.Icon>
