<rad:RadWindow x:Class="HMI.Editor.NewProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:rad="http://schemas.telerik.com/2008/xaml/presentation"
               xmlns:localize="clr-namespace:HMI.Common.Presentation.Localization;assembly=HMI.Common.Presentation"
               Width="400" Height="160" 
       FontFamily="NSimSun"  TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="CenterScreen" 
        Header="{localize:Resx ResxName=HMI.Editor.Resources.WindowTexts, Key=NewProject}" >
    
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock VerticalAlignment="Bottom" Text="{localize:Resx ResxName=HMI.Editor.Resources.WindowTexts, Key=Name}" />
        <TextBox Name="uxName" Grid.Column="1" Margin="7,0,0,0" Text="{localize:Resx ResxName=HMI.Editor.Resources.WindowTexts, Key=Project}" />
        <TextBlock Grid.Row="1" Margin="0,10,0,0" VerticalAlignment="Bottom" Text="{localize:Resx ResxName=HMI.Editor.Resources.WindowTexts, Key=Location}" />
        <Grid Grid.Row="1" Grid.Column="1" Margin="7,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Name="uxLocation" HorizontalAlignment="Stretch" />
            <Button Name="uxBrowseLocation" Grid.Column="1" Margin="3,0,0,0" HorizontalAlignment="Right" Content="{localize:Resx ResxName=HMI.Editor.Resources.WindowTexts, Key=Browse}" />
        </Grid>
        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Name="uxOKButtonElement" Width="80" Margin="10,0,0,0" IsDefault="True" IsEnabled="False" Content="{localize:Resx ResxName=HMI.Editor.Resources.WindowTexts, Key=OK}" />
            <Button Name="uxCancelButtonElement" Width="80" Margin="10,0,0,0" Content="{localize:Resx ResxName=HMI.Editor.Resources.WindowTexts, Key=Cancel}" />
        </StackPanel>
    </Grid>
</rad:RadWindow>
