<?xml version="1.0" encoding="utf-8"?>
<xs:schema
    xmlns:i="http://www.w3.org/2001/XMLSchema-instance"
    attributeFormDefault="unqualified"
    elementFormDefault="qualified"
    targetNamespace="http://schemas.datacontract.org/2004/07/HMI.Modules.ControlTree"
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:c="http://schemas.datacontract.org/2004/07/HMI.Modules.ControlTree"
    >
    <xs:element name="ControlCategory">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="Name" type="xs:string" minOccurs="0" maxOccurs="1" />
                <xs:element name="Children" minOccurs="0" maxOccurs="1">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element ref="c:ControlCategory" minOccurs="0" maxOccurs="unbounded" />
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
</xs:schema>