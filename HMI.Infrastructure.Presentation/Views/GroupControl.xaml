<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:Views="clr-namespace:HMI.Infrastructure.Presentation.Views">
    <Style x:Key="{x:Type Views:GroupControl}" TargetType="{x:Type Views:GroupControl}">
        <Setter Property="Views:CommonControl.DesignerTemplateKey" Value="GroupControlDesigner" />
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Views:GroupControl}">
                    <Image HorizontalAlignment="Center" VerticalAlignment="Center" Source="Icons/group.png" Stretch="None" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="GroupControlDesigner" TargetType="{x:Type Views:GroupControl}">
        <Setter Property="Control.Background" Value="#FF0000FF" />
        <Setter Property="Control.BorderBrush" Value="#FF00008B" />
        <Setter Property="UIElement.Opacity" Value="0.1" />
        <Setter Property="Control.BorderThickness" Value="1" />
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Views:GroupControl}">
                    <Grid Name="LayoutRoot" IsHitTestVisible="False">
                        <Border Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>