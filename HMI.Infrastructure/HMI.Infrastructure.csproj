    </EmbeddedResource>
    <EmbeddedResource Update="Resources\StandardPropertyCategories.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>StandardPropertyCategories.Designer.cs</LastGenOutput>
    </EmbeddedResource>
