      <AutoGen>True</AutoGen>
      <DependentUpon>StandardPropertyCategories.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Resources\CommandingErrorTexts.resx">
