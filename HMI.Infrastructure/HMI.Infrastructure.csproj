<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="NLog" Version="6.0.7" />
    <PackageReference Include="System.Runtime.Caching" Version="10.0.1" />
    <PackageReference Include="Telerik.UI.for.Wpf.80.Xaml" Version="2025.2.521" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\HMI.Domain\HMI.Domain.csproj" />
