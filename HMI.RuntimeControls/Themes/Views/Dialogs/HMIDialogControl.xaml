                                            <SplineDoubleKeyFrame KeyTime="00:00:00.15" Value="0"/>
                                            <SplineDoubleKeyFrame KeyTime="00:00:00.3" Value="1"/>
                                            <SplineDoubleKeyFrame KeySpline="0,0,0.5,1" KeyTime="00:00:00.35" Value="1.05"/>
                                            <SplineDoubleKeyFrame KeyTime="00:00:00.45" Value="1"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Closed">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames BeginTime="0" Storyboard.TargetName="Overlay" Storyboard.TargetProperty="Opacity">
                                            <EasingDoubleKeyFrame KeyTime="0" Value="1"/>
                                            <EasingDoubleKeyFrame KeyTime="00:00:00.2" Value="0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames BeginTime="0" Storyboard.TargetName="ContentRoot" Storyboard.TargetProperty="(RenderTransform).(Children)[0].ScaleX">
                                            <SplineDoubleKeyFrame KeyTime="00:00:00.1" Value="1"/>
                                            <SplineDoubleKeyFrame KeyTime="00:00:00.15" Value="1.05"/>
                                            <SplineDoubleKeyFrame KeyTime="00:00:00.35" Value="0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames BeginTime="0" Storyboard.TargetName="ContentRoot" Storyboard.TargetProperty="(RenderTransform).(Children)[0].ScaleY">
                                            <SplineDoubleKeyFrame KeyTime="00:00:00.1" Value="1"/>
                                            <SplineDoubleKeyFrame KeyTime="00:00:00.15" Value="1.05"/>
                                            <SplineDoubleKeyFrame KeyTime="00:00:00.35" Value="0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid x:Name="Overlay" HorizontalAlignment="Stretch" Margin="0" VerticalAlignment="Top" Opacity="{TemplateBinding OverlayOpacity}" Background="{TemplateBinding OverlayBrush}"/>
                        <Grid x:Name="ContentRoot" Height="{TemplateBinding Height}" HorizontalAlignment="{TemplateBinding HorizontalAlignment}" VerticalAlignment="{TemplateBinding VerticalAlignment}" Width="{TemplateBinding Width}" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform/>
                                    <SkewTransform/>
                                    <RotateTransform/>
                                    <TranslateTransform/>
                                </TransformGroup>
                            </Grid.RenderTransform>
                            <Border HorizontalAlignment="Stretch" Margin="-1" VerticalAlignment="Stretch" Background="#14000000" BorderBrush="#14000000" BorderThickness="1" CornerRadius="2"/>
                            <Border HorizontalAlignment="Stretch" Margin="-2" VerticalAlignment="Stretch" Background="#0F000000" BorderBrush="#0F000000" BorderThickness="1" CornerRadius="2.25"/>
                            <Border HorizontalAlignment="Stretch" Margin="-3" VerticalAlignment="Stretch" Background="#0C000000" BorderBrush="#0C000000" BorderThickness="1" CornerRadius="2.5"/>
                            <Border HorizontalAlignment="Stretch" Margin="-4" VerticalAlignment="Stretch" Background="#0A000000" BorderBrush="#0A000000" BorderThickness="1" CornerRadius="2.75"/>
                            <Border Background="#FFFFFFFF" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2">
                                <Border Margin="1" CornerRadius="1.5" Background="{TemplateBinding Background}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Border 
                                            x:Name="Chrome" 
                                            Width="Auto" 
                                            BorderBrush="#FFFFFFFF" 
                                            BorderThickness="0,0,0,1"
                                            Background="{TemplateBinding TitleBackground}">
                                            <Grid Height="Auto" Width="Auto">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="30"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentControl FontWeight="Bold" IsTabStop="False" HorizontalAlignment="Stretch" Margin="6,1,6,1" VerticalAlignment="Center" Content="{TemplateBinding Caption}" Foreground="{TemplateBinding TitleForeground}"/>
                                                <Button x:Name="CloseButton" IsTabStop="False" Height="14" HorizontalAlignment="Center" Style="{StaticResource ButtonStyle}" VerticalAlignment="Center" Width="15" Grid.Column="1"/>
                                            </Grid>
                                        </Border>
                                        <Border Margin="7" Background="{TemplateBinding Background}" Grid.Row="1">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                                                <Image x:Name="uxIcon" Width="32" Height="32" Margin="0,0,5,0" VerticalAlignment="Center" Stretch="Fill"/>
                                                <ContentPresenter x:Name="ContentPresenter" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
                                            </StackPanel>
                                        </Border>
                                        <StackPanel Margin="7" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button 
                                                x:Name="uxOK" 
                                                Visibility="Collapsed"
                                                Width="{TemplateBinding ButtonsWidth}"
                                                Content="{TemplateBinding OKText}" 
                                                Style="{TemplateBinding ButtonsStyle}" />
                                            <Button 
                                                x:Name="uxYes" 
                                                Visibility="Collapsed"
                                                Width="{TemplateBinding ButtonsWidth}"
                                                Content="{TemplateBinding YesText}" 
                                                Style="{TemplateBinding ButtonsStyle}" />
                                            <Button 
                                                x:Name="uxNo" 
                                                Visibility="Collapsed"
                                                Margin="5,0,0,0" 
                                                Width="{TemplateBinding ButtonsWidth}"
                                                Content="{TemplateBinding NoText}" 
                                                Style="{TemplateBinding ButtonsStyle}" />
                                            <Button 
                                                x:Name="uxCancel" 
                                                Visibility="Collapsed"
                                                Margin="5,0,0,0" 
                                                Width="{TemplateBinding ButtonsWidth}"
                                                Content="{TemplateBinding CancelText}" 
                                                Style="{TemplateBinding ButtonsStyle}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Border>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

