<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:Converters="clr-namespace:HMI.Runtime.Shared.Common.Converters;assembly=HMI.Runtime.Shared"
                    xmlns:local="clr-namespace:HMI.RuntimeControls.Labels">

    <Converters:TextAlignmentsToSystemTextAlignmentConverter x:Key="TextAlignmentsToSystemTextAlignmentConverter" />

    <Style TargetType="local:HMILabel1">

        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:HMILabel1">
                    <Grid x:Name="LayoutRoot" Background="{TemplateBinding Background}">
                        <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <TextBlock x:Name="OutputElement"
                                       HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontStretch="{TemplateBinding FontStretch}"
                                       FontStyle="{TemplateBinding FontStyle}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       Foreground="{TemplateBinding Foreground}"
                                       Text="HMILabel1"
                                       TextAlignment="{Binding TextAlignment,
                                                               Converter={StaticResource TextAlignmentsToSystemTextAlignmentConverter},
                                                               RelativeSource={RelativeSource TemplatedParent}}"
                                       TextWrapping="Wrap" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

    </Style>

</ResourceDictionary>
