<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:HMI.RuntimeControls.Isa">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="HMIISABase.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <Style x:Key="{x:Type local:HMIISAFlap4}"
           TargetType="{x:Type local:HMIISAFlap4}"
           BasedOn="{StaticResource HMIISAStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HMIISAFlap4}">
                    <Grid Background="{TemplateBinding Background}">
                        <Path x:Name="uxLine"
                              Data="M9,26L9,-0.013350627"
                              StrokeStartLineCap="Round"
                              Stretch="Fill"
                              StrokeEndLineCap="Round"
                              Stroke="{TemplateBinding Foreground}"
                              StrokeLineJoin="Round"
                              UseLayoutRounding="False"
                              RenderTransformOrigin="0.5,0.5"
                              StrokeThickness="{TemplateBinding LineThickness}">
                            <Path.RenderTransform>
                                <RotateTransform Angle="{Binding ActualRotationAngle, RelativeSource={RelativeSource TemplatedParent}}" />
                            </Path.RenderTransform>
                        </Path>
                        <Viewbox>
                            <Grid Height="6" Width="6" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform ScaleX="0.5" ScaleY="0.5" />
                                </Grid.RenderTransform>
                                <Ellipse Fill="{TemplateBinding Foreground}"
                                         StrokeThickness="0"
                                         Height="6"
                                         Width="6"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center" />
                            </Grid>
                        </Viewbox>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
