<ResourceDictionary xmlns:local="clr-namespace:HMI.RuntimeControls.Isa" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="HMIISABase.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <Style x:Key="{x:Type local:HMIISAFunnel1}" TargetType="{x:Type local:HMIISAFunnel1}" BasedOn="{StaticResource HMIISAStyle}">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HMIISAFunnel1}">
                    <Grid Name="LayoutRoot" Margin="0,0,0,0">
                        <Viewbox>
                            <Path Name="Path" Canvas.Left="29.5" Canvas.Top="9.5" Stretch="Fill" StrokeLineJoin="Round" Stroke="{TemplateBinding Control.Foreground}" Data="M0.5,0.5L20.5,30.5 40.5,0.5 M20.5,30.5L20.5,80.5" UseLayoutRounding="False" VerticalAlignment="Top" StrokeThickness="{TemplateBinding LineThickness}" />
                        </Viewbox>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>