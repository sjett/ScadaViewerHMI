<ResourceDictionary xmlns:local="clr-namespace:HMI.RuntimeControls.Pipes" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="{x:Type local:HMICornerLine1}" TargetType="{x:Type local:HMICornerLine1}">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HMICornerLine1}">
                    <Grid Name="LayoutRoot" IsHitTestVisible="False" Height="Auto" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Width="Auto" Background="{x:Null}">
                        <Path Name="path" Height="10" Margin="0,0,0,0" VerticalAlignment="Top" Fill="#FFB1B1B1" Stretch="Fill" StrokeThickness="0" Data="M0,0L100,0 100,10 0,10z" Stroke="{x:Null}" />
                        <Path Name="path1" HorizontalAlignment="Right" Margin="0,0,0,0" Width="10" Fill="#FFB1B1B1" Stretch="Fill" StrokeThickness="0" Data="M0,0L10,0 10,100 0,100z" Stroke="{x:Null}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>