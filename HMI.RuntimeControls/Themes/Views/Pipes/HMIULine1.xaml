<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:HMI.RuntimeControls.Pipes">
    <Style x:Key="{x:Type local:HMIULine1}" TargetType="{x:Type local:HMIULine1}">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HMIULine1}">
                    <Grid Name="LayoutRoot" IsHitTestVisible="False" Height="Auto" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Width="Auto" Background="{x:Null}">
                        <Rectangle Name="rectangle1" Height="10" VerticalAlignment="Bottom" Fill="#FFB1B1B1" StrokeThickness="0" Stroke="{x:Null}" />
                        <Rectangle Name="rectangle" Margin="0,0,0,0" Width="10" Fill="#FFB1B1B1" StrokeThickness="0" HorizontalAlignment="Left" Stroke="{x:Null}" />
                        <Rectangle Name="rectangle2" HorizontalAlignment="Right" Width="10" Fill="#FFB1B1B1" StrokeThickness="0" VerticalAlignment="Stretch" Stroke="{x:Null}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>