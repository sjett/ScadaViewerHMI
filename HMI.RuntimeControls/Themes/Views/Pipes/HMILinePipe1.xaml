<ResourceDictionary xmlns:local="clr-namespace:HMI.RuntimeControls.Pipes" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="{x:Type local:HMILinePipe1}" TargetType="{x:Type local:HMILinePipe1}">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HMILinePipe1}">
                    <Grid Name="LayoutRoot" IsHitTestVisible="False" Background="{x:Null}">
                        <Rectangle Name="rectangle" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" StrokeThickness="6" Height="{TemplateBinding LineThickness}" Stroke="{x:Null}">
                            <Rectangle.Fill>
                                <LinearGradientBrush EndPoint="0.5,0.100000001490116" StartPoint="0.5,0.899999976158142">
                                    <GradientStop Color="#FF4F4F4F" Offset="0.05000000074505806" />
                                    <GradientStop Color="#FF727272" />
                                    <GradientStop Color="#FF4F4F4F" Offset="0.949999988079071" />
                                    <GradientStop Color="#FFFFFFFF" Offset="0.5" />
                                    <GradientStop Color="#FF727272" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>