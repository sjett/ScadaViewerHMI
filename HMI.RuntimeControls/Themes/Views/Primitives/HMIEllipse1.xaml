<ResourceDictionary xmlns:local="clr-namespace:HMI.RuntimeControls.Primitives" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
    </ResourceDictionary.MergedDictionaries>
    
    <Style x:Key="{x:Type local:HMIEllipse1}" TargetType="{x:Type local:HMIEllipse1}">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HMIEllipse1}">
                    <Grid Name="LayoutRoot" IsHitTestVisible="False">
                        <Ellipse Name="EllipseElement" Fill="{TemplateBinding Control.Background}" Stroke="{TemplateBinding Control.Foreground}" StrokeThickness="{TemplateBinding LineThickness}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>