<ResourceDictionary xmlns:local="clr-namespace:HMI.RuntimeControls.Primitives" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
    </ResourceDictionary.MergedDictionaries>
    <Style x:Key="{x:Type local:HMITrapeze1}" TargetType="{x:Type local:HMITrapeze1}">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HMITrapeze1}">
                    <Grid Name="LayoutRoot" IsHitTestVisible="False">
                        <Path Name="PathElement" Data="M1,0L2,0 3,2 0,2z" Fill="{TemplateBinding Control.Background}" Stretch="Fill" Stroke="{TemplateBinding Control.Foreground}" StrokeThickness="{TemplateBinding LineThickness}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>