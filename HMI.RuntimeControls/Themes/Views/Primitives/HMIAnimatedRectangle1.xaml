<ResourceDictionary xmlns:local="clr-namespace:HMI.RuntimeControls.Primitives" 
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/HMI.RuntimeControls;component/Themes/Views/Primitives/HMIAnimatedPrimitiveResources.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <Style x:Key="{x:Type local:HMIAnimatedRectangle1}" TargetType="{x:Type local:HMIAnimatedRectangle1}">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HMIAnimatedRectangle1}">
                    <Grid Name="LayoutRoot">
                        <Border Name="PrimitiveElement" BorderBrush="{TemplateBinding Control.Foreground}" Background="{TemplateBinding Control.Background}" BorderThickness="{TemplateBinding LineThickness}" CornerRadius="{TemplateBinding CornerRadius}" />
                        <Border Name="uxFill" CornerRadius="{TemplateBinding CornerRadius}" BorderThickness="{TemplateBinding LineThickness}" BorderBrush="{x:Null}" Background="{TemplateBinding AnimatedFill}">
                            <Border.OpacityMask>
                                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                    <GradientStop Color="#00000000" />
                                    <GradientStop Color="#00000000" Offset="{Binding FillLevel, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource FillLevelToMaskOffsetConverter}}" />
                                    <GradientStop Color="#FF000000" Offset="{Binding FillLevel, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource FillLevelToMaskOffsetConverter}}" />
                                    <GradientStop Color="#FF000000" Offset="1" />
                                </LinearGradientBrush>
                            </Border.OpacityMask>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>