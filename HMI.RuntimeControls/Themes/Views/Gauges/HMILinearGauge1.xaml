<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:HMI.RuntimeControls.Gauges"
    xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation">

    <Style TargetType="local:HMILinearGauge1">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:HMILinearGauge1">
                    <Grid x:Name="LayoutRoot">

                            
                            <telerik:RadVerticalLinearGauge x:Name="LinearGaugeElement">
                                <telerik:LinearScale 
                                    Max="{TemplateBinding Maximum}" 
                                    Min="{TemplateBinding Minimum}" 
                                    StrokeThickness="1" 
                                    telerik:ScaleObject.RelativeY="0.5"
                                    MajorTickLocation="OverCenter"
                                    MiddleTickLocation="OverCenter" MiddleTickRelativeWidth="0.07"
                                    MinorTickLocation="OverCenter" MinorTickRelativeWidth="0.055"
                                    >
                                    <!--<telerik:LinearScale.MajorTick>
                                        <telerik:MajorTickProperties Location="OverCenter"/>
                                    </telerik:LinearScale.MajorTick>
                                    <telerik:LinearScale.MiddleTick>
                                        <telerik:MiddleTickProperties Location="OverCenter" Length="0.07"/>
                                    </telerik:LinearScale.MiddleTick>
                                    <telerik:LinearScale.MinorTick>
                                        <telerik:MinorTickProperties Location="OverCenter" Length="0.055"/>
                                    </telerik:LinearScale.MinorTick>-->

                                    <!--<telerik:LinearScale.Label>
                                        <telerik:LabelProperties FontSize="9" Offset="0" Location="Outside"/>
                                    </telerik:LinearScale.Label>-->

                                    <telerik:LinearScale.Indicators>
                                        <telerik:Marker x:Name="MarkerElement" 
                                                        telerik:ScaleObject.RelativeHeight="0.04"
                                                        telerik:ScaleObject.RelativeWidth="0.08"
                                                        IsAnimated="True"/>
                                    </telerik:LinearScale.Indicators>
                                </telerik:LinearScale>

                            </telerik:RadVerticalLinearGauge>
                        
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
