<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HMI.RuntimeControls.Gauges">
    <Style TargetType="local:HMIGauge6">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:HMIGauge6">
                    <Viewbox x:Name="ContainerView">
                		<Viewbox.Resources>
                			<Storyboard x:Name="BackgroundFillAnimation">
                				<DoubleAnimationUsingKeyFrames
                					Storyboard.TargetProperty="(Shape.Fill).(GradientBrush.GradientStops)[1].(GradientStop.Offset)"
                					Storyboard.TargetName="ShapeFill">
                					    <EasingDoubleKeyFrame KeyTime="0" Value="0.49" />
                					    <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="0.448" />
                				</DoubleAnimationUsingKeyFrames>
                				<DoubleAnimationUsingKeyFrames
                					Storyboard.TargetProperty="(Shape.Fill).(GradientBrush.GradientStops)[2].(GradientStop.Offset)"
                					Storyboard.TargetName="ShapeFill">
                					<EasingDoubleKeyFrame KeyTime="0" Value="0.506" />
                					<EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="0.465" />
                				</DoubleAnimationUsingKeyFrames>
                				<DoubleAnimationUsingKeyFrames
                					Storyboard.TargetProperty="(Shape.Fill).(GradientBrush.GradientStops)[0].(GradientStop.Offset)"
                					Storyboard.TargetName="ShapeFill">
                					<EasingDoubleKeyFrame KeyTime="0" Value="0" />
                					<EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="0" />
                				</DoubleAnimationUsingKeyFrames>
                				<DoubleAnimationUsingKeyFrames
                					Storyboard.TargetProperty="(Shape.Fill).(GradientBrush.GradientStops)[3].(GradientStop.Offset)"
                					Storyboard.TargetName="ShapeFill">
                					<EasingDoubleKeyFrame KeyTime="0" Value="1" />
                					<EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="1" />
                				</DoubleAnimationUsingKeyFrames>
                			</Storyboard>
                		</Viewbox.Resources>
                		<Border BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}" OpacityMask="{Binding OpacityMask, RelativeSource={RelativeSource TemplatedParent}}"
                                    >
                			<Grid Margin="10" Height="209" Width="637">
                				<Grid.ColumnDefinitions>
                					<ColumnDefinition />
                				</Grid.ColumnDefinitions>
                				<Grid.RowDefinitions>
                					<RowDefinition Height="0.383*" />
                					<RowDefinition Height="0*" />
                					<RowDefinition Height="0.163*" />
                					<RowDefinition Height="0.11*" />
                					<RowDefinition Height="0.344*"/>
                				</Grid.RowDefinitions>
                				<Viewbox Margin="5" Grid.RowSpan="4">
                					<Grid Height="133.5" Width="640">
                						<Grid x:Name="GridAreas" Margin="0,0,0,54" Width="640">
                							<StackPanel x:Name="AreasStack" Orientation="Horizontal" Margin="0">
                								<Rectangle x:Name="seg4" Fill="#FFCE0900" RadiusY="10"
                									RadiusX="10" StrokeThickness="0" Height="80"
                									VerticalAlignment="Center" Margin="-10,0,0,0"
                									Width="214" Visibility="Collapsed" />
                								<Rectangle x:Name="space1" RadiusY="10"
                									RadiusX="10" StrokeThickness="0"
                									VerticalAlignment="Center" Margin="0"
                									Width="10" Visibility="Collapsed" />
                								<Rectangle x:Name="seg5" Fill="#FFD6BA00" RadiusY="10"
                									RadiusX="10" StrokeThickness="0.5" Width="195" Visibility="Collapsed" />
                								<Rectangle x:Name="space2" RadiusY="10"
                									RadiusX="10" StrokeThickness="0"
                									VerticalAlignment="Center" Margin="0"
                									Width="10" Visibility="Collapsed" />
                								<Rectangle x:Name="seg6" Fill="#FF6CCA00" RadiusY="10"
                									RadiusX="10" StrokeThickness="0.5" Height="80"
                									Width="210"
                									VerticalAlignment="Center" Visibility="Collapsed" />
                							</StackPanel>
                						</Grid>
                						<Grid x:Name="GridFill" Margin="0,5,3,59">
                							<Rectangle x:Name="ShapeFill" Height="35" RadiusY="5"
                								RadiusX="5" VerticalAlignment="Center"
                								Width="620" Margin="10,0,7,0">
                								<Rectangle.Stroke>
                									<LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                										<GradientStop Color="#BFA1A1A1" Offset="0.483" />
                										<GradientStop Color="#BFFFFFFF" Offset="1" />
                										<GradientStop Color="#BFE4E4E4" />
                									</LinearGradientBrush>
                								</Rectangle.Stroke>
                								<Rectangle.Fill>
                									<LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                										<LinearGradientBrush.RelativeTransform>
                                                            <RotateTransform Angle="90" CenterX="0.5" CenterY="0.5"/>
                                                        </LinearGradientBrush.RelativeTransform>
                										<GradientStop
                											Color="{Binding Background, ElementName=LayoutRoot, Mode=TwoWay}" />
                										<GradientStop
                											Color="{Binding Background, ElementName=LayoutRoot, Mode=TwoWay}"
                											Offset="0.49" />
                										<GradientStop
                											Color="{Binding FillColor, RelativeSource={RelativeSource TemplatedParent}}"
                											Offset="0.496" />
                										<GradientStop
                											Color="{Binding FillColor, RelativeSource={RelativeSource TemplatedParent}}"
                											Offset="1" />
                									</LinearGradientBrush>
                								</Rectangle.Fill>
                							</Rectangle>
                							<Rectangle x:Name="bar_glossy_gradient1" Height="35" RadiusY="5"
                								RadiusX="5" VerticalAlignment="Center" Margin="10,0,7,0">
                								<Rectangle.Stroke>
                									<LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                										<GradientStop Color="#71FFFFFF" Offset="0.483" />
                										<GradientStop Color="#7FFFFFFF" Offset="1" />
                										<GradientStop Color="#BDE4E4E4" />
                									</LinearGradientBrush>
                								</Rectangle.Stroke>
                								<Rectangle.Fill>
                									<LinearGradientBrush EndPoint="0.424,0.995"
                										StartPoint="0.424,0.002">
                										<LinearGradientBrush.RelativeTransform>
                                                            <TransformGroup>
                                                                <ScaleTransform CenterY="0.499" CenterX="0.424" ScaleX="1.006" />
                                                                <TranslateTransform X="0.075"/>
                                                            </TransformGroup>
                										</LinearGradientBrush.RelativeTransform>
                										<GradientStop Color="#64FFFFFF" Offset="0.5" />
                										<GradientStop Color="Transparent" Offset="0.5" />
                									</LinearGradientBrush>
                								</Rectangle.Fill>
                							</Rectangle>
                							<Path x:Name="glossy_gradient1"
                								Data="M-0.11914753,8.9997101 C-0.11914753,3.4768624 3.0329719,-0.00033337038 8.5558195,-0.00033337038 L616.2345,0.041666668 C624.15027,0.041333511 624.1507,8.9997101 624.1507,8.9997101 C624.1507,8.9997101 369.24686,17.8071 253.99979,30 C174.04706,38.458832 10.83223,69.937508 10.83223,69.937508 C5.3093815,69.937508 -0.057622947,64.522804 -0.057622947,58.99995 z"
                								Stretch="Fill" Stroke="#80F5F5F5"
                								StrokeThickness="0.5" UseLayoutRounding="False"
                								Opacity="0.645" Margin="2.6,2.5,2.5,0">
                								<Path.Fill>
                									<LinearGradientBrush EndPoint="0.515,1.269"
                										StartPoint="0.5,-0.036">
                										<LinearGradientBrush.RelativeTransform>
                                                            <TransformGroup>
                                                                <ScaleTransform CenterY="0.617" CenterX="0.507" ScaleX="0.866" />
                                                                <TranslateTransform X="0.058"/>
                                                            </TransformGroup>
                										</LinearGradientBrush.RelativeTransform>
                										<GradientStop Color="#74EFEFEF" Offset="0" />
                										<GradientStop Color="#39FFFFFF" Offset="0.507" />
                										<GradientStop Color="#58F5F5F5" Offset="0.5" />
                										<GradientStop Color="#58F4F4F4" Offset="0.276" />
                									</LinearGradientBrush>
                								</Path.Fill>
                							</Path>
                						</Grid>
                						<Grid x:Name="ScaleGrid" Width="620" Margin="9,0,11,20" Height="30" VerticalAlignment="Bottom"/>
                						<Grid x:Name="GridLabelsScale" Margin="-600,0,0,-110" Grid.Row="3"
                							VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center">
                							<Grid.RenderTransform>
                                                <TranslateTransform X="-9"/>
                                            </Grid.RenderTransform>
                						</Grid>
                					</Grid>
                				</Viewbox>
                				<Grid x:Name="GridValues" Grid.Row="4" Height="46">
                					<Grid.ColumnDefinitions>
                						<ColumnDefinition Width="0.512*"/>
                						<ColumnDefinition Width="0.5*"/>
                					</Grid.ColumnDefinitions>
                					<TextBlock x:Name="UnitLabel" Text="{TemplateBinding Unit}"
                						FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}"
                						Foreground="#FFA7A7A7" RenderTransformOrigin="0.5,0.5"
                						TextWrapping="Wrap"
                						VerticalAlignment="Center" HorizontalAlignment="Left" Grid.Column="1" Margin="10,0,0,0" FontWeight="{TemplateBinding FontWeight}" FontStyle="{TemplateBinding FontStyle}" />
                					<TextBlock x:Name="LevelValue" Text="00,00" FontFamily="{TemplateBinding FontFamily}"
                						FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" Foreground="#FF585858"
                						RenderTransformOrigin="0.5,0.5" TextAlignment="Right" VerticalAlignment="Center"
                						HorizontalAlignment="Right" Margin="0,0,10,0" FontStyle="{TemplateBinding FontStyle}" />
                				</Grid>
                			</Grid>
                		</Border>
                	</Viewbox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
