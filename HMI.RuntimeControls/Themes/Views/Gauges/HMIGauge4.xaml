<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HMI.RuntimeControls.Gauges">
    <Style TargetType="local:HMIGauge4">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:HMIGauge4">
                    <Grid>
                        <Viewbox x:Name="ContainerViewbox" 
                                Width="Auto" Height="Auto" Stretch="Fill"
                                >
                            <Viewbox.Resources>
                                <Color x:Key="BackgroundColor">White</Color>
                                <Color x:Key="ForegroundColor">#FF0292C2</Color>
                                <Storyboard x:Name="BackgroundFillAnimation" x:Key="BackgroundFillAnimation">
                                    <DoubleAnimationUsingKeyFrames
                                            Storyboard.TargetProperty="(Shape.Fill).(GradientBrush.GradientStops)[1].(GradientStop.Offset)"
                                            Storyboard.TargetName="ShapeFill">
                                        <EasingDoubleKeyFrame KeyTime="0" Value="0.49" />
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="0.448" />
                                    </DoubleAnimationUsingKeyFrames>
                                    <DoubleAnimationUsingKeyFrames
                                            Storyboard.TargetProperty="(Shape.Fill).(GradientBrush.GradientStops)[2].(GradientStop.Offset)"
                                            Storyboard.TargetName="ShapeFill">
                                        <EasingDoubleKeyFrame KeyTime="0" Value="0.506" />
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="0.465" />
                                    </DoubleAnimationUsingKeyFrames>
                                    <DoubleAnimationUsingKeyFrames
                                            Storyboard.TargetProperty="(Shape.Fill).(GradientBrush.GradientStops)[0].(GradientStop.Offset)"
                                            Storyboard.TargetName="ShapeFill">
                                        <EasingDoubleKeyFrame KeyTime="0" Value="0" />
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="0" />
                                    </DoubleAnimationUsingKeyFrames>
                                    <DoubleAnimationUsingKeyFrames
                                            Storyboard.TargetProperty="(Shape.Fill).(GradientBrush.GradientStops)[3].(GradientStop.Offset)"
                                            Storyboard.TargetName="ShapeFill">
                                        <EasingDoubleKeyFrame KeyTime="0" Value="1" />
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="1" />
                                    </DoubleAnimationUsingKeyFrames>
                                </Storyboard>
                                <Storyboard x:Name="StartAnimation" x:Key="StartAnimation">
                                    <DoubleAnimationUsingKeyFrames
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                            Storyboard.TargetName="LayoutRoot">
                                        <EasingDoubleKeyFrame KeyTime="0" Value="0.06" />
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.4" Value="0.06" />
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.8" Value="1" />
                                        <EasingDoubleKeyFrame KeyTime="0:0:1.4" Value="1">
                                            <EasingDoubleKeyFrame.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </EasingDoubleKeyFrame.EasingFunction>
                                        </EasingDoubleKeyFrame>
                                    </DoubleAnimationUsingKeyFrames>
                                    <DoubleAnimationUsingKeyFrames
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)"
                                            Storyboard.TargetName="LayoutRoot">
                                        <EasingDoubleKeyFrame KeyTime="0" Value="-0.917" />
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.4" Value="-0.917" />
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.8" Value="0.006" />
                                        <EasingDoubleKeyFrame KeyTime="0:0:1.4" Value="0">
                                            <EasingDoubleKeyFrame.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </EasingDoubleKeyFrame.EasingFunction>
                                        </EasingDoubleKeyFrame>
                                    </DoubleAnimationUsingKeyFrames>
                                    <DoubleAnimationUsingKeyFrames
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                            Storyboard.TargetName="LayoutRoot">
                                        <EasingDoubleKeyFrame KeyTime="0" Value="-0.03" />
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.4" Value="-0.03" />
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.8" Value="0.039" />
                                        <EasingDoubleKeyFrame KeyTime="0:0:1.4" Value="1.001">
                                            <EasingDoubleKeyFrame.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </EasingDoubleKeyFrame.EasingFunction>
                                        </EasingDoubleKeyFrame>
                                    </DoubleAnimationUsingKeyFrames>
                                    <DoubleAnimationUsingKeyFrames
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                            Storyboard.TargetName="LayoutRoot">
                                        <EasingDoubleKeyFrame KeyTime="0" Value="48.5" />
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.4" Value="48.5" />
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.8" Value="48.434" />
                                        <EasingDoubleKeyFrame KeyTime="0:0:1.4" Value="0.001">
                                            <EasingDoubleKeyFrame.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </EasingDoubleKeyFrame.EasingFunction>
                                        </EasingDoubleKeyFrame>
                                    </DoubleAnimationUsingKeyFrames>
                                </Storyboard>
                                <Storyboard x:Name="MinArrowAnimation" x:Key="MinArrowAnimation" />
                            </Viewbox.Resources>
                            <Grid x:Name="LayoutRoot" RenderTransformOrigin="0.5,0.5" Height="100"
                                    Width="60">
                                <Grid.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform ScaleX="1" ScaleY="1" />
                                        <TranslateTransform X="0" Y="0" />
                                    </TransformGroup>
                                </Grid.RenderTransform>
                                <Rectangle x:Name="ShapeBackground"
                                        Fill="{TemplateBinding Background}"
                                        StrokeThickness="{TemplateBinding StrokeThikness}"
                                        RadiusX="{TemplateBinding CornerRadiusX}"
                                        RadiusY="{TemplateBinding CornerRadiusY}" />
                                <Rectangle x:Name="ShapeFill" Stroke="#00B2B2B2"
                                        StrokeThickness="{TemplateBinding StrokeThikness}"
                                        RadiusX="{TemplateBinding CornerRadiusX}"
                                        RadiusY="{TemplateBinding CornerRadiusY}">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                            <GradientStop
                                                    Color="{Binding Background, ElementName=LayoutRoot, Mode=TwoWay}" />
                                            <GradientStop
                                                    Color="{Binding Background, ElementName=LayoutRoot, Mode=TwoWay}"
                                                    Offset="0.49" />
                                            <GradientStop
                                                    Color="{Binding FillColor, RelativeSource={RelativeSource TemplatedParent}}"
                                                    Offset="0.506" />
                                            <GradientStop
                                                    Color="{Binding FillColor, RelativeSource={RelativeSource TemplatedParent}}"
                                                    Offset="1" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <Rectangle x:Name="MarginShape"
                                        StrokeThickness="{TemplateBinding StrokeThikness}"
                                        RadiusX="{TemplateBinding CornerRadiusX}"
                                        RadiusY="{TemplateBinding CornerRadiusY}">
                                    <Rectangle.Stroke>
                                        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                            <GradientStop Color="White" Offset="0.003" />
                                            <GradientStop Color="#FF707070" Offset="0.561" />
                                            <GradientStop Color="#FF898989" Offset="1" />
                                        </LinearGradientBrush>
                                    </Rectangle.Stroke>
                                </Rectangle>
                                <Rectangle x:Name="ShapeGlossyReflection"
                                        StrokeThickness="{TemplateBinding StrokeThikness}"
                                        Stroke="Transparent"
                                        RadiusX="{TemplateBinding CornerRadiusX}"
                                        RadiusY="{TemplateBinding CornerRadiusY}">
                                    <Rectangle.Fill>
                                        <RadialGradientBrush RadiusY="2.76" RadiusX="3.347"
                                                Center="1.79,1.395" GradientOrigin="1.818,1.414">
                                            <GradientStop Color="Transparent" />
                                            <GradientStop Color="#33FFFFFF" Offset="0.558" />
                                            <GradientStop Color="Transparent" Offset="0.558" />
                                            <GradientStop Color="Transparent" Offset="0.564" />
                                            <GradientStop Color="Transparent" Offset="0.428" />
                                        </RadialGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <Rectangle x:Name="ShapeGlossyReflection_Copy"
                                        StrokeThickness="{TemplateBinding StrokeThikness}"
                                        Stroke="Transparent"
                                        RadiusX="{TemplateBinding CornerRadiusX}"
                                        RadiusY="{TemplateBinding CornerRadiusY}">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush EndPoint="1.524,0.111"
                                                MappingMode="RelativeToBoundingBox"
                                                StartPoint="0.31,0.107">
                                            <GradientStop Color="Transparent" />
                                            <GradientStop Color="#4CFFFFFF" Offset="0.558" />
                                            <GradientStop Color="#2FFFFFFF" Offset="0.518" />
                                            <GradientStop Color="Transparent" Offset="0.578" />
                                            <GradientStop Color="#0DFFFFFF" Offset="0.459" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                            </Grid>
                        </Viewbox>
                        <Viewbox>
                            <Grid RenderTransformOrigin="0.5,0.5" VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="0.575*" />
                                    <RowDefinition Height="0.425*" />
                                </Grid.RowDefinitions>
                                <Grid.RenderTransform>
                                    <ScaleTransform ScaleY="0.6" ScaleX="0.6" />
                                </Grid.RenderTransform>
                                <TextBlock x:Name="LevelValue" Text="00.0"
                                        FontFamily="{TemplateBinding FontFamily}"
                                        FontSize="{TemplateBinding FontSize}"
                                        FontWeight="{TemplateBinding FontWeight}"
                                        Foreground="#FF646464" RenderTransformOrigin="0.5,0.5"
                                        TextAlignment="Center" VerticalAlignment="Bottom" />
                                <TextBlock x:Name="UnitLabel" TextWrapping="Wrap" Text="Unit"
                                        FontFamily="{TemplateBinding FontFamily}"
                                        FontSize="{TemplateBinding FontSize}" Foreground="#FF6A6A6A"
                                        RenderTransformOrigin="0.5,0.5" Grid.Row="1"
                                        TextAlignment="Center"
                                        FontWeight="{TemplateBinding FontWeight}" LineHeight="9.333"
                                        Margin="0" VerticalAlignment="Top"
                                        HorizontalAlignment="Center" Height="16" />
                            </Grid>
                        </Viewbox>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
