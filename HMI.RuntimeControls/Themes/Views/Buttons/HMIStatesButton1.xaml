<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:Converters="clr-namespace:HMI.Runtime.Shared.Common.Converters;assembly=HMI.Runtime.Shared"
                    xmlns:local="clr-namespace:HMI.RuntimeControls.Buttons">

    <Converters:PercentageToOpacityConverter x:Key="PercentageToOpacityConverter" />

    <Style TargetType="local:HMIStatesButton1">

        <Setter Property="Background" Value="#FFD6D6D6" />
        <Setter Property="BorderBrush" Value="#FFAAAAAA" />
        <Setter Property="BorderThickness" Value="1,1,1,2" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="ChromeFrontBrush">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Offset="0.499" Color="#72FFFFFF" />
                    <GradientStop Offset="0.5" Color="Transparent" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="MouseOverBrush">
            <Setter.Value>
                <RadialGradientBrush Center="0.496,0.956" GradientOrigin="0.496,0.956" RadiusX="0.433" RadiusY="0.685">
                    <GradientStop Offset="0" Color="#CCFFFFFF" />
                    <GradientStop Offset="1" Color="Transparent" />
                </RadialGradientBrush>
            </Setter.Value>
        </Setter>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:HMIStatesButton1">
                    <Grid x:Name="LayoutRoot">

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0:0:0.5">
                                        <VisualTransition.GeneratedEasingFunction>
                                            <CircleEase EasingMode="EaseOut" />
                                        </VisualTransition.GeneratedEasingFunction>
                                    </VisualTransition>
                                    <VisualTransition GeneratedDuration="0:0:0.1" To="Pressed" />
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <DoubleAnimation Duration="0"
                                                         Storyboard.TargetName="BackgroundAnimation"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.75" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimation Duration="0"
                                                         Storyboard.TargetName="BackgroundAnimation"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation Duration="0"
                                                         Storyboard.TargetName="DisabledVisualElement"
                                                         Storyboard.TargetProperty="(UIElement.Opacity)"
                                                         To="0.65" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="DisabledVisualElement" Storyboard.TargetProperty="(UIElement.Visibility)">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Visible</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Focused">
                                    <Storyboard>
                                        <DoubleAnimation Duration="0"
                                                         Storyboard.TargetName="FocusVisualElement"
                                                         Storyboard.TargetProperty="(UIElement.Opacity)"
                                                         To="0.55" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Unfocused" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Border x:Name="Background"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                            <Grid Margin="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="BackgroundAnimation"
                                        Grid.RowSpan="3"
                                        Grid.ColumnSpan="3"
                                        Background="{TemplateBinding MouseOverBrush}"
                                        CornerRadius="{TemplateBinding CornerRadius}"
                                        Opacity="0" />
                                <Image x:Name="uxButtonImage"
                                       MaxWidth="{TemplateBinding IconMaxSize}"
                                       MaxHeight="{TemplateBinding IconMaxSize}"
                                       Margin="{TemplateBinding IconMargin}"
                                       Opacity="{Binding Path=IconOpacity,
                                                         RelativeSource={RelativeSource TemplatedParent},
                                                         Converter={StaticResource PercentageToOpacityConverter}}"
                                       Source="{TemplateBinding IconImage}"
                                       Stretch="{TemplateBinding IconStretch}" />
                                <ContentPresenter x:Name="uxContentPresenter"
                                                  Grid.Row="1"
                                                  Grid.Column="1"
                                                  Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}">
                                    <ContentPresenter.Content>
                                        <TextBlock x:Name="uxOutputElement"
                                                   Margin="{TemplateBinding Padding}"
                                                   VerticalAlignment="Center"
                                                   Foreground="{TemplateBinding Foreground}"
                                                   Text="{TemplateBinding SymbolicText}"
                                                   TextAlignment="Left"
                                                   TextWrapping="Wrap" />
                                    </ContentPresenter.Content>
                                </ContentPresenter>
                                <Border x:Name="ChromeBrushElement"
                                        Grid.RowSpan="3"
                                        Grid.ColumnSpan="3"
                                        Background="{TemplateBinding ChromeFrontBrush}"
                                        CornerRadius="{TemplateBinding CornerRadius}" />
                            </Grid>
                        </Border>
                        <Border x:Name="FocusVisualElement"
                                BorderBrush="#FFE5E5E5"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                IsHitTestVisible="false"
                                Opacity="0" />
                        <Border x:Name="DisabledVisualElement"
                                Background="White"
                                BorderBrush="White"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Opacity="0"
                                Visibility="Collapsed" />

                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

    </Style>

</ResourceDictionary>
