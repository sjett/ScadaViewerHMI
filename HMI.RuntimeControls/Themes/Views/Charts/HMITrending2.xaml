<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:HMI.RuntimeControls.Charts"
    xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation">
    <Style TargetType="{x:Type local:HMITrending2}">
        <Setter Property="Background" Value="White" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HMITrending2}">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <WrapPanel Margin="4">
                            <TextBlock Text="开始日期" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <DatePicker x:Name="PART_StartDatePicker" Width="125" Margin="0,0,4,0" />
                            <TextBox x:Name="PART_StartTimeTextBox" Width="72" Text="00:00:00" VerticalContentAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock Text="结束日期" VerticalAlignment="Center" Margin="8,0,4,0" />
                            <DatePicker x:Name="PART_EndDatePicker" Width="125" Margin="0,0,8,0" />
                            <TextBox x:Name="PART_EndTimeTextBox" Width="72" Text="23:59:59" VerticalContentAlignment="Center" Margin="0,0,8,0" />
                            <Button x:Name="PART_RefreshButton" Content="刷新" Padding="12,3" />
                        </WrapPanel>
                        <telerik:RadCartesianChart x:Name="PART_Chart"
                                                   Grid.Row="1"
                                                   Palette="Windows11">
                            <telerik:RadCartesianChart.Behaviors>
                                <telerik:ChartTrackBallBehavior ShowIntersectionPoints="True"
                                                                ShowTrackInfo="True" />
                            </telerik:RadCartesianChart.Behaviors>
                            <telerik:RadCartesianChart.HorizontalAxis>
                                <telerik:DateTimeContinuousAxis LabelFormat="MM-dd HH:mm" />
                            </telerik:RadCartesianChart.HorizontalAxis>
                            <telerik:RadCartesianChart.VerticalAxis>
                                <telerik:LinearAxis />
                            </telerik:RadCartesianChart.VerticalAxis>
                        </telerik:RadCartesianChart>
                        <TextBlock x:Name="PART_StatusText"
                                   Grid.Row="2"
                                   Margin="4"
                                   Text="正在等待历史趋势查询"
                                   TextWrapping="Wrap" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
