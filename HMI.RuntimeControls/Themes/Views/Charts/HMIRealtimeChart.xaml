<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:HMI.RuntimeControls.Charts">
    <Style TargetType="{x:Type local:HMIRealtimeChart}">
        <Setter Property="Background" Value="White" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HMIRealtimeChart}">
                    <Grid Background="{TemplateBinding Background}">
                        <ContentControl x:Name="PART_ChartHost" />
                        <TextBlock x:Name="PART_StatusText"
                                   VerticalAlignment="Bottom"
                                   Margin="4"
                                   Padding="2"
                                   Background="#CCFFFFFF"
                                   TextWrapping="Wrap" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
