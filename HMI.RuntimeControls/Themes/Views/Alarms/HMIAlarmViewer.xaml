<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:HMI.RuntimeControls.Alarms"
    xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation">
    <Style TargetType="{x:Type local:HMIAlarmViewer}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HMIAlarmViewer}">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="4">
                            <Button x:Name="PART_RefreshButton"
                                    DockPanel.Dock="Right"
                                    Content="查询"
                                    Margin="8,0,0,0"
                                    Padding="12,3" />
                            <WrapPanel>
                                <TextBlock Text="开始日期" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <DatePicker x:Name="PART_StartDatePicker" Width="125" Margin="0,0,4,0" />
                                <TextBlock Text="结束日期" VerticalAlignment="Center" Margin="8,0,4,0" />
                                <DatePicker x:Name="PART_EndDatePicker" Width="125" Margin="0,0,4,0" />
                                <StackPanel x:Name="PART_AlarmVisibilityPanel" Orientation="Horizontal">
                                    <TextBlock Text="事件范围" VerticalAlignment="Center" Margin="8,0,4,0" />
                                    <ComboBox x:Name="PART_AlarmVisibilitySelector" Width="100" />
                                </StackPanel>
                                <StackPanel x:Name="PART_GroupFilterPanel" Orientation="Vertical" Margin="8,0,0,0">
                                    <TextBlock Text="报警组" />
                                    <ListBox x:Name="PART_GroupFilterList"
                                             Width="160"
                                             Height="72"
                                             SelectionMode="Multiple"
                                             ToolTip="支持多选；列表显示完整层级路径"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                </StackPanel>
                                <StackPanel x:Name="PART_TypeFilterPanel" Orientation="Vertical" Margin="8,0,0,0">
                                    <TextBlock Text="报警类型" />
                                    <ListBox x:Name="PART_TypeFilterList"
                                             Width="160"
                                             Height="72"
                                             SelectionMode="Multiple"
                                             ToolTip="支持多选；列表显示完整层级路径"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                </StackPanel>
                                <StackPanel x:Name="PART_PriorityFilterPanel" Orientation="Horizontal">
                                    <TextBlock Text="优先级" VerticalAlignment="Center" Margin="8,0,4,0" />
                                    <TextBox x:Name="PART_MinimumPriorityBox" Width="38" ToolTip="最低级别，-1 表示不限" />
                                    <TextBlock Text="至" VerticalAlignment="Center" Margin="4,0" />
                                    <TextBox x:Name="PART_MaximumPriorityBox" Width="38" ToolTip="最高级别，-1 表示不限" />
                                </StackPanel>
                                <StackPanel x:Name="PART_MaximumCountPanel" Orientation="Horizontal">
                                    <TextBlock Text="最多显示" VerticalAlignment="Center" Margin="8,0,4,0" />
                                    <TextBox x:Name="PART_MaximumCountBox" Width="55" />
                                </StackPanel>
                                <StackPanel x:Name="PART_SortOrderPanel" Orientation="Horizontal">
                                    <TextBlock Text="排序" VerticalAlignment="Center" Margin="8,0,4,0" />
                                    <ComboBox x:Name="PART_SortOrderSelector" Width="105" />
                                </StackPanel>
                                <StackPanel x:Name="PART_TextFilterPanel" Orientation="Horizontal">
                                    <TextBlock Text="文本筛选" VerticalAlignment="Center" Margin="8,0,4,0" />
                                    <TextBox x:Name="PART_TextFilterBox" Width="120" />
                                </StackPanel>
                            </WrapPanel>
                        </DockPanel>
                        <telerik:RadGridView x:Name="PART_AlarmGrid"
                                             Grid.Row="1"
                                             AutoGenerateColumns="False"
                                             IsReadOnly="True"
                                             SelectionMode="Single"
                                             ShowGroupPanel="False"
                                             CanUserInsertRows="False" />
                        <TextBlock x:Name="PART_StatusText"
                                   Grid.Row="2"
                                   Text="{Binding StatusText, RelativeSource={RelativeSource TemplatedParent}}"
                                   Margin="4"
                                   TextWrapping="Wrap" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
