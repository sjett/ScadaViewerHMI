<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:HMI.RuntimeControls.General.Views"
                    xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
                    xmlns:telerikControls="clr-namespace:Telerik.Windows.Controls;assembly=Telerik.Windows.Controls.Input">

    <telerik:InvertedBooleanConverter x:Key="InvertedBooleanConverter" />

    <Style x:Name="logBookConfigurator_Column0_Style" TargetType="FrameworkElement">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Margin" Value="5" />
        <Setter Property="Grid.Column" Value="0" />
    </Style>

    <Style x:Name="logBookConfigurator_Column1_Style" TargetType="FrameworkElement">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Margin" Value="5" />
        <Setter Property="Grid.Column" Value="1" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <Style x:Name="logBookConfiguratorButton" TargetType="Button">
        <Setter Property="MinWidth" Value="75" />
        <Setter Property="Margin" Value="5" />
    </Style>

    <Style TargetType="local:HMILogbookConfigurator">
        <Setter Property="MinWidth" Value="520" />
        <Setter Property="MinHeight" Value="260" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:HMILogbookConfigurator">
                    <Border Background="{Binding DialogsBackground}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ScrollViewer Foreground="{Binding DialogsForeground}"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto">
                                <Grid x:Name="uxScrollGrid">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Style="{StaticResource logBookConfigurator_Column0_Style}"
                                               Text="{Binding Translations.RefreshIntervalInSeconds,
                                                              FallbackValue='#Refresh interval in seconds'}"
                                               TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Style="{StaticResource logBookConfigurator_Column1_Style}">
                                        <telerikControls:RadNumericUpDown MinWidth="100"
                                                                  VerticalAlignment="Center"
                                                                  IsInteger="True"
                                                                  Maximum="86400"
                                                                  Minimum="10"
                                                                  Value="{Binding Configuration.RefreshIntervalInSeconds,
                                                                                  Mode=TwoWay}" />
                                        <TextBlock Margin="5"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding Translations.RefreshIntervalDescription,
                                                                  FallbackValue='#10 .. 86400 (1 day)'}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <TextBlock Grid.Row="1"
                                               Style="{StaticResource logBookConfigurator_Column0_Style}"
                                               Text="{Binding Translations.MaximumNumberOfEntries,
                                                              FallbackValue='#Maximum number of entries'}" />
                                    <StackPanel Grid.Row="1"
                                                Orientation="Horizontal"
                                                Style="{StaticResource logBookConfigurator_Column1_Style}">
                                        <telerikControls:RadNumericUpDown MinWidth="100"
                                                                  VerticalAlignment="Center"
                                                                  IsInteger="True"
                                                                  Maximum="100000"
                                                                  Minimum="1"
                                                                  Value="{Binding Configuration.MaxEntries,
                                                                                  Mode=TwoWay}" />
                                        <TextBlock Margin="5"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding Translations.MaximumNumberOfEntriesDescription,
                                                                  FallbackValue='#1 .. 100000'}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <TextBlock Grid.Row="2"
                                               Style="{StaticResource logBookConfigurator_Column0_Style}"
                                               Text="{Binding Translations.TopicLabel,
                                                              FallbackValue='#Topic'}" />
                                    <telerikControls:RadComboBox Grid.Row="2"
                                                         VerticalAlignment="Center"
                                                         ClearSelectionButtonContent="{Binding Translations.TopicAllMessages,
                                                                                               FallbackValue='#(all messages)'}"
                                                         ClearSelectionButtonVisibility="Visible"
                                                         EmptyText="{Binding Translations.TopicAllMessages,
                                                                             FallbackValue='#(all messages)'}"
                                                         IsEditable="True"
                                                         ItemsSource="{Binding Topics}"
                                                         StaysOpenOnEdit="True"
                                                         Style="{StaticResource logBookConfigurator_Column1_Style}"
                                                         Text="{Binding Topic,
                                                                        Mode=TwoWay}" />

                                    <TextBlock Grid.Row="3"
                                               Margin="5,10,5,10"
                                               Style="{StaticResource logBookConfigurator_Column0_Style}"
                                               Text="{Binding Translations.TimeFilter,
                                                              FallbackValue='#Time filter'}" />
                                    <telerik:RadDropDownButton x:Name="uxTimeRangePickerRadDropDownButton"
                                                               Grid.Row="3"
                                                               MinWidth="340"
                                                               MinHeight="20"
                                                               HorizontalAlignment="Stretch"
                                                               HorizontalContentAlignment="Left"
                                                               Background="White"
                                                               Content="{Binding DisplayTimeFilter}"
                                                               IsEnabled="{Binding Configuration.DisableTimeFilter,
                                                                                   Converter={StaticResource InvertedBooleanConverter}}"
                                                               Style="{StaticResource logBookConfigurator_Column1_Style}">
                                        <telerik:RadDropDownButton.ContentTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                            </DataTemplate>
                                        </telerik:RadDropDownButton.ContentTemplate>
                                    </telerik:RadDropDownButton>
                                    <CheckBox Grid.Row="4"
                                              Grid.Column="1"
                                              Content="{Binding Translations.DisableTimeFilter,
                                                                FallbackValue='#Disable Time Filter'}"
                                              IsChecked="{Binding Configuration.DisableTimeFilter,
                                                                  Mode=TwoWay}"
                                              Style="{StaticResource logBookConfigurator_Column1_Style}" />

                                </Grid>
                            </ScrollViewer>
                            <Grid x:Name="uxButtonsPanel" Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button x:Name="uxApplyButton"
                                        Grid.Column="1"
                                        Background="{Binding ButtonBackground}"
                                        Content="{Binding Translations.ConfiguratorApplyButton,
                                                          FallbackValue='#Apply'}"
                                        Foreground="{Binding ButtonForeground}"
                                        Style="{StaticResource logBookConfiguratorButton}"
                                        ToolTipService.ToolTip="{Binding Translations.ConfiguratorApplyButtonToolTip,
                                                                         FallbackValue='#Apply configurations and close'}" />
                                <Button x:Name="uxCancelButton"
                                        Grid.Column="2"
                                        Background="{Binding ButtonBackground}"
                                        Content="{Binding Translations.ConfiguratorCancelButton,
                                                          FallbackValue='#Cancel'}"
                                        Foreground="{Binding ButtonForeground}"
                                        Style="{StaticResource logBookConfiguratorButton}"
                                        ToolTipService.ToolTip="{Binding Translations.ConfiguratorCancelButtonToolTip,
                                                                         FallbackValue='#Cancel and close'}" />
                            </Grid>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
