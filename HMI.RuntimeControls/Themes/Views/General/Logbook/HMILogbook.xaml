    <SolidColorBrush x:Key="logbook_Foreground_Brush" Color="#FF787878" />

    <SolidColorBrush x:Key="logbook_Scrollbar_Background_Brush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="logbook_Scrollbar_Foreground_Brush" Color="#FFAAAAAA" />

    <SolidColorBrush x:Key="logbook_Dialogs_Background_Brush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="logbook_Dialogs_Foreground_Brush" Color="#FF787878" />

    <LinearGradientBrush x:Key="logbook_Button_Background_Brush" StartPoint="0.5,0" EndPoint="0.5,1">
