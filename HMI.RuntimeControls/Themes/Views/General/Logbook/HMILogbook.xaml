    <Style x:Key="logbook_TimeFilter_TextBlock_Style" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource logbook_TimeFilter_Foreground_Brush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontStyle" Value="Normal" />
