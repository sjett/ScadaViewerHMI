                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" MinWidth="16" />
                                </Grid.ColumnDefinitions>
                                <ItemsControl x:Name="uxLogbookItems" ItemsSource="{Binding Entries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>

                                            <Grid MaxHeight="{Binding DataContext.MaxHeight, ElementName=uxLogbookItems}">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition />
                                                </Grid.RowDefinitions>
                                                <Border Background="{Binding DataContext.SenderBackground, ElementName=uxLogbookItems}" Padding="2">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Foreground="{Binding DataContext.SenderForeground,
                                                                                        ElementName=uxLogbookItems}"
                                                                   Style="{StaticResource logbook_Sender_TextBlock_Style}"
                                                                   Text="{Binding Sender}" />

                                                        <TextBlock Grid.Column="1"
                                                                   HorizontalAlignment="Right"
                                                                   Foreground="{Binding DataContext.TimeStampForeground,
                                                                                        ElementName=uxLogbookItems}"
                                                                   Style="{StaticResource logbook_TimeStamp_TextBlock_Style}"
                                                                   Text="{Binding TimeStamp}" />
                                                    </Grid>
                                                </Border>
                                                <Border Grid.Row="1"
                                                        Background="{Binding DataContext.SubjectBackground,
                                                                             ElementName=uxLogbookItems}"
                                                        Padding="2">
                                                    <TextBlock HorizontalAlignment="Stretch"
                                                               Foreground="{Binding DataContext.SubjectForeground,
                                                                                    ElementName=uxLogbookItems}"
                                                               Style="{StaticResource logbook_Subject_TextBlock_Style}"
                                                               Text="{Binding Subject}"
                                                               TextWrapping="Wrap" />
                                                </Border>

                                                <ScrollViewer Name="uxBodyScroller"
                                                              Grid.Row="2"
                                                              Margin="0"
                                                              Background="{Binding ElementName=uxLogbookItems,
                                                                                   Path=DataContext.ScrollbarBackground}"
                                                              BorderThickness="0"
                                                              Foreground="{Binding ElementName=uxLogbookItems,
                                                                                   Path=DataContext.ScrollbarForeground}"
                                                              HorizontalScrollBarVisibility="Hidden"
                                                              Padding="0"
                                                              Style="{StaticResource ScrollViewerStyle1}"
                                                              VerticalScrollBarVisibility="Auto">
                                                    <RichTextBox Width="{Binding ElementName=uxBodyScroller,
                                                                                 Path=ViewportWidth}"
                                                                 Margin="0"
                                                                 HorizontalAlignment="Left"
                                                                 Background="{Binding DataContext.BodyBackground,
                                                                                      ElementName=uxLogbookItems}"
                                                                 BorderThickness="0"
                                                                 IsReadOnly="true"
                                                                 Padding="0"
                                                                 TextAlignment="Justify"
                                                                 TextWrapping="Wrap"
                                                                 VerticalScrollBarVisibility="Hidden">
                                                        <Paragraph>
                                                            <Run Foreground="{Binding DataContext.BodyForeground, ElementName=uxLogbookItems}" Text="{Binding Body, Mode=OneTime}" />
                                                        </Paragraph>
                                                    </RichTextBox>
                                                </ScrollViewer>

                                                <!--
                                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Hidden">
                                                    <TextBlock Width="Auto" Text="{Binding Body}" TextWrapping="Wrap" />
                                                    </ScrollViewer>
                                                -->
                                            </Grid>

                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>

                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.Template>
                                        <ControlTemplate>
                                            <ScrollViewer x:Name="uxLogbookItemsScrollViewer"
                                                          BorderThickness="0"
                                                          HorizontalScrollBarVisibility="Disabled"
                                                          Padding="0"
                                                          VerticalScrollBarVisibility="Hidden">
                                                <ItemsPresenter />
                                            </ScrollViewer>
                                        </ControlTemplate>
                                    </ItemsControl.Template>
                                </ItemsControl>

                                <ScrollBar Grid.Column="1"
                                           Background="{Binding ScrollbarBackground}"
                                           Foreground="{Binding ScrollbarForeground}"
                                           LargeChange="{Binding ScrollLargeChange}"
                                           Maximum="{Binding ScrollMaximum}"
                                           Minimum="{Binding ScrollMinimum}"
                                           Orientation="Vertical"
                                           SmallChange="1"
                                           Style="{StaticResource ScrollBarStyle1}"
                                           Value="{Binding CurrentEntryNumber,
                                                           Mode=TwoWay}" />
                            </Grid>
                        </Grid>
                    </Border>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
