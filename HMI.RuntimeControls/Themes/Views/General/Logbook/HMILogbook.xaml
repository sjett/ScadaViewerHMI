    <Style x:Key="logbook_Topic_TextBlock_Style" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource logbook_Topic_Foreground_Brush}" />
        <Setter Property="FontSize" Value="12" />
