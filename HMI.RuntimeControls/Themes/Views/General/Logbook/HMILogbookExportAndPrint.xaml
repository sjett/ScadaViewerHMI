<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:Converters="clr-namespace:HMI.RuntimeControls.General.Converters"
                    xmlns:local="clr-namespace:HMI.RuntimeControls.General.Views"
                    xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation">

    <Converters:BooleanToVisibilityConverter x:Key="booleanToVisibilityConverter" />
    <Converters:InvertedBooleanToVisibilityConverter x:Key="invertedBooleanToVisibilityConverter" />

    <Style x:Name="logbookExportAndPrint_Button_Style" TargetType="Button">
        <Setter Property="MinWidth" Value="80" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Margin" Value="5,10,5,10" />
        <Setter Property="Padding" Value="10" />
    </Style>


    <Style TargetType="local:HMILogbookExportAndPrint">
        <Setter Property="MinWidth" Value="400" />
        <Setter Property="MinHeight" Value="300" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:HMILogbookExportAndPrint">
                    <Border x:Name="uxOuterBorder"
                            Background="{Binding DialogsBackground}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentControl>
                            <Border x:Name="uxInnerBorder">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <telerik:RadRichTextBox x:Name="uxPreviewRadRichTextBox"
                                                            IsContextMenuEnabled="False"
                                                            IsReadOnly="True"
                                                            IsSelectionMiniToolBarEnabled="False"
                                                            IsSpellCheckingEnabled="False"
                                                            LayoutMode="Paged"/>
                                    <Rectangle  Grid.Row="1" HorizontalAlignment="Stretch" Height="3" Fill="Black" Opacity="0.25"/>
                                    <Grid x:Name="uxButtonsPanel" Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Translations.ExportAndPrintTemplateLabel, FallbackValue=#Template}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding TemplateName}" VerticalAlignment="Center" Margin="10" FontWeight="Bold" MinWidth="100" MaxWidth="200"/>
                                        </StackPanel>
                                        <Button x:Name="uxEditTemplateButton"
                                                Grid.Column="1"
                                                Background="{Binding ButtonBackground}"
                                                Content="{Binding Translations.ExportAndPrintEditTemplateButton,
                                                                  FallbackValue='#Edit Template'}"
                                                Foreground="{Binding ButtonForeground}"
                                                Style="{StaticResource logbookExportAndPrint_Button_Style}"
                                                ToolTipService.ToolTip="{Binding Translations.ExportAndPrintEditTemplateButtonToolTip,
                                                                                 FallbackValue='#Edit Template Document'}" />
                                        <Button x:Name="uxPrintButton"
                                                Grid.Column="2"
                                                Background="{Binding ButtonBackground}"
                                                Content="{Binding Translations.ExportAndPrintPrintButton,
                                                                  FallbackValue='#Print'}"
                                                Foreground="{Binding ButtonForeground}"
                                                Style="{StaticResource logbookExportAndPrint_Button_Style}"
                                                ToolTipService.ToolTip="{Binding Translations.ExportAndPrintPrintButtonToolTip,
                                                                                 FallbackValue='#Print Document'}"
                                                Visibility="{Binding IsInExportMode,
                                                                     Converter={StaticResource invertedBooleanToVisibilityConverter}}" />
                                        <Button x:Name="uxExportButton"
                                                Grid.Column="3"
                                                Background="{Binding ButtonBackground}"
                                                Content="{Binding Translations.ExportAndPrintExportButton,
                                                                  FallbackValue='#Export'}"
                                                Foreground="{Binding ButtonForeground}"
                                                Style="{StaticResource logbookExportAndPrint_Button_Style}"
                                                ToolTipService.ToolTip="{Binding Translations.ExportAndPrintPrintButtonToolTip,
                                                                                 FallbackValue='#Export Document to File'}"
                                                Visibility="{Binding IsInExportMode,
                                                                     Converter={StaticResource booleanToVisibilityConverter}}" />
                                        <Button x:Name="uxCloseButton"
                                                Grid.Column="4"
                                                Background="{Binding ButtonBackground}"
                                                Content="{Binding Translations.ExportAndPrintCloseButton,
                                                                  FallbackValue='#Close'}"
                                                Foreground="{Binding ButtonForeground}"
                                                Style="{StaticResource logbookExportAndPrint_Button_Style}"
                                                ToolTipService.ToolTip="{Binding Translations.ExportAndPrintCloseButtonToolTip,
                                                                                 FallbackValue='#Close'}" />
                                    </Grid>
                                </Grid>

                            </Border>
                        </ContentControl>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
