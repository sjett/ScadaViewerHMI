<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:HMI.RuntimeControls.General">

    <Style TargetType="local:HMILanguageSelector1">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:HMILanguageSelector1">
                    <Grid x:Name="LayoutRoot">
                        <ComboBox x:Name="OutputElement" ItemsSource="{Binding Languages}" SelectedValuePath="LanguageId" DisplayMemberPath="Description"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
