							</local:PathListBox>-->

                            <local:PathListBox x:Name="Labels" 
                                               SourceElement="{Binding ElementName=ScaleLabels}" 
                                               Distribution="Even">

								<!--Text="{Binding Path=Translator.North, RelativeSource={RelativeSource TemplatedParent}}"-->
								<TextBlock x:Name="UxNorth" 
									   FontSize="{Binding Path=MajorLabelsFontSize, RelativeSource={RelativeSource TemplatedParent}}" 
									   Foreground="{TemplateBinding MajorLabelsForeground}" 
									   TextAlignment="Center" 
									   TextWrapping="Wrap" 
									   Visibility="{Binding Path=MajorLabelsVisible, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanVisibilityConverter}}"/>
								<TextBlock x:Name="UxNorthEast" 
									   FontSize="{Binding Path=MinorLabelsFontSize, RelativeSource={RelativeSource TemplatedParent}}" 
									   Foreground="{TemplateBinding MinorLabelsForeground}" 
									   TextAlignment="Center" 
									   TextWrapping="Wrap" 
									   Visibility="{Binding Path=MinorLabelsVisible, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanVisibilityConverter}}"/>
								<TextBlock x:Name="UxEast" 
									   FontSize="{Binding Path=MajorLabelsFontSize, RelativeSource={RelativeSource TemplatedParent}}" 
									   Foreground="{TemplateBinding MajorLabelsForeground}" 
									   TextAlignment="Center" 
									   TextWrapping="Wrap" 
									   Visibility="{Binding Path=MajorLabelsVisible, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanVisibilityConverter}}"/>
								<TextBlock x:Name="UxSouthEast" 
									   FontSize="{Binding Path=MinorLabelsFontSize, RelativeSource={RelativeSource TemplatedParent}}" 
									   Foreground="{TemplateBinding MinorLabelsForeground}" 
									   TextAlignment="Center" 
									   TextWrapping="Wrap" 
									   Visibility="{Binding Path=MinorLabelsVisible, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanVisibilityConverter}}"/>
								<TextBlock x:Name="UxSouth" 
									   FontSize="{Binding Path=MajorLabelsFontSize, RelativeSource={RelativeSource TemplatedParent}}" 
									   Foreground="{TemplateBinding MajorLabelsForeground}" 
									   TextAlignment="Center" 
									   TextWrapping="Wrap" 
									   Visibility="{Binding Path=MajorLabelsVisible, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanVisibilityConverter}}"/>
								<TextBlock x:Name="UxSouthWest" 
									   FontSize="{Binding Path=MinorLabelsFontSize, RelativeSource={RelativeSource TemplatedParent}}" 
									   Foreground="{TemplateBinding MinorLabelsForeground}" 
									   TextAlignment="Center" 
									   TextWrapping="Wrap" 
									   Visibility="{Binding Path=MinorLabelsVisible, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanVisibilityConverter}}"/>
								<TextBlock x:Name="UxWest" 
									   FontSize="{Binding Path=MajorLabelsFontSize, RelativeSource={RelativeSource TemplatedParent}}" 
									   Foreground="{TemplateBinding MajorLabelsForeground}" 
									   TextAlignment="Center" 
									   TextWrapping="Wrap" 
									   Visibility="{Binding Path=MajorLabelsVisible, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanVisibilityConverter}}"/>
								<TextBlock x:Name="UxNorthWest" 
									   FontSize="{Binding Path=MinorLabelsFontSize, RelativeSource={RelativeSource TemplatedParent}}" 
									   Foreground="{TemplateBinding MinorLabelsForeground}" 
									   TextAlignment="Center" 
									   TextWrapping="Wrap" 
									   Visibility="{Binding Path=MinorLabelsVisible, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanVisibilityConverter}}"/>
							</local:PathListBox>
							
							<Ellipse x:Name="ChromeBrushElement" Margin="0" RenderTransformOrigin="0.5,0.5" Stroke="{x:Null}" Fill="{TemplateBinding ChromeFrontBrush}">
								<Ellipse.RenderTransform>
                                    <ScaleTransform ScaleY="0.88" ScaleX="0.88"/>
								</Ellipse.RenderTransform>
							</Ellipse>
							
						</Grid>
						
					</Viewbox>

				</ControlTemplate>
			</Setter.Value>
		</Setter>

	</Style>

</ResourceDictionary>
