<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:HMI.RuntimeControls.Reporting">
    <Style TargetType="{x:Type local:HMITelerikReportViewer}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HMITelerikReportViewer}">
                    <Grid Margin="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <WrapPanel Grid.Row="0" Margin="0,0,0,6" VerticalAlignment="Center">
                            <TextBlock Text="Report:" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <ComboBox Width="190" ItemsSource="{Binding ReportTypes, RelativeSource={RelativeSource TemplatedParent}}"
                                      SelectedItem="{Binding SelectedDataType, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                            <TextBlock Text="From:" VerticalAlignment="Center" Margin="12,0,4,0" />
                            <DatePicker SelectedDate="{Binding StartDate, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                            <TextBlock Text="To:" VerticalAlignment="Center" Margin="8,0,4,0" />
                            <DatePicker SelectedDate="{Binding EndDate, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                            <Button x:Name="PART_ExportPdfButton" Content="Export PDF" Margin="12,0,4,0" Padding="10,4"
                                    IsEnabled="{Binding CanExport, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Button x:Name="PART_ExportExcelButton" Content="Export Excel" Padding="10,4"
                                    IsEnabled="{Binding CanExport, RelativeSource={RelativeSource TemplatedParent}}" />
                        </WrapPanel>
                        <DataGrid Grid.Row="1" Visibility="{Binding ChannelListVisibility, RelativeSource={RelativeSource TemplatedParent}}"
                                  ItemsSource="{Binding Channels, RelativeSource={RelativeSource TemplatedParent}}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Include" Binding="{Binding IsSelected, Mode=TwoWay}" Width="Auto" />
                                <DataGridTextColumn Header="RapidSCADA channel" Binding="{Binding Name}" IsReadOnly="True" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Grid.Row="2" Margin="2,6,2,0"
                                   Text="{Binding StatusMessage, RelativeSource={RelativeSource TemplatedParent}}"
                                   TextWrapping="Wrap" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
