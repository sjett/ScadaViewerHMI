<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:HMI.RuntimeControls.DataTable.Views"
    xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation">
    <Style TargetType="{x:Type local:HMIDataTable}">
        <Setter Property="Background" Value="White" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HMIDataTable}">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <WrapPanel Margin="4">
                            <StackPanel x:Name="PART_TimeSelectionPanel" Orientation="Horizontal">
                                <TextBlock Text="开始日期" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <DatePicker x:Name="PART_StartDatePicker" Width="125" Margin="0,0,4,0" />
                                <TextBox x:Name="PART_StartTimeTextBox" Width="72" Text="00:00:00" VerticalContentAlignment="Center" Margin="0,0,4,0" />
                                <TextBlock Text="结束日期" VerticalAlignment="Center" Margin="8,0,4,0" />
                                <DatePicker x:Name="PART_EndDatePicker" Width="125" Margin="0,0,8,0" />
                                <TextBox x:Name="PART_EndTimeTextBox" Width="72" Text="23:59:59" VerticalContentAlignment="Center" Margin="0,0,8,0" />
                            </StackPanel>
                            <Button x:Name="PART_RefreshButton" Content="查询" Margin="2" Padding="10,3" />
                            <Button x:Name="PART_SettingsButton" Content="设置" Margin="2" Padding="10,3" />
                            <Button x:Name="PART_CopyButton" Content="复制当前页" Margin="2" Padding="10,3" />
                            <Button x:Name="PART_ExportButton" Content="导出 CSV" Margin="2" Padding="10,3" />
                            <Button x:Name="PART_SaveConfigurationButton" Content="保存配置" Margin="2" Padding="10,3" />
                            <Button x:Name="PART_LoadConfigurationButton" Content="加载配置" Margin="2" Padding="10,3" />
                            <Button x:Name="PART_PrintButton" Content="打印" Margin="2" Padding="10,3" />
                        </WrapPanel>
                        <telerik:RadGridView x:Name="PART_DataGrid"
                                             Grid.Row="1"
                                             AutoGenerateColumns="False"
                                             IsReadOnly="True"
                                             SelectionMode="Extended"
                                             ShowGroupPanel="False"
                                             CanUserInsertRows="False"
                                             CanUserDeleteRows="False"
                                             RowIndicatorVisibility="Collapsed" />
                        <StackPanel x:Name="PART_PagerPanel"
                                    Grid.Row="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Margin="4">
                            <Button x:Name="PART_PreviousPageButton" Content="上一页" Padding="8,2" />
                            <TextBlock x:Name="PART_PageText" VerticalAlignment="Center" Margin="8,0" />
                            <Button x:Name="PART_NextPageButton" Content="下一页" Padding="8,2" />
                        </StackPanel>
                        <TextBlock x:Name="PART_StatusText"
                                   Grid.Row="3"
                                   Margin="4"
                                   Text="正在等待历史数据查询"
                                   TextWrapping="Wrap" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
