<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:localize="clr-namespace:HMI.Common.Presentation.Localization;assembly=HMI.Common.Presentation"
                    xmlns:Browsers="clr-namespace:HMI.Common.Browsers.Views">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/HMI.Common.Browsers;component/Themes/Common.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <Style x:Key="{x:Type Browsers:GenericBrowserStatusBarView}" TargetType="{x:Type Browsers:GenericBrowserStatusBarView}">
        <Setter Property="FrameworkElement.MinHeight" Value="28" />
        <Setter Property="FrameworkElement.Margin" Value="5,0,5,0" />
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Browsers:GenericBrowserStatusBarView}">
                    <StatusBar>
                        <StatusBarItem>
                            <TextBlock Text="{localize:Resx Key=SelectedItem, ResxName=HMI.Common.Browsers.Resources.BrowserTexts}" />
                        </StatusBarItem>
                        <StatusBarItem>
                            <TextBlock Style="{StaticResource StatusBarText}" Text="{Binding SelectedValue, FallbackValue={localize:Resx Key=NoItemSelected, ResxName=HMI.Common.Browsers.Resources.BrowserTexts}, TargetNullValue={localize:Resx Key=NoItemSelected, ResxName=HMI.Common.Browsers.Resources.BrowserTexts}}" />
                        </StatusBarItem>
                    </StatusBar>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>