<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rad="http://schemas.telerik.com/2008/xaml/presentation">
    
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <Style x:Key="StatusBarText" TargetType="{x:Type TextBlock}">
        <Setter Property="TextBlock.FontWeight" Value="Bold" />
    </Style>
    <Style x:Key="BrowserGridStyle" TargetType="{x:Type rad:RadGridView}">
        <Setter Property="rad:GridViewDataControl.AutoGenerateColumns" Value="False" />
        <Setter Property="rad:GridViewDataControl.CanUserDeleteRows" Value="False" />
        <Setter Property="rad:GridViewDataControl.CanUserInsertRows" Value="False" />
        <Setter Property="rad:GridViewDataControl.SelectionMode" Value="Single" />
        <Setter Property="rad:GridViewDataControl.RowIndicatorVisibility" Value="Collapsed" />
    </Style>
    <Style x:Key="BrowserGridColumnStyle" TargetType="{x:Type rad:GridViewDataColumn}">
        <Setter Property="rad:GridViewColumn.IsReadOnly" Value="True" />
    </Style>
    <Style x:Key="BrowserGridViewColumnStyle" TargetType="{x:Type rad:GridViewColumn}">
        <Setter Property="rad:GridViewColumn.IsReadOnly" Value="True" />
    </Style>
    <Style x:Key="BrowserGridCheckBoxColumnStyle" TargetType="{x:Type rad:GridViewCheckBoxColumn}">
        <Setter Property="rad:GridViewColumn.IsReadOnly" Value="True" />
    </Style>
    <Style x:Key="DialogButtonStyle" TargetType="{x:Type rad:RadButton}">
        <Setter Property="FrameworkElement.Margin" Value="5 0 5 0" />
        <Setter Property="FrameworkElement.MinWidth" Value="80" />
        <Setter Property="Control.Padding" Value="5 2 5 2" />
    </Style>
    <Style x:Key="BrowseButtonStyle" BasedOn="{StaticResource DialogButtonStyle}" TargetType="{x:Type rad:RadButton}">
        <Setter Property="FrameworkElement.Width" Value="170" />
        <Setter Property="FrameworkElement.Margin" Value="0 5 5 0" />
        <Setter Property="FrameworkElement.HorizontalAlignment" Value="Left" />
    </Style>
    <Style x:Key="DialogButtonPanelStyle" TargetType="{x:Type StackPanel}">
        <Setter Property="FrameworkElement.Margin" Value="5" />
    </Style>
    <Style x:Key="Icon16x16" TargetType="{x:Type Image}">
        <Setter Property="Image.Stretch" Value="Uniform" />
        <Setter Property="FrameworkElement.Width" Value="16" />
        <Setter Property="FrameworkElement.Height" Value="16" />
        <Setter Property="FrameworkElement.UseLayoutRounding" Value="True" />
        <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
        <Setter Property="RenderOptions.BitmapScalingMode" Value="NearestNeighbor" />
    </Style>
    <Style x:Key="BrowserTabHeaderStyle" TargetType="{x:Type rad:RadTabItem}">
        <Setter Property="HeaderedContentControl.Header" Value="{Binding Title}" />
        <Setter Property="UIElement.Visibility" Value="{Binding IsVisible, FallbackValue=Visible, TargetNullValue=Visible, Converter={StaticResource BooleanToVisibilityConverter}}" />
    </Style>
</ResourceDictionary>