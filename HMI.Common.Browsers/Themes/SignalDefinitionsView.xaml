<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rad="http://schemas.telerik.com/2008/xaml/presentation"
                    xmlns:ViewModels="clr-namespace:HMI.Common.Browsers.ViewModels"
                    xmlns:Views="clr-namespace:HMI.Common.Browsers.Views"
                    xmlns:ssfc="clr-namespace:HMI.Common.Browsers.Converters" 
                    xmlns:localize="clr-namespace:HMI.Common.Presentation.Localization;assembly=HMI.Common.Presentation"
                    xmlns:ntvc="clr-namespace:HMI.Common.Presentation.Converters;assembly=HMI.Common.Presentation"
                    >
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/HMI.Common.Browsers;component/Themes/Common.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <Thickness x:Key="ItemMargin">3,0,0,0</Thickness>
    <HierarchicalDataTemplate x:Key="{DataTemplateKey {x:Type ViewModels:ServersViewModel}}" DataType="{x:Type ViewModels:ServersViewModel}" ItemsSource="{Binding}">
        <StackPanel Orientation="Horizontal" ToolTip="{Binding Description}">
            <Image Source="/HMI.Common.Resources;component/Resources/16x16/Servers.png" Style="{StaticResource Icon16x16}" />
            <TextBlock Margin="{StaticResource ItemMargin}" Text="{Binding Name}" />
        </StackPanel>
    </HierarchicalDataTemplate>
    <HierarchicalDataTemplate x:Key="{DataTemplateKey {x:Type ViewModels:ServerViewModel}}" DataType="{x:Type ViewModels:ServerViewModel}" ItemsSource="{Binding}">
        <StackPanel Orientation="Horizontal" ToolTip="{Binding Description}">
            <Image Source="/HMI.Common.Resources;component/Resources/16x16/Server.png" Style="{StaticResource Icon16x16}" />
            <TextBlock Margin="{StaticResource ItemMargin}" Text="{Binding Name}" />
        </StackPanel>
    </HierarchicalDataTemplate>
    <HierarchicalDataTemplate x:Key="{DataTemplateKey {x:Type ViewModels:ConnectorViewModel}}" DataType="{x:Type ViewModels:ConnectorViewModel}" ItemsSource="{Binding}">
        <StackPanel Orientation="Horizontal" ToolTip="{Binding Description}">
            <Image Source="/HMI.Common.Resources;component/Resources/16x16/Connector.png" Style="{StaticResource Icon16x16}" />
            <TextBlock Margin="{StaticResource ItemMargin}" Text="{Binding Description}" />
        </StackPanel>
    </HierarchicalDataTemplate>
    <DataTemplate x:Key="{DataTemplateKey {x:Type ViewModels:SignalGroupViewModel}}" DataType="{x:Type ViewModels:SignalGroupViewModel}">
        <StackPanel Orientation="Horizontal" ToolTip="{Binding Description}">
            <Image Source="/HMI.Common.Resources;component/Resources/16x16/Group.png" Style="{StaticResource Icon16x16}" />
            <TextBlock Margin="{StaticResource ItemMargin}" Text="{Binding Name}" />
        </StackPanel>
    </DataTemplate>
    <ssfc:SignalStateForegroundConverter x:Key="SignalStateForegroundConverter" />
    <rad:InvertedBooleanToVisibilityConverter x:Key="InvertedBoolVisibilityConverter" />
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <ntvc:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
    <Style x:Key="{x:Type Views:SignalDefinitionsView}" TargetType="{x:Type Views:SignalDefinitionsView}">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Views:SignalDefinitionsView}">
                    <rad:RadBusyIndicator Name="uxBusyIndicator">
                        <Grid Margin="7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" MinWidth="200" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{localize:Resx ResxName=HMI.Common.Browsers.Resources.BrowserTexts, Key=FilterSignals}" />
                                <rad:RadTreeView Name="uxTreeFilter" Grid.Row="1" IsExpandOnDblClickEnabled="True" ItemsSource="{Binding Servers}" SelectedItem="{Binding SelectedFilter, Mode=TwoWay}">
                                    <rad:RadTreeView.ItemContainerStyle>
                                        <Style TargetType="{x:Type rad:RadTreeViewItem}">
                                            <Setter Property="rad:RadTreeViewItem.IsExpanded" Value="True" />
                                        </Style>
                                    </rad:RadTreeView.ItemContainerStyle>
                                </rad:RadTreeView>
                                <CheckBox Grid.Row="2" Content="{localize:Resx ResxName=HMI.Common.Browsers.Resources.BrowserTexts, Key=ShowInactiveSignals}" IsChecked="{Binding ShowInactiveSignals, Mode=TwoWay}" />
                                <!--<CheckBox Grid.Row="3" Content="{localize:Resx ResxName=HMI.Common.Browsers.Resources.BrowserTexts, Key=ShowOnlySignalsWithLogs}" IsChecked="{Binding ShowLogs, Mode=TwoWay}" />
                                <CheckBox Grid.Row="4" Content="{localize:Resx ResxName=HMI.Common.Browsers.Resources.BrowserTexts, Key=ShowInactiveLogs}" IsChecked="{Binding ShowInactiveLogs, Mode=TwoWay}" IsEnabled="{Binding ShowLogs}" />-->
                            </Grid>
                            <GridSplitter Grid.Column="1" Width="7" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#00FFFFFF" ResizeDirection="Columns" />
                            <Grid />
                            <rad:RadGridView Name="uxSignals" Grid.Column="2" CanUserFreezeColumns="False" FrozenColumnCount="5" RowIndicatorVisibility="Collapsed" Style="{StaticResource BrowserGridStyle}" ItemsSource="{Binding FilteredValues.View}" SelectedItem="{Binding SelectedItem}">
                                <rad:RadGridView.RowStyle>
                                    <Style TargetType="{x:Type rad:GridViewRow}">
                                        <Setter Property="Control.Foreground" Value="{Binding Converter={StaticResource SignalStateForegroundConverter}}" />
                                    </Style>
                                </rad:RadGridView.RowStyle>
                                <rad:RadGridView.Columns>
                                    <rad:GridViewDataColumn Style="{StaticResource BrowserGridColumnStyle}" DataMemberBinding="{Binding Server}" Header="{localize:Resx ResxName=HMI.Common.Browsers.Resources.BrowserTexts, Key=ServerColumnHeader}" IsVisible="{Binding DataContext.IsServerColumnVisible, RelativeSource={RelativeSource TemplatedParent}}" />
                                    <rad:GridViewDataColumn Style="{StaticResource BrowserGridColumnStyle}" DataMemberBinding="{Binding ConnectorDescription}" Header="{localize:Resx ResxName=HMI.Common.Browsers.Resources.BrowserTexts, Key=ConnectorColumnHeader}" IsVisible="{Binding DataContext.IsConnectorColumnVisible, RelativeSource={RelativeSource TemplatedParent}}" />
                                    <rad:GridViewDataColumn Style="{StaticResource BrowserGridColumnStyle}" DataMemberBinding="{Binding Group}" Header="{localize:Resx ResxName=HMI.Common.Browsers.Resources.BrowserTexts, Key=GroupColumnHeader}" IsVisible="{Binding DataContext.IsGroupColumnVisible, RelativeSource={RelativeSource TemplatedParent}}" />
                                    <rad:GridViewDataColumn Style="{StaticResource BrowserGridColumnStyle}" DataMemberBinding="{Binding AliasName}" Header="{localize:Resx ResxName=HMI.Common.Browsers.Resources.BrowserTexts, Key=AliasNameColumnHeader}" />
                                    <rad:GridViewDataColumn Style="{StaticResource BrowserGridColumnStyle}" DataMemberBinding="{Binding Name}" Header="{localize:Resx ResxName=HMI.Common.Browsers.Resources.BrowserTexts, Key=OPCItemNameColumnHeader}" />
                                    <rad:GridViewDataColumn Style="{StaticResource BrowserGridColumnStyle}" DataMemberBinding="{Binding Description}" Header="{localize:Resx ResxName=HMI.Common.Browsers.Resources.BrowserTexts, Key=DescriptionColumnHeader}" />
                                    <!--<rad:GridViewDataColumn Style="{StaticResource BrowserGridColumnStyle}" DataMemberBinding="{Binding LogTag}" Header="{localize:Resx ResxName=HMI.Common.Browsers.Resources.BrowserTexts, Key=LogTagColumnHeader}" IsVisible="{Binding ShowLogs}" />-->
                                    <rad:GridViewDataColumn Style="{StaticResource BrowserGridColumnStyle}" DataMemberBinding="{Binding Unit}" Header="{localize:Resx ResxName=HMI.Common.Browsers.Resources.BrowserTexts, Key=UnitColumnHeader}" />
                                    <rad:GridViewDataColumn Style="{StaticResource BrowserGridColumnStyle}" DataMemberBinding="{Binding Maximum}" Header="{localize:Resx ResxName=HMI.Common.Browsers.Resources.BrowserTexts, Key=MaximumColumnHeader}" />
                                    <rad:GridViewDataColumn Style="{StaticResource BrowserGridColumnStyle}" DataMemberBinding="{Binding Minimum}" Header="{localize:Resx ResxName=HMI.Common.Browsers.Resources.BrowserTexts, Key=MinimumColumnHeader}" />
                                    <rad:GridViewDataColumn Style="{StaticResource BrowserGridColumnStyle}" DataMemberBinding="{Binding FactorX1}" Header="{localize:Resx ResxName=HMI.Common.Browsers.Resources.BrowserTexts, Key=FactorX1ColumnHeader}" />
                                    <rad:GridViewDataColumn Style="{StaticResource BrowserGridColumnStyle}" DataMemberBinding="{Binding FactorX2}" Header="{localize:Resx ResxName=HMI.Common.Browsers.Resources.BrowserTexts, Key=FactorX2ColumnHeader}" />
                                    <rad:GridViewDataColumn Style="{StaticResource BrowserGridColumnStyle}" DataMemberBinding="{Binding FactorY1}" Header="{localize:Resx ResxName=HMI.Common.Browsers.Resources.BrowserTexts, Key=FactorY1ColumnHeader}" />
                                    <rad:GridViewDataColumn Style="{StaticResource BrowserGridColumnStyle}" DataMemberBinding="{Binding FactorY2}" Header="{localize:Resx ResxName=HMI.Common.Browsers.Resources.BrowserTexts, Key=FactorY2ColumnHeader}" />
                                    <rad:GridViewDataColumn Style="{StaticResource BrowserGridColumnStyle}" DataMemberBinding="{Binding WriteGroup}" Header="{localize:Resx ResxName=HMI.Common.Browsers.Resources.BrowserTexts, Key=WriteGroupColumnHeader}" />
                                    <rad:GridViewColumn Style="{StaticResource BrowserGridViewColumnStyle}" Header="{localize:Resx ResxName=HMI.Common.Browsers.Resources.BrowserTexts, Key=IsOpcEnabledColumnHeader}">
                                        <rad:GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsEnabled="False" IsChecked="{Binding IsOpcEnabled}" />
                                            </DataTemplate>
                                        </rad:GridViewColumn.CellTemplate>
                                    </rad:GridViewColumn>
                                </rad:RadGridView.Columns>
                            </rad:RadGridView>
                        </Grid>
                    </rad:RadBusyIndicator>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>