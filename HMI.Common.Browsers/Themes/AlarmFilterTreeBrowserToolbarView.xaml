<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rad="http://schemas.telerik.com/2008/xaml/presentation"
                    xmlns:Views="clr-namespace:HMI.Common.Browsers.Views"
                    xmlns:localize="clr-namespace:HMI.Common.Presentation.Localization;assembly=HMI.Common.Presentation"
                    xmlns:b="clr-namespace:System;assembly=mscorlib">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/HMI.Common.Browsers;component/Themes/Common.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <BooleanToVisibilityConverter x:Key="BoolVisibilityConverter" />
    <b:Boolean x:Key="BoolTrue">true</b:Boolean>
    <Style x:Key="{x:Type Views:AlarmFilterTreeBrowserToolbarView}" TargetType="{x:Type Views:AlarmFilterTreeBrowserToolbarView}">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Views:AlarmFilterTreeBrowserToolbarView}">
                    <StackPanel Orientation="Horizontal" Style="{StaticResource DialogButtonPanelStyle}">
                        <rad:RadButton Name="uxSelectAll" Style="{StaticResource DialogButtonStyle}" Command="{Binding SelectAllCommand}" Content="{localize:Resx ResxName=HMI.Common.Browsers.Resources.BrowserTexts, Key=SelectAll}" />
                        <rad:RadButton Name="uxUnselectAll" Style="{StaticResource DialogButtonStyle}" Command="{Binding UnselectAllCommand}" Content="{localize:Resx ResxName=HMI.Common.Browsers.Resources.BrowserTexts, Key=UnselectAll}" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>