<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rad="http://schemas.telerik.com/2008/xaml/presentation"
                    xmlns:Views="clr-namespace:HMI.Common.Browsers.Views">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/HMI.Common.Browsers;component/Themes/Common.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <Style x:Key="TreeViewItemStyle" TargetType="{x:Type rad:RadTreeViewItem}">
        <Setter Property="Control.Padding" Value="3" />
        <Setter Property="Control.HorizontalContentAlignment" Value="Left" />
        <Setter Property="Control.VerticalContentAlignment" Value="Top" />
        <Setter Property="Control.BorderThickness" Value="1" />
        <Setter Property="FrameworkElement.Cursor" Value="Arrow" />
        <Setter Property="Control.IsTabStop" Value="True" />
        <Setter Property="FrameworkElement.Margin" Value="0 1 0 0" />
        <Setter Property="rad:RadTreeViewItem.IsExpanded" Value="True" />
    </Style>
    <HierarchicalDataTemplate x:Key="AlarmGroupTemplate" ItemsSource="{Binding Children}">
        <Grid>
            <CheckBox VerticalAlignment="Center" IsChecked="{Binding IsSelected, Mode=TwoWay}">
                <TextBlock Margin="3,-2,0,0" VerticalAlignment="Center" Text="{Binding TranslatedShortName}" />
            </CheckBox>
        </Grid>
    </HierarchicalDataTemplate>
    <Style x:Key="{x:Type Views:AlarmGroupTreeView}" TargetType="{x:Type Views:AlarmGroupTreeView}">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Views:AlarmGroupTreeView}">
                    <rad:RadBusyIndicator Name="uxBusyIndicator">
                        <rad:RadTreeView Name="uxAlarmGroupsTree" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ItemContainerStyle="{StaticResource TreeViewItemStyle}" ItemTemplate="{StaticResource AlarmGroupTemplate}" ItemsSource="{Binding AlarmGroupItems}" />
                    </rad:RadBusyIndicator>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>