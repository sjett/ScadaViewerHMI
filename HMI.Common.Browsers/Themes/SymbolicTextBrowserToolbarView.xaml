<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rad="http://schemas.telerik.com/2008/xaml/presentation"
                    xmlns:Views="clr-namespace:HMI.Common.Browsers.Views"
                    xmlns:localize="clr-namespace:HMI.Common.Presentation.Localization;assembly=HMI.Common.Presentation"
                    xmlns:b="clr-namespace:System;assembly=mscorlib">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/HMI.Common.Browsers;component/Themes/Common.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <BooleanToVisibilityConverter x:Key="BoolVisibilityConverter" />
    <b:Boolean x:Key="BoolTrue">true</b:Boolean>
    <Style x:Key="{x:Type Views:SymbolicTextBrowserToolbarView}" TargetType="{x:Type Views:SymbolicTextBrowserToolbarView}">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Views:SymbolicTextBrowserToolbarView}">
                    <StackPanel Orientation="Horizontal">
                        <rad:RadDropDownButton Margin="3,0,0,0" VerticalAlignment="Center" Content="{localize:Resx ResxName=HMI.Common.Browsers.Resources.BrowserTexts, Key=VisibleLanguages}">
                            <rad:RadDropDownButton.DropDownContent>
                                <ListBox ItemsSource="{Binding Languages}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsVisible, Mode=TwoWay}" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </rad:RadDropDownButton.DropDownContent>
                        </rad:RadDropDownButton>
                        <CheckBox Margin="3,0,0,0" VerticalAlignment="Center" Content="{localize:Resx ResxName=HMI.Common.Browsers.Resources.BrowserTexts, Key=SuppressInternallyUsedTexts}" IsChecked="{Binding SuppressInternallyUsedNames, Mode=TwoWay}" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>