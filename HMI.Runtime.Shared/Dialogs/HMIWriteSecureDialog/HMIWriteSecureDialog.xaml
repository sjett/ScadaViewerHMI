<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:HMI.Runtime.Shared"
    xmlns:keyboard="clr-namespace:HMI.Runtime.Shared.KeyboardControl"
    xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation">

    <Style TargetType="local:HMIWriteSecureDialogContent">       
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:HMIWriteSecureDialogContent">
                    <Grid x:Name="BoxesGridElement" Margin="10,10,10,10" Grid.Row="1" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="UserPasswordTextBlockElement" Grid.Column="0" Grid.Row="0" Text="User Password:" VerticalAlignment="Center" Margin="0,5,0,0"/>
                        <PasswordBox 
                                                    x:Name="UserPasswordPasswordBoxElement" 
                                                    keyboard:KeyboardService.VirtualKeyboardType="Alphanumeric"
                                                    Grid.Column="1" Grid.Row="0" Margin="2,5,0,0" Width="150" />
                        <!--<PasswordBox 
                                                    x:Name="UserPasswordPasswordBoxElement" 
                                                    Grid.Column="1" Grid.Row="0" Margin="2,5,0,0" Width="150" />-->
                        <StackPanel x:Name="ButtonsPanelElement" Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,20,0,0" HorizontalAlignment="Center">
                            <Button x:Name="OKButtonElement" Content="OK" Width="80"/>
                            <Button x:Name="CancelButtonElement" Content="Cancel" Width="80" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>   
</ResourceDictionary>
