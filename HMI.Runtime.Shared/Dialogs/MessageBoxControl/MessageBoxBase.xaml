<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="clr-namespace:HMI.Runtime.Shared.Common.Converters"
                    xmlns:local="clr-namespace:HMI.Runtime.Shared"
                    xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
                    xmlns:Telerik_Windows_Controls_Animation="clr-namespace:Telerik.Windows.Controls.Animation;assembly=Telerik.Windows.Controls"
                    xmlns:Telerik_Windows_Controls_Chromes="clr-namespace:Telerik.Windows.Controls.Chromes;assembly=Telerik.Windows.Controls">

    <converters:MessageBoxImageSelector x:Key="MessageBoxImageSelector">
        <converters:MessageBoxImageMappings>
            <converters:MessageBoxImageMap Image="/HMI.Runtime.Shared;component/Dialogs/MessageBoxControl/Info_48x48_72.png" MessageBoxType="Information" />
            <converters:MessageBoxImageMap Image="/HMI.Runtime.Shared;component/Dialogs/MessageBoxControl/Warning_48x48_72.png" MessageBoxType="Warning" />
            <converters:MessageBoxImageMap Image="/HMI.Runtime.Shared;component/Dialogs/MessageBoxControl/Error_48x48_72.png" MessageBoxType="Error" />
            <converters:MessageBoxImageMap Image="/HMI.Runtime.Shared;component/Dialogs/MessageBoxControl/HighPriority_48x48_72.png" MessageBoxType="HighPriority" />
            <converters:MessageBoxImageMap Image="/HMI.Runtime.Shared;component/Dialogs/MessageBoxControl/PendingRequest_48x48_72.png" MessageBoxType="PendingRequest" />
            <converters:MessageBoxImageMap Image="/HMI.Runtime.Shared;component/Dialogs/MessageBoxControl/QuestionMarkBlue_48x48_72.png" MessageBoxType="QuestionMarkBlue" />
            <converters:MessageBoxImageMap Image="/HMI.Runtime.Shared;component/Dialogs/MessageBoxControl/QuestionMarkRed_48x48_72.png" MessageBoxType="QuestionMarkRed" />
            <converters:MessageBoxImageMap Image="/HMI.Runtime.Shared;component/Dialogs/MessageBoxControl/Help_48x48_72.png" MessageBoxType="Help" />
            <converters:MessageBoxImageMap Image="/HMI.Runtime.Shared;component/Dialogs/MessageBoxControl/Valid_48x48_72.png" MessageBoxType="Valid" />
            <converters:MessageBoxImageMap Image="/HMI.Runtime.Shared;component/Dialogs/MessageBoxControl/Invalid_48x48_72.png" MessageBoxType="Invalid" />
        </converters:MessageBoxImageMappings>
    </converters:MessageBoxImageSelector>

    <SolidColorBrush x:Key="WindowBackground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="WindowOuterBorder" Color="#FF848484" />
    <SolidColorBrush x:Key="WindowBorderBackground" Color="#FFEAEAEA" />
    <LinearGradientBrush x:Key="WindowModalBackground" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#E5000000" />
        <GradientStop Offset="0.5" Color="#4C000000" />
        <GradientStop Offset="1" Color="#E5000000" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="WindowInnerBorder" Color="#FFFFFFFF" />
    <LinearGradientBrush x:Key="WindowHeaderBackground" StartPoint="0 0" EndPoint="0 1">
        <GradientStop Offset="0" Color="#FFFFFFFF" />
        <GradientStop Offset="0.5" Color="#FFD5D5D5" />
        <GradientStop Offset="0.5" Color="#FFA1A1A1" />
        <GradientStop Offset="1" Color="#FFEAEAEA" />
    </LinearGradientBrush>
    <Style x:Key="WindowResizeThumbStyle" TargetType="Thumb">
        <Setter Property="MinWidth" Value="5" />
        <Setter Property="MinHeight" Value="5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Rectangle Fill="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <LinearGradientBrush x:Key="WindowButtonIconFill" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#FF282828" />
        <GradientStop Offset="1" Color="#FF7C7C7C" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="WindowButtonIconStroke" Color="#FFFFFFFF" />
    <Thickness x:Key="WindowButtonPadding">4</Thickness>
    <Thickness x:Key="WindowButtonMargin">1 1 0 1</Thickness>
    <CornerRadius x:Key="SplitButton_SpanCornerRadius">1</CornerRadius>
    <telerik:Office_BlackTheme x:Key="Theme" />
    <Style x:Key="WindowButtonStyle" TargetType="telerik:RadButton">
        <Setter Property="Padding" Value="{StaticResource WindowButtonPadding}" />
        <Setter Property="Margin" Value="{StaticResource WindowButtonMargin}" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="telerik:RadButton">
                    <Grid>
                        <Telerik_Windows_Controls_Chromes:ButtonChrome CornerRadius="{StaticResource SplitButton_SpanCornerRadius}"
                                                                       RenderMouseOver="{TemplateBinding IsMouseOver}"
                                                                       RenderNormal="False"
                                                                       RenderPressed="{TemplateBinding IsPressed}"
                                                                       telerik:StyleManager.Theme="{StaticResource Theme}" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <ControlTemplate x:Key="MessageBoxTemplate" TargetType="local:MessageBoxBase">
        <Grid x:Name="LayoutRoot">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled" />
                </VisualStateGroup>
                <VisualStateGroup x:Name="FocusStates">
                    <VisualState x:Name="Focused" />
                    <VisualState x:Name="Unfocused" />
                </VisualStateGroup>
                <VisualStateGroup x:Name="DragStates">
                    <VisualState x:Name="NotDragging" />
                    <VisualState x:Name="Dragging" />
                    <VisualState x:Name="Resizing" />
                </VisualStateGroup>
                <VisualStateGroup x:Name="WindowStates">
                    <VisualState x:Name="NormalWindow" />
                    <VisualState x:Name="Maximized">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="WindowOuterBorder" Storyboard.TargetProperty="CornerRadius">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="0" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="WindowInnerBorder" Storyboard.TargetProperty="CornerRadius">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="0" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="WindowOuterBorder" Storyboard.TargetProperty="BorderThickness">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="0" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="WindowInnerBorder" Storyboard.TargetProperty="BorderThickness">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="0" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentInnerBorder" Storyboard.TargetProperty="BorderThickness">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="0 1 0 0" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentOuterBorder" Storyboard.TargetProperty="BorderThickness">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="0 1 0 0" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentOuterBorder" Storyboard.TargetProperty="Margin">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="0" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HeaderButtons" Storyboard.TargetProperty="Margin">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="0" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Shadow" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="Collapsed" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Minimized">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentOuterBorder" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="Collapsed" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HeaderButtons" Storyboard.TargetProperty="Margin">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="0" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border x:Name="Shadow"
                    Margin="-3 -3 -5 -5"
                    BorderBrush="#11000000"
                    BorderThickness="1"
                    CornerRadius="10">
                <Border BorderBrush="#22000000"
                        BorderThickness="1"
                        CornerRadius="9">
                    <Border BorderBrush="#33000000"
                            BorderThickness="1"
                            CornerRadius="8">
                        <Border BorderBrush="#44000000"
                                BorderThickness="1"
                                CornerRadius="7">
                            <Border BorderBrush="#55000000"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <Border BorderBrush="#66000000"
                                        BorderThickness="1"
                                        CornerRadius="5">
                                    <Border BorderBrush="#77000000"
                                            BorderThickness="1"
                                            CornerRadius="4" />
                                </Border>
                            </Border>
                        </Border>
                    </Border>
                </Border>
            </Border>
            <Border x:Name="WindowOuterBorder"
                    Grid.RowSpan="2"
                    Background="{TemplateBinding BorderBackground}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="5">
                <Border x:Name="WindowInnerBorder"
                        BorderBrush="{StaticResource WindowInnerBorder}"
                        BorderThickness="1"
                        CornerRadius="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid x:Name="Header" Background="{StaticResource WindowHeaderBackground}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0"
                                        Margin="2 0 0 0"
                                        Orientation="Horizontal">
                                <ContentPresenter x:Name="IconContent"
                                                  Margin="2"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"
                                                  Content="{TemplateBinding Icon}"
                                                  ContentTemplate="{TemplateBinding IconTemplate}" />
                                <ContentPresenter x:Name="HeaderContent"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"
                                                  Content="{TemplateBinding Header}"
                                                  ContentTemplate="{TemplateBinding HeaderTemplate}" />
                            </StackPanel>
                            <Thumb x:Name="titleThumb"
                                   Grid.ColumnSpan="2"
                                   Style="{StaticResource WindowResizeThumbStyle}" />
                            <Border x:Name="PART_HeaderButtonsBorder" Grid.Column="1">
                                <StackPanel x:Name="HeaderButtons"
                                            Grid.Column="1"
                                            Margin="0 0 3 0"
                                            Orientation="Horizontal">
                                    <telerik:RadButton x:Name="PART_MinimizeButton"
                                                       Command="telerik:WindowCommands.Minimize"
                                                       Style="{StaticResource WindowButtonStyle}"
                                                       Visibility="Collapsed">
                                        <Path Width="14"
                                              Height="14"
                                              Data="M1.5,7.5 L12.5,7.5 12.5,11.5 1.5,11.5 Z"
                                              Fill="{StaticResource WindowButtonIconFill}"
                                              Stroke="{StaticResource WindowButtonIconStroke}" />
                                    </telerik:RadButton>
                                    <telerik:RadButton x:Name="PART_RestoreButton"
                                                       Command="telerik:WindowCommands.Restore"
                                                       Style="{StaticResource WindowButtonStyle}"
                                                       Visibility="Collapsed">
                                        <Path Width="14"
                                              Height="14"
                                              Data="M0.5,4.5 0.5,11.5 1.5,12.5 8.5,12.5 9.5,11.5 9.5,3.5 1.5,3.5 Z M3.5,6.5 L3.5,9.5 L6.5,9.5 6.5,6.5 Z M3.5,3.5 3.5,1.5 4.5,0.5 11.5,0.5 12.5,1.5 12.5,9.5 11.5,10.5 9.5,10.5 9.5,3.5 Z"
                                              Fill="{StaticResource WindowButtonIconFill}"
                                              Stroke="{StaticResource WindowButtonIconStroke}" />
                                    </telerik:RadButton>
                                    <telerik:RadButton x:Name="PART_MaximizeButton"
                                                       Command="telerik:WindowCommands.Maximize"
                                                       Style="{StaticResource WindowButtonStyle}"
                                                       Visibility="Collapsed">
                                        <Path Width="14"
                                              Height="14"
                                              Data="M1.5,2.5 L12.5,2.5 12.5,11.5 1.5,11.5 Z M4.5,5.5 L9.5,5.5 9.5,8.5 4.5,8.5 Z"
                                              Fill="{StaticResource WindowButtonIconFill}"
                                              Stroke="{StaticResource WindowButtonIconStroke}" />
                                    </telerik:RadButton>
                                    <telerik:RadButton x:Name="PART_CloseButton"
                                                       Command="telerik:WindowCommands.Close"
                                                       Style="{StaticResource WindowButtonStyle}">
                                        <Path Width="14"
                                              Height="14"
                                              Data="M1.5,3.5 L2.5,2.5 4.5,2.5 6.5,4.5 8.5,2.5 10.5,2.5 11.5,3.5 8.5,6.5 8.5,7.5 11.5,10.5 10.5,11.5 8.5,11.5 6.5,9.5 4.5,11.5 2.5,11.5 1.5,10.5 4.5,7.5 4.5,6.5 z"
                                              Fill="{StaticResource WindowButtonIconFill}"
                                              Stroke="{StaticResource WindowButtonIconStroke}" />
                                    </telerik:RadButton>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border x:Name="ContentOuterBorder"
                                Grid.Row="1"
                                Margin="{TemplateBinding BorderThickness}"
                                BorderBrush="{StaticResource WindowInnerBorder}"
                                BorderThickness="1">
                            <Border x:Name="ContentInnerBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Image Margin="5"
                                               Stretch="None"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center"
                                               Source="{Binding MessageBoxType,
                                                                RelativeSource={RelativeSource TemplatedParent},
                                                                Converter={StaticResource MessageBoxImageSelector}}" />
                                        <ContentPresenter Grid.Column="1"
                                                          Margin="{TemplateBinding Padding}"
                                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                          Content="{TemplateBinding Content}"
                                                          ContentTemplate="{TemplateBinding ContentTemplate}" />
                                    </Grid>
                                    <Grid Grid.Row="1" Margin="10,10,10,10">
                                        <StackPanel x:Name="ButtonsStackPanelElement"
                                                    HorizontalAlignment="Center"
                                                    Orientation="Horizontal" />
                                    </Grid>
                                </Grid>
                                <!--  <ContentPresenter x:Name="ContentElement" ContentTemplate="{TemplateBinding ContentTemplate}" Content="{TemplateBinding Content}" Margin="{TemplateBinding Padding}"/>  -->
                            </Border>
                        </Border>
                    </Grid>
                </Border>
            </Border>
            <Thumb x:Name="W"
                   HorizontalAlignment="Left"
                   Cursor="SizeWE"
                   Style="{StaticResource WindowResizeThumbStyle}" />
            <Thumb x:Name="N"
                   VerticalAlignment="Top"
                   Cursor="SizeNS"
                   Style="{StaticResource WindowResizeThumbStyle}" />
            <Thumb x:Name="E"
                   HorizontalAlignment="Right"
                   Cursor="SizeWE"
                   Style="{StaticResource WindowResizeThumbStyle}" />
            <Thumb x:Name="S"
                   VerticalAlignment="Bottom"
                   Cursor="SizeNS"
                   Style="{StaticResource WindowResizeThumbStyle}" />
            <Thumb x:Name="NW"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Cursor="SizeNWSE"
                   Style="{StaticResource WindowResizeThumbStyle}" />
            <Thumb x:Name="NE"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Top"
                   Cursor="SizeNESW"
                   Style="{StaticResource WindowResizeThumbStyle}" />
            <Thumb x:Name="SE"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Cursor="SizeNWSE"
                   Style="{StaticResource WindowResizeThumbStyle}" />
            <Thumb x:Name="SW"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Bottom"
                   Cursor="SizeNESW"
                   Style="{StaticResource WindowResizeThumbStyle}" />
        </Grid>
    </ControlTemplate>
    <Style x:Key="MessageBoxStyle" TargetType="local:MessageBoxBase">
        <Setter Property="IsTabStop" Value="false" />
        <Setter Property="Background" Value="{StaticResource WindowBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource WindowOuterBorder}" />
        <Setter Property="BorderBackground" Value="{StaticResource WindowBorderBackground}" />
        <Setter Property="ModalBackground" Value="{StaticResource WindowModalBackground}" />
        <Setter Property="BorderThickness" Value="2 0 2 2" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="MinWidth" Value="100" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Header" Value="RadWindow" />
        <Setter Property="WindowStartupLocation" Value="Manual" />
        <Setter Property="WindowState" Value="Normal" />
        <Setter Property="Padding" Value="10 10 10 10" />
        <Setter Property="Template" Value="{StaticResource MessageBoxTemplate}" />
        <!--<Setter Property="TabNavigation" Value="Cycle" />-->
        <Setter Property="Telerik_Windows_Controls_Animation:AnimationManager.AnimationSelector">
            <Setter.Value>
                <Telerik_Windows_Controls_Animation:AnimationSelector>
                    <Telerik_Windows_Controls_Animation:AnimationGroup AnimationName="Show">
                        <Telerik_Windows_Controls_Animation:FadeAnimation Direction="In" TargetElementName="LayoutRoot">
                            <Telerik_Windows_Controls_Animation:FadeAnimation.Easing>
                                <QuarticEase EasingMode="EaseOut" />
                            </Telerik_Windows_Controls_Animation:FadeAnimation.Easing>
                        </Telerik_Windows_Controls_Animation:FadeAnimation>
                        <Telerik_Windows_Controls_Animation:ScaleAnimation Direction="In"
                                                                           MinScale="0.9"
                                                                           TargetElementName="LayoutRoot">
                            <Telerik_Windows_Controls_Animation:ScaleAnimation.Easing>
                                <QuarticEase EasingMode="EaseOut" />
                            </Telerik_Windows_Controls_Animation:ScaleAnimation.Easing>
                        </Telerik_Windows_Controls_Animation:ScaleAnimation>
                    </Telerik_Windows_Controls_Animation:AnimationGroup>
                    <Telerik_Windows_Controls_Animation:AnimationGroup AnimationName="Hide">
                        <Telerik_Windows_Controls_Animation:FadeAnimation Direction="Out" TargetElementName="LayoutRoot">
                            <Telerik_Windows_Controls_Animation:FadeAnimation.Easing>
                                <QuarticEase EasingMode="EaseOut" />
                            </Telerik_Windows_Controls_Animation:FadeAnimation.Easing>
                        </Telerik_Windows_Controls_Animation:FadeAnimation>
                        <Telerik_Windows_Controls_Animation:ScaleAnimation Direction="Out"
                                                                           MinScale="0.9"
                                                                           TargetElementName="LayoutRoot">
                            <Telerik_Windows_Controls_Animation:ScaleAnimation.Easing>
                                <QuarticEase EasingMode="EaseIn" />
                            </Telerik_Windows_Controls_Animation:ScaleAnimation.Easing>
                        </Telerik_Windows_Controls_Animation:ScaleAnimation>
                    </Telerik_Windows_Controls_Animation:AnimationGroup>
                </Telerik_Windows_Controls_Animation:AnimationSelector>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
