<ResourceDictionary xmlns:local="clr-namespace:HMI.ProjectDesigner.DesignControls.Primitives" 
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../HMIStatesControlBase.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <Style x:Key="{x:Type local:HMIAnimatedRectangle1}" TargetType="{x:Type local:HMIAnimatedRectangle1}" BasedOn="{StaticResource HMIStatesControlBaseStyle}">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HMIAnimatedRectangle1}">
                    <Grid Name="LayoutRoot">
                        <Border Name="PrimitiveElement" BorderBrush="{TemplateBinding Control.Foreground}" Background="{TemplateBinding Control.Background}" BorderThickness="{Binding LineThickness, FallbackValue=1}" CornerRadius="{Binding CornerRadius}" />
                        <Border Name="uxFill" CornerRadius="{Binding CornerRadius}" BorderThickness="{Binding LineThickness, FallbackValue=1}" BorderBrush="{x:Null}" Background="{Binding AnimatedFill}">
                            <Border.OpacityMask>
                                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                    <GradientStop Color="#00000000" />
                                    <GradientStop Color="#00000000" Offset="0.5" />
                                    <GradientStop Color="#FF000000" Offset="0.5" />
                                    <GradientStop Color="#FF000000" Offset="1" />
                                </LinearGradientBrush>
                            </Border.OpacityMask>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>