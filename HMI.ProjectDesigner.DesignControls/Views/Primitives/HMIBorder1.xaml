<ResourceDictionary xmlns:local="clr-namespace:HMI.ProjectDesigner.DesignControls.Primitives" 
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../HMIStatesControlBase.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <Style x:Key="{x:Type local:HMIBorder1}" TargetType="{x:Type local:HMIBorder1}">
        <Setter Property="local:HMIBorder1.DesignerTemplateKey" Value="HMIBorder1Designer" />
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HMIBorder1}">
                    <Image Source="Images/Border.png" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="HMIBorder1Designer" BasedOn="{StaticResource HMIStatesControlBaseStyle}" TargetType="{x:Type local:HMIBorder1}">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HMIBorder1}">
                    <Grid Name="LayoutRoot" IsHitTestVisible="False">
                        <Border Background="{Binding Background}" BorderBrush="{Binding BorderBrush}" BorderThickness="{Binding BorderThickness}" CornerRadius="{Binding CornerRadius}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>