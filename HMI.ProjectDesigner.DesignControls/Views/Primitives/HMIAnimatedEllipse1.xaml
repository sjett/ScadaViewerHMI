<ResourceDictionary 
    xmlns:local="clr-namespace:HMI.ProjectDesigner.DesignControls.Primitives" 
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../HMIStatesControlBase.xaml" />
    </ResourceDictionary.MergedDictionaries>
    
    <Style x:Key="{x:Type local:HMIAnimatedEllipse1}" TargetType="{x:Type local:HMIAnimatedEllipse1}" BasedOn="{StaticResource HMIStatesControlBaseStyle}">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HMIAnimatedEllipse1}">
                    <Grid Name="LayoutRoot">
                        <Ellipse Name="PrimitiveElement" Stroke="{TemplateBinding Control.Foreground}" Fill="{TemplateBinding Control.Background}" StrokeThickness="{Binding LineThickness, FallbackValue=1}" />
                        <Ellipse Name="uxFill" Stroke="{TemplateBinding Control.Foreground}" StrokeThickness="{Binding LineThickness, FallbackValue=1}" Fill="{Binding AnimatedFill}">
                            <Ellipse.OpacityMask>
                                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                    <GradientStop Color="#00000000" />
                                    <GradientStop Color="#00000000" Offset="0.5" />
                                    <GradientStop Color="#FF000000" Offset="0.5" />
                                    <GradientStop Color="#FF000000" Offset="1" />
                                </LinearGradientBrush>
                            </Ellipse.OpacityMask>
                        </Ellipse>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>