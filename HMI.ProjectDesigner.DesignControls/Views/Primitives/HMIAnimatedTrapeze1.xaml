<ResourceDictionary xmlns:local="clr-namespace:HMI.ProjectDesigner.DesignControls.Primitives" 
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../HMIStatesControlBase.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <Style x:Key="{x:Type local:HMIAnimatedTrapeze1}" TargetType="{x:Type local:HMIAnimatedTrapeze1}" BasedOn="{StaticResource HMIStatesControlBaseStyle}">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HMIAnimatedTrapeze1}">
                    <Grid Name="LayoutRoot">
                        <Path Name="PrimitiveElement" Data="M1,0L2,0 3,2 0,2z" Stretch="Fill" Stroke="{TemplateBinding Control.Foreground}" Fill="{TemplateBinding Control.Background}" StrokeThickness="{Binding LineThickness, FallbackValue=1}" />
                        <Path Name="uxFill" Data="M1,0L2,0 3,2 0,2z" Stretch="Fill" Stroke="{TemplateBinding Control.Foreground}" StrokeThickness="{Binding LineThickness, FallbackValue=1}" Fill="{Binding AnimatedFill}">
                            <Path.OpacityMask>
                                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                    <GradientStop Color="#00000000" />
                                    <GradientStop Color="#00000000" Offset="0.5" />
                                    <GradientStop Color="#FF000000" Offset="0.5" />
                                    <GradientStop Color="#FF000000" Offset="1" />
                                </LinearGradientBrush>
                            </Path.OpacityMask>
                        </Path>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>