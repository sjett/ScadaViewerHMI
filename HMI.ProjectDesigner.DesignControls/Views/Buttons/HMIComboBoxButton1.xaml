<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:gh="clr-namespace:HMI.Infrastructure.Converters;assembly=HMI.Infrastructure.Converters"
                    xmlns:local="clr-namespace:HMI.ProjectDesigner.DesignControls.Buttons">
    <gh:StringNullOrEmptyFallbackConverter x:Key="StringNullOrEmptyFallbackConverter" />
    <gh:TernarySelector x:Key="TernarySelector" />
    <Style x:Key="{x:Type local:HMIComboBoxButton1}" TargetType="{x:Type local:HMIComboBoxButton1}">
        <Setter Property="Control.Background">
            <Setter.Value>
                <MultiBinding Converter="{StaticResource TernarySelector}">
                    <Binding Path="UseLocalColors" />
                    <Binding FallbackValue="White" Path="Project.StateDefaultBackground" />
                    <Binding Path="Background" />
                </MultiBinding>
            </Setter.Value>
        </Setter>
        <Setter Property="Control.Foreground">
            <Setter.Value>
                <MultiBinding Converter="{StaticResource TernarySelector}">
                    <Binding Path="UseLocalColors" />
                    <Binding FallbackValue="Black" Path="Project.StateDefaultForeground" />
                    <Binding Path="Foreground" />
                </MultiBinding>
            </Setter.Value>
        </Setter>
        <Setter Property="UIElement.Opacity" Value="{Binding Path=Opacity}" />
        <Setter Property="Control.BorderBrush" Value="{Binding Path=BorderBrush}" />
        <Setter Property="Control.BorderThickness" Value="{Binding BorderThickness, FallbackValue=1}" />
        <Setter Property="Control.HorizontalContentAlignment" Value="Center" />
        <Setter Property="Control.VerticalContentAlignment" Value="Center" />
        <Setter Property="Control.FontFamily" Value="{Binding Path=FontFamily}" />
        <Setter Property="Control.FontSize" Value="{Binding Path=FontSize}" />
        <Setter Property="Control.FontStretch" Value="{Binding Path=FontStretch}" />
        <Setter Property="Control.FontStyle" Value="{Binding Path=FontStyle}" />
        <Setter Property="Control.FontWeight" Value="{Binding Path=FontWeight}" />
        <Setter Property="UIElement.Opacity" Value="{Binding Path=Opacity}" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HMIComboBoxButton1}">
                    <Border Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="2" OpacityMask="{Binding OpacityMask, RelativeSource={RelativeSource TemplatedParent}}" Visibility="{Binding Visibility, RelativeSource={RelativeSource TemplatedParent}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Name="OutputElement" TextBlock.Foreground="{TemplateBinding Control.Foreground}" Margin="10, 0, 0, 0" TextBlock.TextAlignment="Left" TextWrapping="Wrap" VerticalAlignment="Center" Text="{Binding StateSignalName}" />
                            <Path Grid.Column="1" Data="M6.0011334,0.28792897L8.5434256,0.29044148 7.3335457,1.9993466z" Margin="0,0,6,0" Height="6" Width="8" Fill="{TemplateBinding Control.Foreground}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" UseLayoutRounding="False" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>