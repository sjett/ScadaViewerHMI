<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:gh="clr-namespace:HMI.Infrastructure.Converters;assembly=HMI.Infrastructure.Converters"
                    xmlns:local="clr-namespace:HMI.ProjectDesigner.DesignControls.Buttons">
    <gh:StringNullOrEmptyFallbackConverter x:Key="StringNullOrEmptyFallbackConverter" />
    <gh:TernarySelector x:Key="TernarySelector" />
    <Style x:Key="{x:Type local:HMIToggleButton1}" TargetType="{x:Type local:HMIToggleButton1}">
        <Setter Property="Control.Background">
            <Setter.Value>
                <MultiBinding Converter="{StaticResource TernarySelector}">
                    <Binding Path="UseLocalColors" />
                    <Binding FallbackValue="White" Path="Project.StateDefaultBackground" />
                    <Binding Path="Background" />
                </MultiBinding>
            </Setter.Value>
        </Setter>
        <Setter Property="UIElement.Opacity" Value="{Binding Path=Opacity}" />
        <Setter Property="Control.Foreground">
            <Setter.Value>
                <MultiBinding Converter="{StaticResource TernarySelector}">
                    <Binding Path="UseLocalColors" />
                    <Binding FallbackValue="Black" Path="Project.StateDefaultForeground" />
                    <Binding Path="Foreground" />
                </MultiBinding>
            </Setter.Value>
        </Setter>
        <Setter Property="Control.BorderBrush">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Offset="0" Color="#FFA3AEB9" />
                    <GradientStop Offset="0.375" Color="#FF8399A9" />
                    <GradientStop Offset="0.375" Color="#FF718597" />
                    <GradientStop Offset="1" Color="#FF617584" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="Control.BorderThickness" Value="{Binding BorderThickness, FallbackValue=1}" />
        <Setter Property="Control.HorizontalContentAlignment" Value="Center" />
        <Setter Property="Control.VerticalContentAlignment" Value="Center" />
        <Setter Property="Control.FontFamily" Value="{Binding Path=FontFamily}" />
        <Setter Property="Control.FontSize" Value="{Binding Path=FontSize}" />
        <Setter Property="Control.FontStretch" Value="{Binding Path=FontStretch}" />
        <Setter Property="Control.FontStyle" Value="{Binding Path=FontStyle}" />
        <Setter Property="Control.FontWeight" Value="{Binding Path=FontWeight}" />
        <Setter Property="UIElement.Opacity" Value="{Binding Path=Opacity}" />
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HMIToggleButton1}">
                    <Grid Name="LayoutRoot" IsHitTestVisible="False">
                        <Border Name="Background" Background="#FFFFFFFF" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="3">
                            <Grid Margin="1" Background="{TemplateBinding Control.Background}">
                                <Border Name="BackgroundAnimation" Opacity="0" Background="#FF448DCA" />
                                <Rectangle Name="BackgroundGradient">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush EndPoint=".7,1" StartPoint=".7,0">
                                            <GradientStop Color="#FFFFFFFF" Offset="0" />
                                            <GradientStop Color="#F9FFFFFF" Offset="0.375" />
                                            <GradientStop Color="#E5FFFFFF" Offset="0.625" />
                                            <GradientStop Color="#C6FFFFFF" Offset="1" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                            </Grid>
                        </Border>
                        <ContentPresenter Name="contentPresenter" HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" Margin="{TemplateBinding Control.Padding}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" Content="{Binding SymbolicText, Converter={StaticResource StringNullOrEmptyFallbackConverter}, ConverterParameter=HMIToggleButton1}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>