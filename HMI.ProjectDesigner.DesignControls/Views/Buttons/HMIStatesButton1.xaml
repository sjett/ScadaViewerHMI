<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:gh="clr-namespace:HMI.Infrastructure.Converters;assembly=HMI.Infrastructure.Converters"
                    xmlns:local="clr-namespace:HMI.ProjectDesigner.DesignControls.Buttons">
    <gh:StringNullOrEmptyFallbackConverter x:Key="StringNullOrEmptyFallbackConverter" />
    <gh:ImageSourceToBitmapImageConverter x:Key="ImageSourceToBitmapImageConverter" />
    <gh:PercentageToOpacityConverter x:Key="PercentageToOpacityConverter" />
    <gh:TernarySelector x:Key="TernarySelector" />
    <LinearGradientBrush x:Key="HMIStatesButtonsBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,1">
        <LinearGradientBrush.GradientStops>
            <GradientStopCollection>
                <GradientStop Color="#FFE8E8E8" Offset="0.499" />
                <GradientStop Color="#FFD6D6D6" Offset="0.5" />
            </GradientStopCollection>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>
    <Style x:Key="WrappingStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="TextBlock.TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="{x:Type local:HMIStatesButton1}" TargetType="{x:Type local:HMIStatesButton1}">
        <Setter Property="Control.Background">
            <Setter.Value>
                <MultiBinding Converter="{StaticResource TernarySelector}">
                    <Binding Path="UseLocalColors" />
                    <Binding FallbackValue="{StaticResource HMIStatesButtonsBackgroundBrush}" Path="Null" />
                    <Binding Path="Background" />
                </MultiBinding>
            </Setter.Value>
        </Setter>
        <Setter Property="Control.Foreground">
            <Setter.Value>
                <MultiBinding Converter="{StaticResource TernarySelector}">
                    <Binding Path="UseLocalColors" />
                    <Binding FallbackValue="Black" Path="Project.StateDefaultForeground" />
                    <Binding Path="Foreground" />
                </MultiBinding>
            </Setter.Value>
        </Setter>
        <Setter Property="Control.FontFamily" Value="{Binding Path=FontFamily}" />
        <Setter Property="Control.FontSize" Value="{Binding Path=FontSize}" />
        <Setter Property="Control.FontStretch" Value="{Binding Path=FontStretch}" />
        <Setter Property="Control.FontStyle" Value="{Binding Path=FontStyle}" />
        <Setter Property="Control.FontWeight" Value="{Binding Path=FontWeight}" />
        <Setter Property="UIElement.Opacity" Value="{Binding Path=Opacity}" />
        <Setter Property="Control.Padding" Value="{Binding Path=Padding}" />
        <Setter Property="Control.HorizontalContentAlignment" Value="Center" />
        <Setter Property="Control.VerticalContentAlignment" Value="Center" />
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HMIStatesButton1}">
                    <Grid Name="LayoutRoot" IsHitTestVisible="False">
                        <Border Name="Background" Background="{TemplateBinding Control.Background}" BorderBrush="{Binding BorderBrush}" BorderThickness="{Binding BorderThickness}" CornerRadius="{Binding CornerRadius}">
                            <Grid Margin="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Name="BackgroundAnimation" Grid.RowSpan="3" Grid.ColumnSpan="3" Opacity="0" Background="{Binding MouseOverBrush}" CornerRadius="{Binding CornerRadius}" />
                                <Image Name="uxButtonImage" Margin="{Binding IconMargin}" MaxHeight="{Binding IconMaxSize}" MaxWidth="{Binding IconMaxSize}" Opacity="{Binding IconOpacity, Converter={StaticResource PercentageToOpacityConverter}, ConverterParameter=HMIStatesButton1}" Stretch="{Binding IconStretch}">
                                    <Image.Source>
                                        <MultiBinding Converter="{StaticResource ImageSourceToBitmapImageConverter}">
                                            <Binding Path="Project.ProjectImagesFolder" />
                                            <Binding Path="IconImage" />
                                        </MultiBinding>
                                    </Image.Source>
                                </Image>
                                <ContentPresenter Name="uxContentPresenter" Grid.Row="1" Grid.Column="1" Margin="{TemplateBinding Control.Padding}" HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" Content="{Binding SymbolicText, Converter={StaticResource StringNullOrEmptyFallbackConverter}, ConverterParameter=HMIStatesButton1}">
                                    <ContentPresenter.Resources>
                                        <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource WrappingStyle}" />
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                                <Border Name="ChromeBrushElement" Grid.RowSpan="3" Grid.ColumnSpan="3" Background="{Binding ChromeFrontBrush}" CornerRadius="{Binding CornerRadius}" />
                            </Grid>
                        </Border>
                        <Border Name="FocusVisualElement" BorderBrush="#FFE5E5E5" IsHitTestVisible="False" Opacity="0" BorderThickness="{Binding BorderThickness}" CornerRadius="{Binding CornerRadius}" />
                        <Border Name="DisabledVisualElement" Background="#FFFFFFFF" BorderBrush="#FFFFFFFF" Opacity="0" Visibility="Collapsed" BorderThickness="{Binding BorderThickness}" CornerRadius="{Binding CornerRadius}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>