<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:HMI.ProjectDesigner.DesignControls.Isa">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="HMIISABase.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <Style x:Key="{x:Type local:HMIISAFilter1}" TargetType="{x:Type local:HMIISAFilter1}" BasedOn="{StaticResource HMIISAStyle}">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HMIISAFilter1}">
                    <Grid Name="LayoutRoot" Margin="0,0,0,0">
                        <Viewbox>
                            <Canvas Width="80" Height="50">
                                <Rectangle Width="81" Height="51" Stretch="Fill" StrokeLineJoin="Round" Stroke="{TemplateBinding Control.Foreground}" Fill="{TemplateBinding Control.Background}" StrokeThickness="{Binding LineThickness, FallbackValue=1}" />
                                <Path Width="25.8125" Height="51" Canvas.Left="55.187" Stretch="Fill" StrokeLineJoin="Round" Stroke="{TemplateBinding Control.Foreground}" Data="F1M90,10L65.1875,34.75 90,60" UseLayoutRounding="False" StrokeThickness="{Binding LineThickness, FallbackValue=1}" />
                            </Canvas>
                        </Viewbox>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>