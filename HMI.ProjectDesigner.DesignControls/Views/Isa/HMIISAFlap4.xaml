<ResourceDictionary xmlns:local="clr-namespace:HMI.ProjectDesigner.DesignControls.Isa"
                    xmlns:gh="clr-namespace:HMI.Infrastructure.Converters;assembly=HMI.Infrastructure.Converters"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="HMIISABase.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <gh:TernarySelector x:Key="TernarySelector" />
    <Style x:Key="{x:Type local:HMIISAFlap4}" TargetType="{x:Type local:HMIISAFlap4}">
        <Setter Property="Control.Background">
            <Setter.Value>
                <MultiBinding Converter="{StaticResource TernarySelector}">
                    <Binding Path="UseLocalColors" />
                    <Binding Path="Project.StateDefaultBackground" FallbackValue="White" />
                    <Binding Path="Background" />
                </MultiBinding>
            </Setter.Value>
        </Setter>
        <Setter Property="Control.Foreground">
            <Setter.Value>
                <MultiBinding Converter="{StaticResource TernarySelector}">
                    <Binding Path="UseLocalColors" />
                    <Binding Path="Project.StateDefaultForeground" FallbackValue="Black" />
                    <Binding Path="Foreground" />
                </MultiBinding>
            </Setter.Value>
        </Setter>
        <Setter Property="UIElement.Opacity" Value="{Binding Opacity}" />
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HMIISAFlap4}">
                    <Grid>
                        <Path Name="uxLine" Data="M9,26L9,-0.013350627" StrokeStartLineCap="Round" Stretch="Fill" StrokeEndLineCap="Round" Stroke="{TemplateBinding Control.Foreground}" StrokeLineJoin="Round" UseLayoutRounding="False" Margin="0" RenderTransformOrigin="0.5,0.5" Width="{Binding LineThickness}" StrokeThickness="{Binding LineThickness}">
                            <Path.RenderTransform>
                                <RotateTransform Angle="{Binding OffsetAngle}" />
                            </Path.RenderTransform>
                        </Path>
                        <Viewbox>
                            <Grid Height="6" Width="6" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform ScaleX="0.5" ScaleY="0.5" />
                                </Grid.RenderTransform>
                                <Ellipse Fill="{TemplateBinding Control.Foreground}" StrokeThickness="0" Height="6" Width="6" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Viewbox>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>