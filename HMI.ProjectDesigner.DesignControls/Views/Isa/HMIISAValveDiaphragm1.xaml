<ResourceDictionary xmlns:local="clr-namespace:HMI.ProjectDesigner.DesignControls.Isa" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="HMIISABase.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <Style x:Key="{x:Type local:HMIISAValveDiaphragm1}" TargetType="{x:Type local:HMIISAValveDiaphragm1}" BasedOn="{StaticResource HMIISAStyle}">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HMIISAValveDiaphragm1}">
                    <Grid Name="LayoutRoot" IsHitTestVisible="False" Margin="0,0,0,0">
                        <Viewbox Margin="0,0,0,0">
                            <Path Fill="{TemplateBinding Control.Background}" Stretch="Fill" Stroke="{TemplateBinding Control.Foreground}" StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeStartLineCap="Round" Margin="-0.515,24.835,-0.5,24.165" Data="M0,80L-0.015154734,29.999849 100,29.999849 100,80 50,30z" StrokeThickness="{Binding LineThickness, FallbackValue=1}" />
                        </Viewbox>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>