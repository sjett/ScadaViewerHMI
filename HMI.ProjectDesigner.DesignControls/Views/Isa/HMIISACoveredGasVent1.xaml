<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:HMI.ProjectDesigner.DesignControls.Isa">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="HMIISABase.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <Style x:Key="{x:Type local:HMIISACoveredGasVent1}" TargetType="{x:Type local:HMIISACoveredGasVent1}" BasedOn="{StaticResource HMIISAStyle}">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HMIISACoveredGasVent1}">
                    <Grid Name="LayoutRoot" Margin="0,0,0,0">
                        <Viewbox>
                            <Grid>
                                <Path Name="Path" Canvas.Left="9.5" Canvas.Top="9.50001" Stretch="Fill" StrokeLineJoin="Round" Data="M10,40L50,10 90,40 M50,40L50,100" Stroke="{TemplateBinding Control.Foreground}" UseLayoutRounding="False" StrokeThickness="{Binding LineThickness, FallbackValue=1}" />
                            </Grid>
                        </Viewbox>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>