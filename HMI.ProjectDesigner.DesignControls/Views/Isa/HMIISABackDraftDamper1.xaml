<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:HMI.ProjectDesigner.DesignControls.Isa">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="HMIISABase.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <Style x:Key="{x:Type local:HMIISABackDraftDamper1}" TargetType="{x:Type local:HMIISABackDraftDamper1}" BasedOn="{StaticResource HMIISAStyle}">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HMIISABackDraftDamper1}">
                    <Grid Name="LayoutRoot" Margin="0,0,0,0">
                        <Viewbox>
                            <Grid>
                                <Rectangle Name="Rectangle" Canvas.Left="5.50801" Canvas.Top="34.1241" Stretch="Fill" StrokeLineJoin="Round" Stroke="{TemplateBinding Control.Foreground}" Margin="6,5,0,0" Fill="{TemplateBinding Control.Background}" StrokeThickness="{Binding LineThickness, FallbackValue=1}" />
                                <Path Name="Line" Canvas.Left="5.50801" Canvas.Top="34.1241" Stretch="Fill" StrokeLineJoin="Round" Stroke="{TemplateBinding Control.Foreground}" Data="F1M6.1709113,34.624516L88.015236,79.53743" Margin="6.578,4.634,0,0" UseLayoutRounding="False" StrokeThickness="{Binding LineThickness, FallbackValue=1}" />
                                <Ellipse Name="Ellipse" Width="14" Height="14" Canvas.Left="-0.500002" Canvas.Top="27.9826" Stretch="Fill" StrokeLineJoin="Round" Stroke="{TemplateBinding Control.Foreground}" Fill="{TemplateBinding Control.Foreground}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0" StrokeThickness="{Binding LineThickness, FallbackValue=1}" />
                            </Grid>
                        </Viewbox>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>