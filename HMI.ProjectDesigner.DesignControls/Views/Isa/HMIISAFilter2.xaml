<ResourceDictionary xmlns:local="clr-namespace:HMI.ProjectDesigner.DesignControls.Isa" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="HMIISABase.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <Style x:Key="{x:Type local:HMIISAFilter2}" TargetType="{x:Type local:HMIISAFilter2}" BasedOn="{StaticResource HMIISAStyle}">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HMIISAFilter2}">
                    <Grid Name="LayoutRoot" Margin="0,0,0,0">
                        <Viewbox>
                            <Canvas Width="50" Height="100">
                                <Rectangle Width="51" Height="101" Canvas.Top="-1" Stretch="Fill" StrokeLineJoin="Round" Stroke="{TemplateBinding Control.Foreground}" Fill="{TemplateBinding Control.Background}" StrokeThickness="{Binding LineThickness, FallbackValue=1}" />
                                <Path Width="21" Height="101" Canvas.Left="30" Canvas.Top="-1" Stretch="Fill" StrokeLineJoin="Round" Stroke="{TemplateBinding Control.Foreground}" Data="M40,7.62939E-06L60,50 40,100" UseLayoutRounding="False" StrokeThickness="{Binding LineThickness, FallbackValue=1}" />
                            </Canvas>
                        </Viewbox>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>