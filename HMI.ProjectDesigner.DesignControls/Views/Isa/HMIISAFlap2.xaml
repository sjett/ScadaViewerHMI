<ResourceDictionary xmlns:local="clr-namespace:HMI.ProjectDesigner.DesignControls.Isa" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="HMIISABase.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <Style x:Key="{x:Type local:HMIISAFlap2}" TargetType="{x:Type local:HMIISAFlap2}" BasedOn="{StaticResource HMIISAStyle}">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HMIISAFlap2}">
                    <Grid Name="LayoutRoot" Margin="0,0,0,0">
                        <Viewbox>
                            <Path Name="Path" Width="61" Height="41" Canvas.Left="19.5" Canvas.Top="29.5" Stretch="Fill" StrokeLineJoin="Round" Stroke="{TemplateBinding Control.Foreground}" Fill="{TemplateBinding Control.Background}" Data="F1M20,30L80,30 80,70 20,70 20,30z M20,70L80,30" StrokeThickness="{Binding LineThickness, FallbackValue=1}" />
                        </Viewbox>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>