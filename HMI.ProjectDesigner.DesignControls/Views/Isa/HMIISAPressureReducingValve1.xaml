<ResourceDictionary xmlns:local="clr-namespace:HMI.ProjectDesigner.DesignControls.Isa" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="HMIISABase.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <Style x:Key="{x:Type local:HMIISAPressureReducingValve1}" TargetType="{x:Type local:HMIISAPressureReducingValve1}" BasedOn="{StaticResource HMIISAStyle}">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HMIISAPressureReducingValve1}">
                    <Grid Name="LayoutRoot" Margin="0,0,0,0">
                        <Viewbox>
                            <Grid>
                                <Path Name="Path" Width="101" Height="61" Canvas.Left="-0.5" Canvas.Top="19.5" Stretch="Fill" StrokeLineJoin="Round" Stroke="{TemplateBinding Control.Foreground}" Data="F1M1.21266E-12,40L100,80 100,20 1.21266E-12,60 1.21266E-12,40z" UseLayoutRounding="False" Margin="0,-0.5,0,0.5" Fill="{TemplateBinding Control.Background}" StrokeThickness="{Binding LineThickness, FallbackValue=1}" />
                                <Ellipse Name="Ellipse" Width="16.0806" Height="16.0806" Canvas.Left="16.9611" Canvas.Top="42.1277" Stretch="Fill" StrokeLineJoin="Round" Stroke="{TemplateBinding Control.Foreground}" Fill="{TemplateBinding Control.Foreground}" Margin="17,22,0,23" HorizontalAlignment="Left" StrokeThickness="{Binding LineThickness, FallbackValue=1}" />
                            </Grid>
                        </Viewbox>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>