<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:gh="clr-namespace:HMI.Infrastructure.Converters;assembly=HMI.Infrastructure.Converters"
                    xmlns:local="clr-namespace:HMI.ProjectDesigner.DesignControls.Labels">
    <gh:StringNullOrEmptyFallbackConverter x:Key="StringNullOrEmptyFallbackConverter" />
    <gh:TernarySelector x:Key="TernarySelector" />
    <Style x:Key="{x:Type local:HMILabel1}" TargetType="{x:Type local:HMILabel1}">
        <Setter Property="Control.HorizontalContentAlignment" Value="{Binding HorizontalContentAlignment, FallbackValue=Stretch, TargetNullValue=Stretch}" />
        <Setter Property="Control.VerticalContentAlignment" Value="{Binding VerticalContentAlignment, FallbackValue=Center, TargetNullValue=Center}" />
        <Setter Property="Control.BorderThickness" Value="{Binding BorderThickness}" />
        <Setter Property="Control.BorderBrush" Value="{Binding BorderBrush}" />
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HMILabel1}">
                    <Grid Name="LayoutRoot" IsHitTestVisible="False" Opacity="{Binding Opacity}">
                        <Grid.Background>
                            <MultiBinding Converter="{StaticResource TernarySelector}">
                                <Binding Path="UseLocalColors" />
                                <Binding FallbackValue="LightGray" Path="Project.StateDefaultBackground" />
                                <Binding Path="Background" />
                            </MultiBinding>
                        </Grid.Background>
                        <Border BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}">
                            <TextBlock Name="OutputElement" HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" TextWrapping="Wrap" TextBlock.FontFamily="{Binding FontFamily}" TextBlock.FontSize="{Binding FontSize}" TextBlock.FontStretch="{Binding FontStretch}" TextBlock.FontStyle="{Binding FontStyle}" TextBlock.FontWeight="{Binding FontWeight}" Text="{Binding SymbolicText, Converter={StaticResource StringNullOrEmptyFallbackConverter}, ConverterParameter=HMILabel1}" TextBlock.TextAlignment="{Binding TextAlignment}">
                                <TextBlock.Foreground>
                                  <MultiBinding Converter="{StaticResource TernarySelector}">
                                    <Binding Path="UseLocalColors" />
                                    <Binding FallbackValue="Black" Path="Project.StateDefaultForeground" />
                                    <Binding Path="Foreground" />
                                  </MultiBinding>
                                </TextBlock.Foreground>
                            </TextBlock>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="UIElement.Opacity" Value="{Binding Path=Opacity}" />
    </Style>
</ResourceDictionary>