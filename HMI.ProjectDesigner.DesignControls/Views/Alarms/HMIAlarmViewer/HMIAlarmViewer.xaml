    <Style x:Key="{x:Type wfagt:HMIAlarmViewer}" TargetType="{x:Type wfagt:HMIAlarmViewer}">
        <Setter Property="UIElement.Opacity" Value="{Binding Opacity}" />
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type wfagt:HMIAlarmViewer}">
                    <Grid Name="uxLayoutRoot">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <wfagt:HMIAlarmGroupsTree x:Name="uxAlarmGroupsFilterTree" Grid.Row="0" Grid.Column="0" Visibility="{Binding ShowAlarmGroupsFilterTree, Converter={StaticResource booleanVisibilityConverter}}" />
                            <GridSplitter Name="uxGridSplitter1" Grid.Row="0" Grid.Column="1" Width="6" Margin="1,0,1,0" HorizontalAlignment="Center" VerticalAlignment="Stretch" />
                            <DataGrid Name="uxAlarmGrid" Grid.Row="0" Grid.Column="2" AutoGenerateColumns="False" CellStyle="{StaticResource wfAlarmViewerCellStyle}" GridLinesVisibility="Vertical" IsReadOnly="True" RowStyle="{StaticResource wfAlarmViewerRowStyle}" SelectionMode="Extended" VerticalGridLinesBrush="#FFF5F5F5" HeadersVisibility="{Binding ShowHeader, Converter={StaticResource BoolToColumnHeaderVisiblityConverter}}" HorizontalScrollBarVisibility="{Binding ShowScrollbars, Converter={StaticResource BoolToScrollbarVisibilityConverter}}" ItemsSource="{Binding Alarms}" VerticalScrollBarVisibility="{Binding ShowScrollbars, Converter={StaticResource BoolToScrollbarVisibilityConverter}}">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn CanUserReorder="True" CanUserSort="False" Header="PriorityColor" HeaderStyle="{StaticResource wfPriorityColorHeaderStyle}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn CanUserReorder="True" CanUserSort="True" Header="Active" HeaderStyle="{StaticResource wfDateOnHeaderStyle}" SortMemberPath="DateOn" Binding="{Binding DateOnString}" />
                                    <DataGridTextColumn CanUserReorder="True" CanUserSort="True" Header="SystemTime" HeaderStyle="{StaticResource wfSystemTimeHeaderStyle}" SortMemberPath="SystemTime" Binding="{Binding SystemTimeString}" />
                                    <DataGridTextColumn CanUserReorder="True" CanUserSort="True" Header="Gone" HeaderStyle="{StaticResource wfDateOffHeaderStyle}" Binding="{Binding DateOffString}" />
                                    <DataGridTextColumn CanUserReorder="True" CanUserSort="True" Header="Acknowledged" HeaderStyle="{StaticResource wfDateAcknowledgedHeaderStyle}" Binding="{Binding DateAcknowledgedString}" />
                                    <DataGridTemplateColumn CanUserReorder="True" CanUserSort="False" Header="AcknowledgedWithComment" HeaderStyle="{StaticResource wfAcknowledgedWithCommentHeaderStyle}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <TextBlock HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ToolTipService.ToolTip="{Binding AcknowledgeComment}" />
                                                    <Path Width="15" Height="7" Margin="2" HorizontalAlignment="Center" Data="M0.5,2.8249958L11.625,2.8249958 8.7657204,5.1369963 M8.7657204,0.5L11.625,2.812 0.5,2.812" Stretch="Fill" Stroke="#FF000000" StrokeDashCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeMiterLimit="10" StrokeStartLineCap="Round" StrokeThickness="1" UseLayoutRounding="False" Visibility="{Binding IsAcknowledgedWithComment, Converter={StaticResource booleanVisibilityConverter}}" />
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn CanUserReorder="True" CanUserSort="True" Header="Text" HeaderStyle="{StaticResource wfTextHeaderStyle}" Binding="{Binding Text}" />
                                    <DataGridTextColumn CanUserReorder="True" CanUserSort="True" Header="Group" HeaderStyle="{StaticResource wfGroupHeaderStyle}" Binding="{Binding Group}" />
                                    <DataGridTextColumn CanUserReorder="True" CanUserSort="True" Header="Type" HeaderStyle="{StaticResource wfTypeHeaderStyle}" Binding="{Binding Type}" />
                                    <DataGridTextColumn CanUserReorder="True" CanUserSort="True" Header="SignalName" HeaderStyle="{StaticResource wfSignalNameHeaderStyle}" Binding="{Binding AliasName}" />
                                    <DataGridTextColumn CanUserReorder="True" CanUserSort="True" Header="OpcItem" HeaderStyle="{StaticResource wfOpcItemHeaderStyle}" Binding="{Binding SignalName}" />
                                    <DataGridTextColumn CanUserReorder="True" CanUserSort="True" Header="Priority" HeaderStyle="{StaticResource wfPriorityHeaderStyle}" Binding="{Binding Priority}" />
                                    <DataGridTextColumn CanUserReorder="True" CanUserSort="True" Header="Name" HeaderStyle="{StaticResource wfNameHeaderStyle}" Binding="{Binding Name}" />
                                    <DataGridTemplateColumn CanUserReorder="True" CanUserSort="True" Header="HttpLink" HeaderStyle="{StaticResource wfHttpLinkHeaderStyle}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Margin="2" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource LinkButton}" Content="{Binding HttpLink}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn CanUserReorder="True" CanUserSort="True" Header="OccurrenceCount" HeaderStyle="{StaticResource wfOccurrenceCountHeaderStyle}" Binding="{Binding OccurrenceCount}" />
                                    <DataGridTextColumn CanUserReorder="True" CanUserSort="True" Header="Duration" HeaderStyle="{StaticResource wfDurationHeaderStyle}" Binding="{Binding Duration, StringFormat=d\.hh\:mm\:ss\.fff}" />
                                    <DataGridTextColumn CanUserReorder="True" CanUserSort="True" Header="StatusText" HeaderStyle="{StaticResource wfStatusHeaderStyle}" Binding="{Binding StatusText}" />
                                    <DataGridTemplateColumn CanUserReorder="True" CanUserSort="True" Header="HelpCause" HeaderStyle="{StaticResource wfHelpCauseHeaderStyle}" SortMemberPath="HelpCause">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <TextBlock Margin="4" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{Binding HelpCause}" Visibility="{Binding ShowMultilineTextValues, Converter={StaticResource booleanVisibilityConverter}}" />
                                                    <TextBlock Margin="4" HorizontalAlignment="Stretch" VerticalAlignment="Center" Text="{Binding StrippedHelpCause}" ToolTipService.ToolTip="{Binding HelpCause}" Visibility="{Binding ShowMultilineTextValues, Converter={StaticResource invertedBooleanVisibilityConverter}}" />
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
