                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:telerikControlsCharting="http://schemas.telerik.com/2008/xaml/presentation">
    <Style x:Key="BarSeriesItemLabelStyle_OfficeBlackTheme" TargetType="{x:Type telerikControlsCharting:SeriesItemLabel}">
