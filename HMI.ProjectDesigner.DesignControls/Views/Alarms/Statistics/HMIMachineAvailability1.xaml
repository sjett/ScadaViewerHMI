<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
                    xmlns:rc="clr-namespace:Telerik.Windows.Controls;assembly=Telerik.Windows.Controls.Charting"
                    xmlns:local="clr-namespace:HMI.ProjectDesigner.DesignControls.Alarms">
    <Style x:Key="{x:Type local:HMIMachineAvailability1}" TargetType="{x:Type local:HMIMachineAvailability1}">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HMIMachineAvailability1}">
                    <Grid Name="uxLayoutRoot" IsHitTestVisible="False">
                        <rc:RadChart Name="RadChartElement" />
                        <Button Name="SelectTimespanButtonElement" IsTabStop="False" Margin="0,0,5,5" Width="32" Height="32" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <Button.Content>
                                <Image Source="../Images/TimeRange.png" Stretch="Uniform" />
                            </Button.Content>
                        </Button>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="UIElement.Opacity" Value="{Binding Path=Opacity}" />
    </Style>
</ResourceDictionary>