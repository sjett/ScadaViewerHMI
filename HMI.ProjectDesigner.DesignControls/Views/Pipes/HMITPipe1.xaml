<ResourceDictionary xmlns:local="clr-namespace:HMI.ProjectDesigner.DesignControls.Pipes" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="{x:Type local:HMITPipe1}" TargetType="{x:Type local:HMITPipe1}">
        <Setter Property="local:HMITPipe1.DesignerTemplateKey" Value="HMITPipe1Designer" />
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HMITPipe1}">
                    <Image Source="Images/HMITPipe1.png" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="HMITPipe1Designer" TargetType="{x:Type local:HMITPipe1}">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HMITPipe1}">
                    <Grid Name="LayoutRoot" Height="Auto" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{x:Null}">
                        <Path Name="rectangle1" HorizontalAlignment="Center" VerticalAlignment="Top" Stretch="Fill" Data="M0,0L47,0 47,36 0,36z" UseLayoutRounding="False" Stroke="{x:Null}" Width="{Binding LineThickness}">
                            <Path.Fill>
                                <LinearGradientBrush EndPoint="0.1,0.5" StartPoint="0.9,0.5">
                                    <GradientStop Color="#FF4F4F4F" Offset="0.050" />
                                    <GradientStop Color="#FF727272" Offset="0" />
                                    <GradientStop Color="#FF4F4F4F" Offset="0.950" />
                                    <GradientStop Color="#FFFFFFFF" Offset="0.500" />
                                    <GradientStop Color="#FF727272" Offset="1" />
                                </LinearGradientBrush>
                            </Path.Fill>
                        </Path>
                        <Rectangle Name="HorizontalPipe" VerticalAlignment="Top" RadiusX="0" RadiusY="0" Width="Auto" Height="{Binding LineThickness}" Stroke="{x:Null}">
                            <Rectangle.Fill>
                                <LinearGradientBrush EndPoint="0.5,0.1" StartPoint="0.5,0.9">
                                    <GradientStop Color="#FF4F4F4F" Offset="0.05000000074505806" />
                                    <GradientStop Color="#FF727272" />
                                    <GradientStop Color="#FF4F4F4F" Offset="0.949999988079071" />
                                    <GradientStop Color="#FFFFFFFF" Offset="0.5" />
                                    <GradientStop Color="#FF727272" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Grid VerticalAlignment="Top" Margin="0,1,0,0" Height="{Binding LineThickness}">
                            <Path Name="TriangleSeparator" Stretch="Fill" Data="M0.87018244,-0.20520826L23.771176,-17.961696 23.683525,-33.498623 23.771176,-17.961696 46.672169,-0.22296474z" UseLayoutRounding="False" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0" Stroke="{x:Null}" Width="{Binding LineThickness}">
                                <Path.Fill>
                                    <LinearGradientBrush EndPoint="0.1,0.5" StartPoint="0.9,0.5">
                                        <GradientStop Color="#FF4F4F4F" Offset="0.050" />
                                        <GradientStop Color="#FF727272" Offset="0" />
                                        <GradientStop Color="#FF4F4F4F" Offset="0.950" />
                                        <GradientStop Color="#FFFFFFFF" Offset="0.500" />
                                        <GradientStop Color="#FF727272" Offset="1" />
                                    </LinearGradientBrush>
                                </Path.Fill>
                            </Path>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="UIElement.Opacity" Value="{Binding Path=Opacity}" />
    </Style>
</ResourceDictionary>