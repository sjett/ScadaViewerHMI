<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:HMI.ProjectDesigner.DesignControls.General">
    <Style x:Key="{x:Type local:HMIUserDisplay1}" TargetType="{x:Type local:HMIUserDisplay1}">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HMIUserDisplay1}">
                    <Grid Name="LayoutRoot" Background="{Binding Path=Background}">
                        <TextBlock Name="OutputElement" Text="HMIUserDisplay1" TextWrapping="NoWrap" TextBlock.Foreground="{Binding Path=Foreground}" HorizontalAlignment="{Binding Path=HorizontalContentAlignment}" VerticalAlignment="{Binding Path=VerticalContentAlignment}" TextBlock.FontFamily="{Binding Path=FontFamily}" TextBlock.FontSize="{Binding Path=FontSize}" TextBlock.FontStretch="{Binding Path=FontStretch}" TextBlock.FontStyle="{Binding Path=FontStyle}" TextBlock.FontWeight="{Binding Path=FontWeight}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="UIElement.Opacity" Value="{Binding Path=Opacity}" />
    </Style>
</ResourceDictionary>