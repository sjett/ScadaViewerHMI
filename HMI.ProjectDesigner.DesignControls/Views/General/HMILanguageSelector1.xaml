<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:HMI.ProjectDesigner.DesignControls.General">
    <Style x:Key="{x:Type local:HMILanguageSelector1}" TargetType="{x:Type local:HMILanguageSelector1}">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HMILanguageSelector1}">
                    <Grid IsHitTestVisible="False">
                        <ComboBox Text="HMILanguageSelector1" SelectedValue="{Binding Path=Value}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="UIElement.Opacity" Value="{Binding Path=Opacity}" />
    </Style>
</ResourceDictionary>