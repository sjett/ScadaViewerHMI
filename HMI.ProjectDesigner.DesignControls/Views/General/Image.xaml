<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:HMI.ProjectDesigner.DesignControls.General">
    <Style x:Key="{x:Type local:Image}" TargetType="{x:Type local:Image}">
        <Setter Property="local:Image.DesignerTemplateKey" Value="ImageDesigner" />
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:Image}">
                    <Image Source="Images/Image.png" Height="32" Width="32" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ImageDesigner" TargetType="{x:Type local:Image}">
        <Setter Property="local:Image.DesignerTemplateKey" Value="ImageDesigner" />
        <Setter Property="UIElement.Opacity" Value="{Binding Opacity}" />
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:Image}">
                    <Image IsHitTestVisible="False" Source="{Binding Image}" Stretch="{Binding Stretch}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>