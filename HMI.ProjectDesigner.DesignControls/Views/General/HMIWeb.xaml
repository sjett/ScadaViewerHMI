<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
                    xmlns:local="clr-namespace:HMI.ProjectDesigner.DesignControls.General">
    <Style x:Key="{x:Type local:HMIWeb}" TargetType="{x:Type local:HMIWeb}">
        <Setter Property="local:HMIWeb.DesignerTemplateKey" Value="HMIWebDesigner" />
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HMIWeb}">
                    <Image Source="Images/Image.png" Height="32" Width="32" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="HMIWebDesigner" TargetType="{x:Type local:HMIWeb}">
        <Setter Property="UIElement.Opacity" Value="{Binding Opacity}" />
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HMIWeb}">
                    <Grid>
                        <wv2:WebView2 Name="webView" Visibility="Visible" Source="{Binding Source}"  />
                        <!-- 设计时占位符 -->
                        <Border 
                                Visibility="Collapsed"
                                Background="#22CCCCCC"
                                BorderBrush="Gray"
                                BorderThickness="1">
                            <TextBlock Text="WebView2 Placeholder" 
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>