<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:HMI.ProjectDesigner.DesignControls.General">
    <SolidColorBrush x:Key="logbook_Background_Brush" Color="White" />
    <SolidColorBrush x:Key="logbook_Foreground_Brush" Color="#FF787878" />
    <SolidColorBrush x:Key="logbook_Scrollbar_Background_Brush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="logbook_Scrollbar_Foreground_Brush" Color="#FFAAAAAA" />
    <SolidColorBrush x:Key="logbook_Dialogs_Background_Brush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="logbook_Dialogs_Foreground_Brush" Color="#FF787878" />
    <LinearGradientBrush x:Key="logbook_Button_Background_Brush" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Offset="0.456" Color="#FFE0E0E0" />
        <GradientStop Offset="0.486" Color="#FFBEBEBE" />
        <GradientStop Offset="0.973" Color="#FFD8D8D8" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="logbook_Button_Foreground_Brush" Color="#FF3F3F3F" />
    <SolidColorBrush x:Key="logbook_Button_BorderBrush_Brush" Color="#FF939393" />
    <SolidColorBrush x:Key="logbook_Header_Background_Brush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="logbook_Sender_Background_Brush" Color="#FFD2E2EA" />
    <SolidColorBrush x:Key="logbook_Subject_Background_Brush" Color="#FFD8E8F0" />
    <SolidColorBrush x:Key="logbook_Body_Background_Brush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="logbook_Footer_Background_Brush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="logbook_ToolBar_Background_Brush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="logbook_Topic_Foreground_Brush" Color="#FF787878" />
    <SolidColorBrush x:Key="logbook_TimeFilter_Foreground_Brush" Color="#FF787878" />
    <SolidColorBrush x:Key="logbook_Sender_Foreground_Brush" Color="#FF676767" />
    <SolidColorBrush x:Key="logbook_TimeStamp_Foreground_Brush" Color="#FF676767" />
    <SolidColorBrush x:Key="logbook_Subject_Foreground_Brush" Color="#FF676788" />
    <SolidColorBrush x:Key="logbook_Body_Foreground_Brush" Color="#FF787878" />
    <SolidColorBrush x:Key="logbook_Footer_Foreground_Brush" Color="#FF787878" />
    <Style x:Key="logbook_Topic_TextBlock_Style" TargetType="{x:Type TextBlock}">
        <Setter Property="TextBlock.Foreground" Value="{StaticResource logbook_Topic_Foreground_Brush}" />
        <Setter Property="TextBlock.FontSize" Value="12" />
        <Setter Property="TextBlock.FontStyle" Value="Normal" />
    </Style>
    <Style x:Key="logbook_TimeFilter_TextBlock_Style" TargetType="{x:Type TextBlock}">
        <Setter Property="TextBlock.Foreground" Value="{StaticResource logbook_TimeFilter_Foreground_Brush}" />
        <Setter Property="TextBlock.FontSize" Value="12" />
        <Setter Property="TextBlock.FontStyle" Value="Normal" />
    </Style>
    <Style x:Key="logbook_Sender_TextBlock_Style" TargetType="{x:Type TextBlock}">
        <Setter Property="TextBlock.Foreground" Value="{StaticResource logbook_Sender_Foreground_Brush}" />
        <Setter Property="TextBlock.FontSize" Value="9" />
        <Setter Property="TextBlock.FontStyle" Value="Normal" />
        <Setter Property="TextBlock.FontWeight" Value="Bold" />
    </Style>
    <Style x:Key="logbook_TimeStamp_TextBlock_Style" TargetType="{x:Type TextBlock}">
        <Setter Property="TextBlock.Foreground" Value="{StaticResource logbook_TimeStamp_Foreground_Brush}" />
        <Setter Property="TextBlock.FontSize" Value="9" />
        <Setter Property="TextBlock.FontStyle" Value="Normal" />
    </Style>
    <Style x:Key="logbook_Subject_TextBlock_Style" TargetType="{x:Type TextBlock}">
        <Setter Property="TextBlock.Foreground" Value="{StaticResource logbook_Subject_Foreground_Brush}" />
        <Setter Property="TextBlock.FontSize" Value="12" />
        <Setter Property="TextBlock.FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="logbook_Button_Path_Style" TargetType="{x:Type Path}">
        <Setter Property="FrameworkElement.Width" Value="30" />
        <Setter Property="FrameworkElement.Height" Value="30" />
        <Setter Property="Shape.Fill" Value="{StaticResource logbook_Button_Foreground_Brush}" />
        <Setter Property="Shape.StrokeThickness" Value="0" />
        <Setter Property="FrameworkElement.UseLayoutRounding" Value="False" />
        <Setter Property="Shape.Stretch" Value="Uniform" />
        <Setter Property="FrameworkElement.HorizontalAlignment" Value="Center" />
        <Setter Property="FrameworkElement.VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="logbook_Button_Style" TargetType="{x:Type Button}">
        <Setter Property="Control.Foreground" Value="{StaticResource logbook_Button_Foreground_Brush}" />
        <Setter Property="Control.Background" Value="{StaticResource logbook_Button_Background_Brush}" />
        <Setter Property="Control.BorderBrush" Value="{StaticResource logbook_Button_BorderBrush_Brush}" />
        <Setter Property="Control.Padding" Value="3" />
        <Setter Property="Control.BorderThickness" Value="1,1,1,2" />
        <Setter Property="FrameworkElement.Width" Value="40" />
        <Setter Property="FrameworkElement.Height" Value="40" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    </Style>
    <SolidColorBrush x:Key="StandardBorderBrush" Color="#888" />
    <SolidColorBrush x:Key="StandardBackgroundBrush" Color="#FFF" />
    <SolidColorBrush x:Key="HoverBorderBrush" Color="#DDD" />
    <SolidColorBrush x:Key="SelectedBackgroundBrush" Color="Gray" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="White" />
    <SolidColorBrush x:Key="DisabledForegroundBrush" Color="#888" />
    <SolidColorBrush x:Key="NormalBrush" Color="#888" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="#888" />
    <SolidColorBrush x:Key="HorizontalNormalBrush" Color="#888" />
    <SolidColorBrush x:Key="HorizontalNormalBorderBrush" Color="#888" />
    <LinearGradientBrush x:Key="ListBoxBackgroundBrush" StartPoint="0,0" EndPoint="1,0.001">
        <LinearGradientBrush.GradientStops>
            <GradientStopCollection>
                <GradientStop Offset="0.0" Color="White" />
                <GradientStop Offset="0.6" Color="White" />
                <GradientStop Offset="1.2" Color="#DDDDDD" />
            </GradientStopCollection>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="StandardBrush" StartPoint="0,0" EndPoint="0,1">
        <LinearGradientBrush.GradientStops>
            <GradientStopCollection>
                <GradientStop Offset="0.0" Color="#FFF" />
                <GradientStop Offset="1.0" Color="#CCC" />
            </GradientStopCollection>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="GlyphBrush" Color="#444" />
    <LinearGradientBrush x:Key="PressedBrush" StartPoint="0,0" EndPoint="0,1">
        <LinearGradientBrush.GradientStops>
            <GradientStopCollection>
                <GradientStop Offset="0.0" Color="#BBB" />
                <GradientStop Offset="0.1" Color="#EEE" />
                <GradientStop Offset="0.9" Color="#EEE" />
                <GradientStop Offset="1.0" Color="#FFF" />
            </GradientStopCollection>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>
    <Style x:Key="ScrollBarLineButton" TargetType="{x:Type RepeatButton}">
        <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
        <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
        <Setter Property="UIElement.Focusable" Value="False" />
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Name="Border" Margin="0" Background="{TemplateBinding Control.Foreground}" BorderThickness="0" CornerRadius="2">
                        <Border Background="#AAFFFFFF" BorderBrush="{TemplateBinding Control.Foreground}" BorderThickness="1" CornerRadius="2">
                            <Path HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{TemplateBinding Control.Foreground}" Data="{Binding Path=Content, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ScrollBarPageButton" TargetType="{x:Type RepeatButton}">
        <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
        <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
        <Setter Property="Control.IsTabStop" Value="False" />
        <Setter Property="UIElement.Focusable" Value="False" />
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Background="#00FFFFFF" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ScrollBarThumb" TargetType="{x:Type Thumb}">
        <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
        <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
        <Setter Property="Control.IsTabStop" Value="False" />
        <Setter Property="UIElement.Focusable" Value="False" />
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border Name="Border" Margin="0" Background="{TemplateBinding Control.Foreground}" BorderThickness="0" CornerRadius="2">
                        <Border Background="#AAFFFFFF" BorderBrush="{TemplateBinding Control.Foreground}" BorderThickness="1" CornerRadius="2" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <ControlTemplate x:Key="VerticalScrollBar" TargetType="{x:Type ScrollBar}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition MaxHeight="18" />
                <RowDefinition Height="0.00001*" />
                <RowDefinition MaxHeight="18" />
            </Grid.RowDefinitions>
            <Border Grid.RowSpan="3" Background="{TemplateBinding Control.Background}" CornerRadius="2" />
            <RepeatButton Grid.Row="0" Height="18" Background="{TemplateBinding Control.Background}" Command="ScrollBar.LineUpCommand" Content="M 0 4 L 8 4 L 4 0 Z" Foreground="{TemplateBinding Control.Foreground}" Style="{StaticResource ScrollBarLineButton}" />
            <Track Name="PART_Track" Grid.Row="1" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollBarPageButton}" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Margin="1,0,1,0" Background="{TemplateBinding Control.Background}" BorderBrush="{StaticResource HorizontalNormalBorderBrush}" Foreground="{TemplateBinding Control.Foreground}" Style="{StaticResource ScrollBarThumb}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollBarPageButton}" />
                </Track.IncreaseRepeatButton>
            </Track>
            <RepeatButton Grid.Row="3" Height="18" Background="{TemplateBinding Control.Background}" Command="ScrollBar.LineDownCommand" Content="M 0 0 L 4 4 L 8 0 Z" Foreground="{TemplateBinding Control.Foreground}" Style="{StaticResource ScrollBarLineButton}" />
        </Grid>
    </ControlTemplate>
    <Style x:Key="VerticalScrollBarStyle" TargetType="{x:Type ScrollBar}">
        <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
        <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
        <Setter Property="ScrollBar.Orientation" Value="Vertical" />
        <Setter Property="FrameworkElement.Width" Value="18" />
        <Setter Property="FrameworkElement.Height" Value="Auto" />
        <Setter Property="Control.Template" Value="{StaticResource VerticalScrollBar}" />
    </Style>
    <Style x:Key="{x:Type local:HMILogbook}" TargetType="{x:Type local:HMILogbook}">
        <Setter Property="UIElement.Opacity" Value="{Binding Path=Opacity}" />
        <Setter Property="Control.Padding" Value="3" />
        <Setter Property="Control.FontFamily" Value="{Binding Path=FontFamily}" />
        <Setter Property="Control.FontSize" Value="{Binding Path=FontSize}" />
        <Setter Property="Control.FontStretch" Value="{Binding Path=FontStretch}" />
        <Setter Property="Control.FontStyle" Value="{Binding Path=FontStyle}" />
        <Setter Property="Control.FontWeight" Value="{Binding Path=FontWeight}" />
        <Setter Property="Control.HorizontalContentAlignment" Value="Center" />
        <Setter Property="Control.VerticalContentAlignment" Value="Center" />
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HMILogbook}">
                    <Grid Name="LayoutRoot">
                        <Border Name="Background">
                            <Grid Margin="1">
                                <Border Background="{Binding Background}" BorderBrush="{Binding BorderBrush}" BorderThickness="{Binding BorderThickness}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Border Name="uxHeaderBorder" Padding="0,2" Background="{Binding HeaderBackground}">
                                            <Grid Margin="2,2,20,2" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource logbook_Topic_TextBlock_Style}" TextBlock.Foreground="{Binding TopicForeground}" Text="{Binding Topic}" />
                                                <TextBlock Grid.Column="1" Style="{StaticResource logbook_TimeFilter_TextBlock_Style}" TextBlock.Foreground="{Binding TimeFilterForeground}" Text="{Binding DisplayTimeFilter}" />
                                            </Grid>
                                        </Border>
                                        <Border Name="uxFooterBorder" Grid.Row="2" Height="20" Background="{Binding FooterBackground}">
                                            <Grid Margin="2,2,20,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                                    <TextBlock Text="1 of 3" TextBlock.Foreground="{Binding FooterForeground}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <Border Name="uxCommandsBorder" Grid.Row="3" Padding="5" Background="{Binding ToolBarBackground}">
                                            <Grid Margin="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
