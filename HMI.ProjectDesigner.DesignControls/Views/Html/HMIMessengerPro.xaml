<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:HMI.ProjectDesigner.DesignControls.Html">
    <Style x:Key="{x:Type local:HMIMessengerPro}" TargetType="{x:Type local:HMIMessengerPro}">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HMIMessengerPro}">
                    <Border Background="{Binding Background}" BorderBrush="{Binding BorderBrush}" BorderThickness="{Binding BorderThickness}">
                        <Grid>
                            <Image Name="ScreenShot" Source="Images/MessengerProScreenShot.png" Stretch="Fill" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="UIElement.Opacity" Value="{Binding Opacity}" />
    </Style>
</ResourceDictionary>