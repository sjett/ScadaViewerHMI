<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:gh="clr-namespace:HMI.Infrastructure.Converters;assembly=HMI.Infrastructure.Converters"
                    xmlns:local="clr-namespace:HMI.ProjectDesigner.DesignControls.Gauges">
    <BooleanToVisibilityConverter x:Key="BoolVisibilityConverter" />
    <gh:AverageValueStringConverter x:Key="AverageValueConverter" />
    <gh:ValueToPercentConverter x:Key="ValueToPercentConverter" />
    <Style x:Key="{x:Type local:HMIBargraph4}" TargetType="{x:Type local:HMIBargraph4}">
        <Setter Property="local:HMIBargraph4.DesignerTemplateKey" Value="HMIBargraph4Designer" />
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HMIBargraph4}">
                    <Image Source="Images/HMIBargraph4.png" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="HMIBargraph4Designer" TargetType="{x:Type local:HMIBargraph4}">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HMIBargraph4}">
                    <Viewbox IsHitTestVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Grid Name="LayoutRoot" Background="{x:Null}">
                            <Grid Height="258" HorizontalAlignment="Left" VerticalAlignment="Stretch" Width="61">
                                <Path Height="258" Margin="0,0,0,0" VerticalAlignment="Stretch" RenderTransformOrigin="1.31666664780511,0.474806189537048" Stretch="Fill" StrokeThickness="0" Data="M0,0L60.67416,0 60.67416,258 0,258z" Stroke="{x:Null}">
                                    <Path.Fill>
                                        <LinearGradientBrush EndPoint="-0.049,0.497" StartPoint="1.016,0.502">
                                            <GradientStop Color="#FF474646" />
                                            <GradientStop Color="#FF474646" Offset="1" />
                                            <GradientStop Color="#FFFFFFFF" Offset="0.48" />
                                        </LinearGradientBrush>
                                    </Path.Fill>
                                </Path>
                                <Path Name="Bar" Height="246" HorizontalAlignment="Left" Margin="7,0,0,0" Width="46" RenderTransformOrigin="0.5,0.5" Stretch="Fill" StrokeThickness="0" Data="M0,0L50,0 50,200 0,200z">
                                    <Path.Fill>
                                        <LinearGradientBrush EndPoint="0.5,-0.004" StartPoint="0.5,0.997">
                                            <GradientStop Color="#FF29FF00" Offset="0" />
                                            <GradientStop Color="#FF00FF12">
                                                <GradientStop.Offset>
                                                    <MultiBinding Converter="{StaticResource ValueToPercentConverter}">
                                                        <Binding Path="RangeMin" />
                                                        <Binding Path="RangeMax" />
                                                        <Binding Path="ThresholdValue1" />
                                                    </MultiBinding>
                                                </GradientStop.Offset>
                                            </GradientStop>
                                            <GradientStop Color="#FFFFF900">
                                                <GradientStop.Offset>
                                                    <MultiBinding Converter="{StaticResource ValueToPercentConverter}" ConverterParameter="0">
                                                        <Binding Path="RangeMin" />
                                                        <Binding Path="RangeMax" />
                                                        <Binding Path="ThresholdValue1" />
                                                    </MultiBinding>
                                                </GradientStop.Offset>
                                            </GradientStop>
                                            <GradientStop Color="#FFFFCA00">
                                                <GradientStop.Offset>
                                                    <MultiBinding Converter="{StaticResource ValueToPercentConverter}">
                                                        <Binding Path="RangeMin" />
                                                        <Binding Path="RangeMax" />
                                                        <Binding Path="ThresholdValue2" />
                                                    </MultiBinding>
                                                </GradientStop.Offset>
                                            </GradientStop>
                                            <GradientStop Color="#FFFF0000">
                                                <GradientStop.Offset>
                                                    <MultiBinding Converter="{StaticResource ValueToPercentConverter}" ConverterParameter="0">
                                                        <Binding Path="RangeMin" />
                                                        <Binding Path="RangeMax" />
                                                        <Binding Path="ThresholdValue2" />
                                                    </MultiBinding>
                                                </GradientStop.Offset>
                                            </GradientStop>
                                        </LinearGradientBrush>
                                    </Path.Fill>
                                </Path>
                                <Path Height="240" HorizontalAlignment="Left" Margin="30,0,0,0" VerticalAlignment="Stretch" Width="20" RenderTransformOrigin="0.5,0.5" Stretch="Fill" StrokeThickness="0" Data="M0,0L50,0 50,200 0,200z" Stroke="{x:Null}">
                                    <Path.Fill>
                                        <LinearGradientBrush EndPoint="1.6,0.503" StartPoint="-1.183,0.503">
                                            <GradientStop Color="#00FFFFFF" Offset="0.013000000268220902" />
                                            <GradientStop Color="#FFFFFFFF" Offset="1" />
                                        </LinearGradientBrush>
                                    </Path.Fill>
                                </Path>
                                <Rectangle Name="EmptyFill" Height="0" HorizontalAlignment="Left" Margin="7,6,0,0" VerticalAlignment="Top" Width="46" RenderTransformOrigin="0.5,0.5" Fill="#FF000000" Stroke="#FF000000" StrokeThickness="0" />
                            </Grid>
                            <Grid Name="ScaleGridElement" HorizontalAlignment="Left" Margin="100,0,0,0" RenderTransformOrigin="0.5,0.5" Visibility="{Binding Path=ShowScale, Converter={StaticResource BoolVisibilityConverter}}">
                                <TextBlock Name="Scale100Element" Height="Auto" VerticalAlignment="Top" Width="Auto" Text="{Binding Path=RangeMax}" />
                                <TextBlock Name="Scale50Element" Height="Auto" HorizontalAlignment="Center" Margin="0,0,0,0" VerticalAlignment="Center" Width="Auto">
                  <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource AverageValueConverter}">
                      <Binding Path="RangeMin" />
                      <Binding Path="RangeMax" />
                    </MultiBinding>
                  </TextBlock.Text>
                                </TextBlock>
                                <TextBlock Name="Scale0Element" Height="Auto" HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="Auto" Text="{Binding Path=RangeMin}" />
                            </Grid>
                            <Path Name="ScalePathElement" Height="246" HorizontalAlignment="Left" Margin="70,0,0,0" Width="20" RenderTransformOrigin="0.500000081956399,0.47080967074535" Stretch="Fill" StrokeThickness="0" Data="M0,241L19.999996,241 19.999996,244 0,244z M0,121L19.999996,121 19.999996,124 0,124z M0,0L19.999996,0 19.999996,3 0,3z" Stroke="{x:Null}" Visibility="{Binding Path=ShowScale, Converter={StaticResource BoolVisibilityConverter}}">
                                <Path.Fill>
                                    <LinearGradientBrush EndPoint="0.022,0.498" StartPoint="1.1,0.502">
                                        <GradientStop Color="#FF474646" />
                                        <GradientStop Color="#FF474646" Offset="1" />
                                        <GradientStop Color="#FFD0D0D0" Offset="0.48" />
                                    </LinearGradientBrush>
                                </Path.Fill>
                            </Path>
                        </Grid>
                    </Viewbox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>