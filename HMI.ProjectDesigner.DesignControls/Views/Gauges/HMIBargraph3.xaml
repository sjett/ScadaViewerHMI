<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:gh="clr-namespace:HMI.Infrastructure.Converters;assembly=HMI.Infrastructure.Converters"
                    xmlns:local="clr-namespace:HMI.ProjectDesigner.DesignControls.Gauges">
    <BooleanToVisibilityConverter x:Key="BoolVisibilityConverter" />
    <gh:AverageValueStringConverter x:Key="AverageValueConverter" />
    <Style x:Key="{x:Type local:HMIBargraph3}" TargetType="{x:Type local:HMIBargraph3}">
        <Setter Property="local:HMIBargraph3.DesignerTemplateKey" Value="HMIBargraph3Designer" />
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HMIBargraph3}">
                    <Image Source="Images/HMIBargraph3.png" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="HMIBargraph3Designer" TargetType="{x:Type local:HMIBargraph3}">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HMIBargraph3}">
                    <Viewbox IsHitTestVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Grid Name="LayoutRoot" Background="{x:Null}">
                            <Path Height="258" HorizontalAlignment="Left" Margin="0,0,0,0" VerticalAlignment="Stretch" Width="61" RenderTransformOrigin="1.31666664780511,0.474806189537048" Stretch="Fill" StrokeThickness="0" Data="M0,0L60.67416,0 60.67416,258 0,258z" Stroke="{x:Null}">
                                <Path.Fill>
                                    <LinearGradientBrush EndPoint="0.022,0.498" StartPoint="0.902,0.501">
                                        <GradientStop Color="#FF474646" />
                                        <GradientStop Color="#FF474646" Offset="1" />
                                        <GradientStop Color="#FFFFFFFF" Offset="0.48" />
                                    </LinearGradientBrush>
                                </Path.Fill>
                                <Path.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform ScaleX="1" ScaleY="1" />
                                        <SkewTransform />
                                        <RotateTransform />
                                        <TranslateTransform />
                                    </TransformGroup>
                                </Path.RenderTransform>
                            </Path>
                            <Path Name="Bar" Height="245" HorizontalAlignment="Left" Margin="7,0,0,0" Width="46" RenderTransformOrigin="0.5,0.5" Stretch="Fill" StrokeThickness="2" Data="M0,0L50,0 50,200 0,200z">
                                <Path.Fill>
                                    <LinearGradientBrush EndPoint="0.5,-0.001" StartPoint="0.5,1.001">
                                        <GradientStop Color="#FFFFCA00" Offset="0.009" />
                                        <GradientStop Color="#FFFF4800" Offset="0" />
                                    </LinearGradientBrush>
                                </Path.Fill>
                                <Path.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform ScaleX="1" ScaleY="1" />
                                        <SkewTransform />
                                        <RotateTransform />
                                        <TranslateTransform />
                                    </TransformGroup>
                                </Path.RenderTransform>
                            </Path>
                            <Path Height="240" HorizontalAlignment="Left" Margin="30,0,0,0" VerticalAlignment="Stretch" Width="20" RenderTransformOrigin="0.5,0.5" Stretch="Fill" StrokeThickness="0" Data="M0,0L50,0 50,200 0,200z" Stroke="{x:Null}">
                                <Path.Fill>
                                    <LinearGradientBrush EndPoint="1.6,0.503" StartPoint="-1.183,0.503">
                                        <GradientStop Color="#00FFFFFF" Offset="0.013000000268220902" />
                                        <GradientStop Color="#FFFFFFFF" Offset="1" />
                                    </LinearGradientBrush>
                                </Path.Fill>
                                <Path.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform ScaleX="1" ScaleY="1" />
                                        <SkewTransform />
                                        <RotateTransform />
                                        <TranslateTransform />
                                    </TransformGroup>
                                </Path.RenderTransform>
                            </Path>
                            <Path Name="ScalePathElement" Height="246" HorizontalAlignment="Left" Margin="70,0,0,0" Width="20" RenderTransformOrigin="0.500000044703485,0.464222239260852" Stretch="Fill" StrokeThickness="0" Data="M0,238L20,238 20,241 0,241z M0,118L20,118 20,121 0,121z M0,0L20,0 20,3 0,3z" Stroke="{x:Null}" Visibility="{Binding Path=ShowScale, Converter={StaticResource BoolVisibilityConverter}}">
                                <Path.Fill>
                                    <LinearGradientBrush EndPoint="0.022,0.498" StartPoint="1.2,0.502">
                                        <GradientStop Color="#FF474646" />
                                        <GradientStop Color="#FF474646" Offset="1" />
                                        <GradientStop Color="#FFC5C5C5" Offset="0.48" />
                                    </LinearGradientBrush>
                                </Path.Fill>
                                <Path.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform ScaleX="1" ScaleY="1" />
                                        <SkewTransform />
                                        <RotateTransform />
                                        <TranslateTransform />
                                    </TransformGroup>
                                </Path.RenderTransform>
                            </Path>
                            <Grid Name="ScaleGridElement" Height="258" HorizontalAlignment="Left" Margin="100,0,0,0" Width="Auto" RenderTransformOrigin="0.5,0.5" Visibility="{Binding Path=ShowScale, Converter={StaticResource BoolVisibilityConverter}}">
                                <Grid.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform ScaleY="1" />
                                        <SkewTransform />
                                        <RotateTransform />
                                        <TranslateTransform />
                                    </TransformGroup>
                                </Grid.RenderTransform>
                                <TextBlock Name="Scale100Element" Height="Auto" VerticalAlignment="Top" Width="Auto" Text="{Binding Path=RangeMax}" />
                                <TextBlock Name="Scale50Element" Height="Auto" HorizontalAlignment="Center" Margin="0,0,0,0" VerticalAlignment="Center" Width="Auto">
                                  <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource AverageValueConverter}">
                                      <Binding Path="RangeMin" />
                                      <Binding Path="RangeMax" />
                                    </MultiBinding>
                                  </TextBlock.Text>
                                </TextBlock>
                                <TextBlock Name="Scale0Element" Height="Auto" HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="Auto" Text="{Binding Path=RangeMin}" />
                            </Grid>
                        </Grid>
                    </Viewbox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>