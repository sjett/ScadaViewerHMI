<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:HMI.ProjectDesigner.DesignControls.UserManagement">
    <Style x:Key="{x:Type local:HMIUserManager}" TargetType="{x:Type local:HMIUserManager}">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HMIUserManager}">
                    <Grid Name="LayoutRoot">
                        <Image Source="Images/UserManager.png" Stretch="Fill" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="UIElement.Opacity" Value="{Binding Path=Opacity}" />
    </Style>
</ResourceDictionary>