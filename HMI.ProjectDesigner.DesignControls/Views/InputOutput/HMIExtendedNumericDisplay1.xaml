<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:gh="clr-namespace:HMI.Infrastructure.Converters;assembly=HMI.Infrastructure.Converters"
                    xmlns:local="clr-namespace:HMI.ProjectDesigner.DesignControls.InputOutput">
    <gh:TernarySelector x:Key="TernarySelector" />
    <gh:StringNullOrEmptyFallbackConverter x:Key="StringNullOrEmptyFallbackConverter" />
    <Style x:Key="{x:Type local:HMIExtendedNumericDisplay1}" TargetType="{x:Type local:HMIExtendedNumericDisplay1}">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HMIExtendedNumericDisplay1}">
                    <Grid IsHitTestVisible="False" Background="{x:Null}">
                        <Rectangle HorizontalAlignment="Stretch" Margin="0,0,0,0" Width="Auto" StrokeThickness="2">
                            <Rectangle.Fill>
                                <LinearGradientBrush EndPoint="0.5,1.136" StartPoint="0.5,-0.205">
                                    <GradientStop Color="#FF000000" Offset="0" />
                                    <GradientStop Color="#FFC9D6F7" Offset="0.32" />
                                    <GradientStop Color="#FFFFFFFF" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                            <Rectangle.Stroke>
                                <LinearGradientBrush EndPoint="0.5,0" StartPoint="0.5,1">
                                    <GradientStop Color="#FF000B33" />
                                    <GradientStop Color="#FFD3EBFF" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.Stroke>
                        </Rectangle>
                        <TextBlock Name="OutputElement" Margin="0,0,0,0" TextWrapping="Wrap" TextBlock.FontFamily="{Binding Path=FontFamily}" TextBlock.FontSize="{Binding Path=FontSize}" TextBlock.FontStretch="{Binding Path=FontStretch}" TextBlock.FontStyle="{Binding Path=FontStyle}" TextBlock.FontWeight="{Binding Path=FontWeight}" TextBlock.Foreground="{Binding Path=Foreground}" HorizontalAlignment="{Binding Path=HorizontalContentAlignment}" VerticalAlignment="{Binding Path=VerticalContentAlignment}" Text="{Binding Path=ResolvedSignalName, Converter={StaticResource StringNullOrEmptyFallbackConverter}, ConverterParameter=HMIExtendedNumericDisplay1}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="UIElement.Opacity" Value="{Binding Path=Opacity}" />
    </Style>
</ResourceDictionary>