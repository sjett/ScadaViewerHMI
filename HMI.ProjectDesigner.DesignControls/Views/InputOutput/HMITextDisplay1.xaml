<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:gh="clr-namespace:HMI.Infrastructure.Converters;assembly=HMI.Infrastructure.Converters"
                    xmlns:local="clr-namespace:HMI.ProjectDesigner.DesignControls.InputOutput">
    <gh:TernarySelector x:Key="TernarySelector" />
    <gh:StringNullOrEmptyFallbackConverter x:Key="StringNullOrEmptyFallbackConverter" />
    <Style x:Key="{x:Type local:HMITextDisplay1}" TargetType="{x:Type local:HMITextDisplay1}">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HMITextDisplay1}">
                    <Grid Name="LayoutRoot" IsHitTestVisible="False" Background="{x:Null}">
                        <Rectangle Name="Rectangle" Margin="0,0,0,0" RenderTransformOrigin="0.5,0.5" RadiusX="7" RadiusY="7" StrokeThickness="2">
                            <Rectangle.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform />
                                    <SkewTransform />
                                    <RotateTransform />
                                    <TranslateTransform />
                                </TransformGroup>
                            </Rectangle.RenderTransform>
                            <Rectangle.Fill>
                                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                    <GradientStop Color="#FF959494" />
                                    <GradientStop Color="#FFFFFFFF" Offset="0.271" />
                                    <GradientStop Color="#FFFFFFFF" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                            <Rectangle.Stroke>
                                <LinearGradientBrush EndPoint="0.501,0.07" StartPoint="0.499,1.068">
                                    <GradientStop Color="#FF000000" Offset="0.293" />
                                    <GradientStop Color="#FFECECEC" Offset="0.622" />
                                </LinearGradientBrush>
                            </Rectangle.Stroke>
                        </Rectangle>
                        <TextBlock Name="OutputElement" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,0" TextWrapping="Wrap" TextBlock.FontFamily="{Binding Path=FontFamily}" TextBlock.FontSize="{Binding Path=FontSize}" TextBlock.FontStretch="{Binding Path=FontStretch}" TextBlock.FontStyle="{Binding Path=FontStyle}" TextBlock.FontWeight="{Binding Path=FontWeight}" TextBlock.Foreground="{Binding Path=Foreground}" Text="{Binding Path=ResolvedSignalName, Converter={StaticResource StringNullOrEmptyFallbackConverter}, ConverterParameter=HMITextDisplay1}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="UIElement.Opacity" Value="{Binding Path=Opacity}" />
    </Style>
</ResourceDictionary>