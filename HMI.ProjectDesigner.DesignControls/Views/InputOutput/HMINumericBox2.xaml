<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:gh="clr-namespace:HMI.Infrastructure.Converters;assembly=HMI.Infrastructure.Converters"
                    xmlns:local="clr-namespace:HMI.ProjectDesigner.DesignControls.InputOutput">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Shared.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <gh:TernarySelector x:Key="TernarySelector" />
    <gh:StringNullOrEmptyFallbackConverter x:Key="StringNullOrEmptyFallbackConverter" />
    <Style x:Key="{x:Type local:HMINumericBox2}" TargetType="{x:Type local:HMINumericBox2}">
        <Setter Property="Control.BorderThickness" Value="1" />
        <Setter Property="Control.Background">
            <Setter.Value>
                <MultiBinding Converter="{StaticResource TernarySelector}">
                    <Binding Path="UseLocalColors" />
                    <Binding Path="Project.StateDefaultBackground" FallbackValue="White" />
                    <Binding Path="Background" />
                </MultiBinding>
            </Setter.Value>
        </Setter>
        <Setter Property="Control.Foreground">
            <Setter.Value>
                <MultiBinding Converter="{StaticResource TernarySelector}">
                    <Binding Path="UseLocalColors" />
                    <Binding Path="Project.StateDefaultForeground" FallbackValue="Black" />
                    <Binding Path="Foreground" />
                </MultiBinding>
            </Setter.Value>
        </Setter>
        <Setter Property="Control.Padding" Value="2" />
        <Setter Property="Control.BorderBrush">
            <Setter.Value>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFA3AEB9" Offset="0" />
                    <GradientStop Color="#FF8399A9" Offset="0.375" />
                    <GradientStop Color="#FF718597" Offset="0.375" />
                    <GradientStop Color="#FF617584" Offset="1" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HMINumericBox2}">
                    <Grid IsHitTestVisible="False">
                        <Border Name="Border" Opacity="1" CornerRadius="1" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}">
                            <Grid Background="{TemplateBinding Control.Background}">
                                <Border Name="ReadOnlyVisualElement" Opacity="0" Background="#72F7F7F7" />
                                <Border Name="MouseOverBorder" BorderBrush="#00FFFFFF" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" TextBlock.Foreground="{TemplateBinding Control.Foreground}" TextBlock.FontFamily="{Binding Path=FontFamily}" TextBlock.FontSize="{Binding Path=FontSize}" TextBlock.FontStretch="{Binding Path=FontStretch}" TextBlock.FontStyle="{Binding Path=FontStyle}" TextBlock.FontWeight="{Binding Path=FontWeight}" Text="{Binding Path=ResolvedSignalName, Converter={StaticResource StringNullOrEmptyFallbackConverter}, ConverterParameter=HMINumericBox2}" />
                                        <Button Name="EditElement" IsTabStop="False" Style="{StaticResource EditButton}" Grid.Column="1" Content="Edit" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                        <Border Name="DisabledVisualElement" IsHitTestVisible="False" Opacity="0" Background="#A5F7F7F7" BorderBrush="#A5F7F7F7" />
                        <Border Name="FocusVisualElement" Margin="1" IsHitTestVisible="False" Opacity="0" BorderBrush="#FF6DBDD1" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="UIElement.Opacity" Value="{Binding Path=Opacity}" />
    </Style>
</ResourceDictionary>