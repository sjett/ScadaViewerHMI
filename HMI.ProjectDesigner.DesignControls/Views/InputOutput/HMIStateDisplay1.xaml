<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:gh="clr-namespace:HMI.Infrastructure.Converters;assembly=HMI.Infrastructure.Converters"
                    xmlns:local="clr-namespace:HMI.ProjectDesigner.DesignControls.Views.InputOutput">
    <gh:TernarySelector x:Key="TernarySelector" />
    <gh:StringNullOrEmptyFallbackConverter x:Key="StringNullOrEmptyFallbackConverter" />
    <Style x:Key="{x:Type local:HMIStateDisplay1}" TargetType="{x:Type local:HMIStateDisplay1}">
        <Setter Property="Control.FontFamily" Value="{Binding FontFamily}" />
        <Setter Property="Control.FontSize" Value="{Binding FontSize}" />
        <Setter Property="Control.FontStretch" Value="{Binding FontStretch}" />
        <Setter Property="Control.FontStyle" Value="{Binding FontStyle}" />
        <Setter Property="Control.FontWeight" Value="{Binding FontWeight}" />
        <Setter Property="Control.HorizontalContentAlignment" Value="Center" />
        <Setter Property="Control.VerticalContentAlignment" Value="Center" />
        <Setter Property="Control.Background">
            <Setter.Value>
                <MultiBinding Converter="{StaticResource TernarySelector}">
                    <Binding Path="UseLocalColors" />
                    <Binding Path="Project.StateDefaultBackground" FallbackValue="White" />
                    <Binding Path="Background" />
                </MultiBinding>
            </Setter.Value>
        </Setter>
        <Setter Property="Control.Foreground">
            <Setter.Value>
                <MultiBinding Converter="{StaticResource TernarySelector}">
                    <Binding Path="UseLocalColors" />
                    <Binding Path="Project.StateDefaultForeground" FallbackValue="Black" />
                    <Binding Path="Foreground" />
                </MultiBinding>
            </Setter.Value>
        </Setter>
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HMIStateDisplay1}">
                    <Grid Name="LayoutRoot" Background="{TemplateBinding Control.Background}">
                        <TextBlock Name="OutputElement" TextBlock.Foreground="{TemplateBinding Control.Foreground}" HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" Padding="{TemplateBinding Control.Padding}" Text="HMIStateDisplay1" TextBlock.TextAlignment="Left" TextWrapping="Wrap" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>