<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
                    xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
                    xmlns:gh="clr-namespace:HMI.Infrastructure.Converters;assembly=HMI.Infrastructure.Converters"
                    xmlns:local="clr-namespace:HMI.ProjectDesigner.DesignControls.InputOutput">
    <gh:TernarySelector x:Key="TernarySelector" />
    <Style x:Key="{x:Type local:HMINumericDisplay2}" TargetType="{x:Type local:HMINumericDisplay2}">
        <Setter Property="local:HMINumericDisplay2.DesignerTemplateKey" Value="HMINumericDisplay2Style" />
        <Setter Property="Control.Background">
            <Setter.Value>
                <MultiBinding Converter="{StaticResource TernarySelector}">
                    <Binding Path="UseLocalColors" />
                    <Binding FallbackValue="White" Path="Project.StateDefaultBackground" />
                    <Binding Path="Background" />
                </MultiBinding>
            </Setter.Value>
        </Setter>
        <Setter Property="Control.Foreground">
            <Setter.Value>
                <MultiBinding Converter="{StaticResource TernarySelector}">
                    <Binding Path="UseLocalColors" />
                    <Binding FallbackValue="Black" Path="Project.StateDefaultForeground" />
                    <Binding Path="Foreground" />
                </MultiBinding>
            </Setter.Value>
        </Setter>
        <Setter Property="local:HMINumericDisplay2.Digits" Value="{Binding Digits, FallbackValue=6}" />
        <Setter Property="local:HMINumericDisplay2.Precision" Value="{Binding Precision, FallbackValue=2}" />
        <Setter Property="Control.FontFamily" Value="{Binding FontFamily, FallbackValue=Arial}" />
        <Setter Property="Control.FontSize" Value="{Binding FontSize, FallbackValue=10}" />
        <Setter Property="Control.FontStretch" Value="{Binding FontStretch, FallbackValue=Normal}" />
        <Setter Property="Control.FontStyle" Value="{Binding FontStyle, FallbackValue=Normal}" />
        <Setter Property="Control.FontWeight" Value="{Binding FontWeight, FallbackValue=Normal}" />
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HMINumericDisplay2}">
                    <Grid Name="uxLayoutRoot" Width="300" Height="50" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <telerik:NumericScale Name="uxNumericScaleElement" 
                                              Control.Background="{TemplateBinding Control.Background}" 
                                              Control.BorderThickness="0" 
                                              Control.Foreground="{TemplateBinding Control.Foreground}" 
                                              Max="1000" 
                                              Min="-1000" 
                                              FrameworkElement.Width="{Binding ActualWidth, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Grid}}}" 
                                              FrameworkElement.Height="{Binding ActualHeight, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Grid}}}">
                            <telerik:NumericScale.Indicators>
                                <telerik:NumericIndicator Name="uxNumericIndicatorElement" 
                                                          Control.Background="{TemplateBinding Control.Background}" 
                                                          Control.BorderThickness="0" 
                                                          Control.FontFamily="{TemplateBinding Control.FontFamily}" 
                                                          Control.FontSize="{TemplateBinding Control.FontSize}" 
                                                          Control.FontStretch="{TemplateBinding Control.FontStretch}" 
                                                          Control.FontStyle="{TemplateBinding Control.FontStyle}" 
                                                          Control.FontWeight="{TemplateBinding Control.FontWeight}" 
                                                          Control.Foreground="{TemplateBinding Control.Foreground}" 
                                                          Format="{}{0:F1}" 
                                                          telerik:ScaleObject.RelativeX="0"
                                                          telerik:ScaleObject.RelativeY="0"
                                                          telerik:ScaleObject.RelativeHeight="1" 
                                                          telerik:ScaleObject.RelativeWidth="1" 
                                                          Value="0.0">
                                    <telerik:NumericIndicator.Positions>
                                        <!-- 5种文字效果-->
                                        <!--<telerik:FontNumberPosition />
                                        <telerik:GraphicNumberPosition />
                                        <telerik:HexagonalNumberPosition />
                                        <telerik:SevenSegsNumberPosition />-->
                                        <telerik:HexagonalNumberPosition />
                                        <telerik:HexagonalNumberPosition />
                                        <telerik:HexagonalNumberPosition />
                                    </telerik:NumericIndicator.Positions>
                                </telerik:NumericIndicator>
                            </telerik:NumericScale.Indicators>
                        </telerik:NumericScale>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="HMINumericDisplay2Style" TargetType="{x:Type local:HMINumericDisplay2}">
        <Setter Property="Control.Background">
            <Setter.Value>
                <MultiBinding Converter="{StaticResource TernarySelector}">
                    <Binding Path="UseLocalColors" />
                    <Binding FallbackValue="White" Path="Project.StateDefaultBackground" />
                    <Binding Path="Background" />
                </MultiBinding>
            </Setter.Value>
        </Setter>
        <Setter Property="Control.Foreground">
            <Setter.Value>
                <MultiBinding Converter="{StaticResource TernarySelector}">
                    <Binding Path="UseLocalColors" />
                    <Binding FallbackValue="Black" Path="Project.StateDefaultForeground" />
                    <Binding Path="Foreground" />
                </MultiBinding>
            </Setter.Value>
        </Setter>
        <Setter Property="local:HMINumericDisplay2.Digits" Value="{Binding Digits, FallbackValue=6}" />
        <Setter Property="local:HMINumericDisplay2.Precision" Value="{Binding Precision, FallbackValue=2}" />
        <Setter Property="Control.FontFamily" Value="{Binding FontFamily, FallbackValue=Arial}" />
        <Setter Property="Control.FontSize" Value="{Binding FontSize, FallbackValue=10}" />
        <Setter Property="Control.FontStretch" Value="{Binding FontStretch, FallbackValue=Normal}" />
        <Setter Property="Control.FontStyle" Value="{Binding FontStyle, FallbackValue=Normal}" />
        <Setter Property="Control.FontWeight" Value="{Binding FontWeight, FallbackValue=Normal}" />
        <Setter Property="local:HMINumericDisplay2.DisplayType" Value="{Binding DisplayType}" />
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HMINumericDisplay2}">
                    <Grid Name="uxLayoutRoot" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <telerik:NumericScale Name="uxNumericScaleElement" 
                                              Control.Background="{TemplateBinding Control.Background}" 
                                              Control.BorderThickness="0" 
                                              Control.Foreground="{TemplateBinding Control.Foreground}" 
                                              Max="1000" 
                                              Min="-1000" 
                                              FrameworkElement.Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" 
                                              FrameworkElement.Height="{Binding ActualHeight, RelativeSource={RelativeSource TemplatedParent}}">
                            <telerik:NumericScale.Indicators>
                                <telerik:NumericIndicator Name="uxNumericIndicatorElement" 
                                  Control.Background="{TemplateBinding Control.Background}" 
                                  Control.BorderThickness="0" 
                                  Control.FontFamily="{TemplateBinding Control.FontFamily}" 
                                  Control.FontSize="{TemplateBinding Control.FontSize}" 
                                  Control.FontStretch="{TemplateBinding Control.FontStretch}" 
                                  Control.FontStyle="{TemplateBinding Control.FontStyle}" 
                                  Control.FontWeight="{TemplateBinding Control.FontWeight}" 
                                  Control.Foreground="{TemplateBinding Control.Foreground}" 
                                  Format="{}{0:F1}" 
                                  telerik:ScaleObject.RelativeX="0"
                                  telerik:ScaleObject.RelativeY="0"
                                  telerik:ScaleObject.RelativeHeight="1" 
                                  telerik:ScaleObject.RelativeWidth="1" 
                                  Value="0.0">
                                    <telerik:NumericIndicator.Positions>
                                        <!-- 5种文字效果-->
                                        <!--<telerik:FontNumberPosition />
                                            <telerik:GraphicNumberPosition />
                                            <telerik:HexagonalNumberPosition />
                                            <telerik:SevenSegsNumberPosition />-->
                                        <telerik:HexagonalNumberPosition />
                                        <telerik:HexagonalNumberPosition />
                                        <telerik:HexagonalNumberPosition />
                                    </telerik:NumericIndicator.Positions>
                                </telerik:NumericIndicator>
                            </telerik:NumericScale.Indicators>
                        </telerik:NumericScale>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="UIElement.Opacity" Value="{Binding Path=Opacity}" />
    </Style>
</ResourceDictionary>