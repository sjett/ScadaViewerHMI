<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:gh="clr-namespace:HMI.Infrastructure.Converters;assembly=HMI.Infrastructure.Converters"
                    xmlns:local="clr-namespace:HMI.ProjectDesigner.DesignControls.StaticSymbols">
    
    <gh:StringToXamlConverter x:Key="StringToXamlConverter" />
    
    <Style x:Key="{x:Type local:StaticSymbol}" TargetType="{x:Type local:StaticSymbol}">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:StaticSymbol}">
                    <Grid Name="LayoutRoot" IsHitTestVisible="False" Opacity="{Binding Path=Opacity}">
                        <ContentControl Content="{Binding ContentString, Converter={StaticResource StringToXamlConverter}}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>