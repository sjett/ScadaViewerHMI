<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:localize="clr-namespace:HMI.Common.Presentation.Localization;assembly=HMI.Common.Presentation"
                    xmlns:gh="clr-namespace:HMI.Infrastructure.Converters;assembly=HMI.Infrastructure.Converters"
                    xmlns:local="clr-namespace:HMI.ProjectDesigner.DesignControls.Views.Reporting">

    <BooleanToVisibilityConverter x:Key="booleanVisibilityConverter" />
    <gh:InvertedBoolVisibilityConverter x:Key="invertedBooleanVisibilityConverter" />

    <Style TargetType="local:HMISqlReportViewer">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:HMISqlReportViewer">
                    <Grid x:Name="LayoutRoot" Background="{TemplateBinding Background}">
                        <Grid Visibility="{Binding IsLoading, Converter={StaticResource invertedBooleanVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="200" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--<Telerik:RadHtmlPlaceholder x:Name="uxHtmlSqlReportViewer"
                                                        Grid.Row="0"
                                                        Grid.RowSpan="9"
                                                        Grid.Column="0"
                                                        Margin="0,0,10,0"
                                                        SourceUrl="{Binding ReportDefinitionsUrl}" />-->
                            

                            <Grid x:Name="uxDesignTimeReport"
                                  Grid.Row="0"
                                  Grid.RowSpan="9"
                                  Grid.Column="0"
                                  Margin="0,0,10,0"
                                  Background="LightGray"
                                  Visibility="Collapsed">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Text="{localize:Resx ResxName=HMI.ProjectDesigner.DesignControls.Resources.HMISqlReportViewerTexts, Key=NoReportLoaded}" />
                            </Grid>

                            <TextBlock Grid.Row="0"
                                       Grid.Column="1"
                                       Margin="0,1,1,0"
                                       Text="{localize:Resx ResxName=HMI.ProjectDesigner.DesignControls.Resources.HMISqlReportViewerTexts, Key=AvailableReportsLabel}" />

                            <ListBox Grid.Row="1"
                                     Grid.Column="1"
                                     Margin="0,0,1,0">
                                <ListBoxItem Selector.IsSelected="True" Content="{localize:Resx ResxName=HMI.ProjectDesigner.DesignControls.Resources.HMISqlReportViewerTexts, Key=Report1}"></ListBoxItem>
                                <ListBoxItem Content="{localize:Resx ResxName=HMI.ProjectDesigner.DesignControls.Resources.HMISqlReportViewerTexts, Key=Report2}"></ListBoxItem>
                                <ListBoxItem Content="{localize:Resx ResxName=HMI.ProjectDesigner.DesignControls.Resources.HMISqlReportViewerTexts, Key=Report3}"></ListBoxItem>
                                <ListBoxItem Content="{localize:Resx ResxName=HMI.ProjectDesigner.DesignControls.Resources.HMISqlReportViewerTexts, Key=Report4}"></ListBoxItem>
                                <ListBoxItem Content="{localize:Resx ResxName=HMI.ProjectDesigner.DesignControls.Resources.HMISqlReportViewerTexts, Key=Report5}"></ListBoxItem>
                                <ListBoxItem Content="{localize:Resx ResxName=HMI.ProjectDesigner.DesignControls.Resources.HMISqlReportViewerTexts, Key=Report6}"></ListBoxItem>
                                <ListBoxItem Content="{localize:Resx ResxName=HMI.ProjectDesigner.DesignControls.Resources.HMISqlReportViewerTexts, Key=Report7}"></ListBoxItem>
                            </ListBox>

                            <TextBlock Grid.Row="2"
                                       Grid.Column="1"
                                       Margin="0,10,1,0"
                                       Text="{localize:Resx ResxName=HMI.ProjectDesigner.DesignControls.Resources.HMISqlReportViewerTexts, Key=DescriptionLabel}" />

                            <ScrollViewer Grid.Row="3"
                                          Grid.Column="1"
                                          Height="60"
                                          Margin="0,0,1,0"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Padding="3"
                                          VerticalScrollBarVisibility="Auto">
                                <TextBlock HorizontalAlignment="Left"
                                           VerticalAlignment="Top"
                                           Text="{localize:Resx ResxName=HMI.ProjectDesigner.DesignControls.Resources.HMISqlReportViewerTexts, Key=Report1Description}"
                                           TextWrapping="Wrap" />
                            </ScrollViewer>

                            <TextBlock Grid.Row="4"
                                       Grid.Column="1"
                                       Margin="0,10,1,0"
                                       Text="{localize:Resx ResxName=HMI.ProjectDesigner.DesignControls.Resources.HMISqlReportViewerTexts, Key=StartTimeLabel}" />

                            <Grid Grid.Row="5"
                                  Grid.Column="1"
                                  Margin="0,0,1,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <DatePicker Grid.Column="0"
                                                     Margin="0,0,3,0"
                                                     SelectedDate="{Binding StartDate,
                                                                            Mode=TwoWay}"
                                                      />
                                <!--<inputToolkit:TimeUpDown Grid.Column="1"
                                                         Width="70"
                                                         Format="HH:mm:ss"
                                                         wfshared:KeyboardService.VirtualKeyboardType="Numeric"
                                                         Value="{Binding StartTime,
                                                                         Mode=TwoWay}" />-->
                            </Grid>

                            <TextBlock Grid.Row="6"
                                       Grid.Column="1"
                                       Margin="0,10,1,0"
                                       Text="{localize:Resx ResxName=HMI.ProjectDesigner.DesignControls.Resources.HMISqlReportViewerTexts, Key=EndTimeLabel}" />

                            <Grid Grid.Row="7"
                                  Grid.Column="1"
                                  Margin="0,0,1,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <DatePicker Grid.Column="0"
                                                     Margin="0,0,3,0"
                                                     SelectedDate="{Binding EndDate,
                                                                            Mode=TwoWay}"
                                                     />
                                <!--<inputToolkit:TimeUpDown Grid.Column="1"
                                                         Width="70"
                                                         Format="HH:mm:ss"
                                                         wfshared:KeyboardService.VirtualKeyboardType="Numeric"
                                                         Value="{Binding EndTime,
                                                                         Mode=TwoWay}" />-->
                            </Grid>

                            <Grid Grid.Row="8"
                                  Grid.Column="1"
                                  Margin="0,15,1,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.Resources>
                                    <Style x:Key="customButtonStyle" TargetType="Button">
                                        <Setter Property="Padding" Value="0" />
                                    </Style>
                                </Grid.Resources>

                                <Button x:Name="uxGenerateReport"
                                        Content="{localize:Resx ResxName=HMI.ProjectDesigner.DesignControls.Resources.HMISqlReportViewerTexts, Key=GenerateText}"
                                        Visibility="{Binding ShowReportPreview,
                                                             Converter={StaticResource booleanVisibilityConverter}}" />
                                <!--IsEnabled="{Binding CanGenerateReport}"-->
                                
                                <Button x:Name="uxExportToExcel"
                                        Grid.Column="1"
                                        Width="24"
                                        Height="24"
                                        Margin="2,0"
                                        Style="{StaticResource customButtonStyle}"
                                        ToolTipService.ToolTip="{localize:Resx ResxName=HMI.ProjectDesigner.DesignControls.Resources.HMISqlReportViewerTexts, Key=ExportToExcelText}">
                                <!--IsEnabled="{Binding CanExportReport}"-->
                                    <Image Source="Images/blue-document-excel.png" Stretch="None" />
                                </Button>

                                <Button x:Name="uxExportToPDF"
                                        Grid.Column="2"
                                        Width="24"
                                        Height="24"
                                        Style="{StaticResource customButtonStyle}"
                                        ToolTipService.ToolTip="{localize:Resx ResxName=HMI.ProjectDesigner.DesignControls.Resources.HMISqlReportViewerTexts, Key=ExportToPDFText}">
                                <!--IsEnabled="{Binding CanExportReport}"-->
                                    <Image Source="Images/blue-document-pdf.png" Stretch="None" />
                                </Button>
                            </Grid>
                        </Grid>

                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
</ResourceDictionary>