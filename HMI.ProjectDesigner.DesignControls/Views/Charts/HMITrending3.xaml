<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:HMI.ProjectDesigner.DesignControls.Charts">
    <Style x:Key="{x:Type local:HMITrending3}" TargetType="{x:Type local:HMITrending3}">
        <Setter Property="local:HMITrending3.DesignerTemplateKey" Value="HMITrending3Designer" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HMITrending3}">
                    <Border Background="White" BorderBrush="Black" BorderThickness="0.5">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Margin="6" Text="历史趋势（RapidSCADA）" Foreground="#FF555555" />
                            <Grid Grid.Row="1" Margin="28,8,8,20">
                                <Grid.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FFE6E6E6" Offset="0" />
                                        <GradientStop Color="White" Offset="1" />
                                    </LinearGradientBrush>
                                </Grid.Background>
                                <Canvas>
                                    <Polyline Stroke="#FF1976D2"
                                              StrokeThickness="2"
                                              Points="0,70 40,60 80,72 120,34 160,45 200,22 240,38 280,12" />
                                </Canvas>
                            </Grid>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="HMITrending3Designer" TargetType="{x:Type local:HMITrending3}">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HMITrending3}">
                    <Border Background="White" BorderBrush="Black" BorderThickness="0.5">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Margin="6" Text="历史趋势（RapidSCADA）" Foreground="#FF555555" />
                            <Grid Grid.Row="1" Margin="28,8,8,20">
                                <Grid.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FFE6E6E6" Offset="0" />
                                        <GradientStop Color="White" Offset="1" />
                                    </LinearGradientBrush>
                                </Grid.Background>
                                <Canvas>
                                    <Polyline Stroke="#FF1976D2"
                                              StrokeThickness="2"
                                              Points="0,70 40,60 80,72 120,34 160,45 200,22 240,38 280,12" />
                                </Canvas>
                            </Grid>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Opacity" Value="{Binding Opacity}" />
    </Style>
</ResourceDictionary>
