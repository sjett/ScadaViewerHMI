<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:HMI.ProjectDesigner.DesignControls.Charts">
    <Style x:Key="{x:Type local:HMITrending2}" TargetType="{x:Type local:HMITrending2}">
        <Setter Property="local:HMITrending2.DesignerTemplateKey" Value="HMITrending2Designer" />
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HMITrending2}">
                    <Grid IsHitTestVisible="False" Background="#FFFFFFFF">
                        <Border BorderBrush="#FF000000" BorderThickness="0.5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid>
                                    <UniformGrid Columns="1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="60" TextBlock.FontSize="11" />
                                            <Line Stroke="#FF000000" Y1="6" X2="4" Y2="6" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="40" TextBlock.FontSize="11" />
                                            <Line Stroke="#FF000000" Y1="6" X2="4" Y2="6" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="20" TextBlock.FontSize="11" />
                                            <Line Stroke="#FF000000" Y1="6" X2="4" Y2="6" />
                                        </StackPanel>
                                    </UniformGrid>
                                </Grid>
                                <Grid Grid.Column="1">
                                    <Grid>
                                        <Grid.Background>
                                            <LinearGradientBrush StartPoint="0.459,1.296" EndPoint="0.457,0.296">
                                                <GradientStop Color="#FFCBCBCB" />
                                                <GradientStop Offset="1" />
                                            </LinearGradientBrush>
                                        </Grid.Background>
                                    </Grid>
                                    <Viewbox Stretch="Fill">
                                        <Canvas Width="90" Height="60">
                                            <Polyline Stroke="#FFFF0C0F" StrokeLineJoin="Round" StrokeThickness="3" Points="0,10 10,10 20,50 30,50 40,20 50,20 60,40 70,40 80,40 90,10" />
                                        </Canvas>
                                    </Viewbox>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="HMITrending2Designer" TargetType="{x:Type local:HMITrending2}">
        <Setter Property="Control.IsTabStop" Value="False" />
        <Setter Property="UIElement.Opacity" Value="{Binding Path=Opacity}" />
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HMITrending2}">
                    <Grid IsHitTestVisible="False" Background="#FFFFFFFF">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Border BorderBrush="#FF000000" BorderThickness="1" Padding="10">
                                <Grid Margin="0,15">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="1" Margin="15,0" VerticalAlignment="Center">
                                            <Border BorderBrush="#FFDBDBDB" BorderThickness="1" Padding="2">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0.558,0.995" EndPoint="0.442,0.005">
                                                        <GradientStop Color="#FFDBDBDB" />
                                                        <GradientStop Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <Grid>
                                                    <Border CornerRadius="2">
                                                        <Border.BorderBrush>
                                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                                <GradientStop Color="#FFA3AEB9" />
                                                                <GradientStop Color="#FF8399A9" Offset="0.375" />
                                                                <GradientStop Color="#FF718597" Offset="0.375" />
                                                                <GradientStop Color="#FF617584" Offset="1" />
                                                            </LinearGradientBrush>
                                                        </Border.BorderBrush>
                                                        <StackPanel Margin="10,10,10,10">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Rectangle Width="8" Height="8" Margin="0,0,3,0" Fill="#FF297FEF" Stroke="#FF808080" Stretch="Fill" />
                                                                <TextBlock HorizontalAlignment="Left" VerticalAlignment="Top" Text="Signal1" TextBlock.FontSize="11" />
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal">
                                                                <Rectangle Width="8" Height="8" Margin="0,0,3,0" Fill="#FF3BDC0F" Stroke="#FF808080" Stretch="Fill" />
                                                                <TextBlock HorizontalAlignment="Left" VerticalAlignment="Top" Text="Signal2" TextBlock.FontSize="11" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                        <Grid MinWidth="100" MinHeight="75">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid>
                                                <UniformGrid Columns="1">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="80" TextBlock.FontSize="11" />
                                                        <Line Stroke="#FF000000" Y1="6" X2="4" Y2="6" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="60" TextBlock.FontSize="11" />
                                                        <Line Stroke="#FF000000" Y1="6" X2="4" Y2="6" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="40" TextBlock.FontSize="11" />
                                                        <Line Stroke="#FF000000" Y1="6" X2="4" Y2="6" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="20" TextBlock.FontSize="11" />
                                                        <Line Stroke="#FF000000" Y1="6" X2="4" Y2="6" />
                                                    </StackPanel>
                                                </UniformGrid>
                                            </Grid>
                                            <Grid Grid.Column="1">
                                                <Grid>
                                                    <Grid.Background>
                                                        <LinearGradientBrush StartPoint="0.459,1.296" EndPoint="0.457,0.296">
                                                            <GradientStop Color="#FFCBCBCB" />
                                                            <GradientStop Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Grid.Background>
                                                </Grid>
                                                <Border BorderBrush="#FF919191" BorderThickness="1" />
                                                <UniformGrid Columns="4">
                                                    <Line Stroke="#FF808080" X1="10" X2="10" Y2="2000" />
                                                    <Line Stroke="#FF808080" X1="10" X2="10" Y2="2000" />
                                                    <Line Stroke="#FF808080" X1="10" X2="10" Y2="2000" />
                                                    <Line Stroke="#FF808080" X1="10" X2="10" Y2="2000" />
                                                </UniformGrid>
                                                <Viewbox Stretch="Fill">
                                                    <Canvas Width="1000" Height="500">
                                                        <Polyline Stroke="#FF032DF6" StrokeLineJoin="Round" StrokeThickness="4" Points="0,400 100,400 200,300 300,300 400,300 500,300 600,400 700,400 800,300 900,200 1000,200" />
                                                        <Polyline Stroke="#FF3BDC0F" StrokeLineJoin="Round" StrokeThickness="4" Points="0,100 100,100 200,200 300,300 400,200 500,200 600,500 700,400 800,400 900,100 1000,200" />
                                                    </Canvas>
                                                </Viewbox>
                                            </Grid>
                                            <Grid Grid.Row="1" Grid.Column="1">
                                                <UniformGrid Columns="4">
                                                    <Line Stroke="#FF000000" X1="10" X2="10" Y2="4" />
                                                    <Line Stroke="#FF000000" X1="10" X2="10" Y2="4" />
                                                    <Line Stroke="#FF000000" X1="10" X2="10" Y2="4" />
                                                    <Line Stroke="#FF000000" X1="10" X2="10" Y2="4" />
                                                    <TextBlock Text="2:25 PM" TextBlock.FontSize="11" />
                                                    <TextBlock Text="2:26 PM" TextBlock.FontSize="11" />
                                                    <TextBlock Text="2:27 PM" TextBlock.FontSize="11" />
                                                    <TextBlock Text="2:28 PM" TextBlock.FontSize="11" />
                                                </UniformGrid>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                        <Grid Focusable="False" Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                                <Grid Width="32" Height="32" Margin="0,3,7,0">
                                    <Grid>
                                        <Border BorderThickness="1" CornerRadius="3">
                                            <Border.BorderBrush>
                                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                    <GradientStop Color="#FFA3AEB9" />
                                                    <GradientStop Color="#FF8399A9" Offset="0.375" />
                                                    <GradientStop Color="#FF718597" Offset="0.375" />
                                                    <GradientStop Color="#FF617584" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.BorderBrush>
                                            <Grid Margin="1" Background="#FF1F3B53">
                                                <Border Opacity="0" Background="#FF448DCA" />
                                                <Rectangle Stretch="Fill">
                                                    <Rectangle.Fill>
                                                        <LinearGradientBrush StartPoint="0.7,1" EndPoint="0.7,0">
                                                            <GradientStop />
                                                            <GradientStop Color="#F9FFFFFF" Offset="0.375" />
                                                            <GradientStop Color="#E5FFFFFF" Offset="0.625" />
                                                            <GradientStop Color="#C6FFFFFF" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Rectangle.Fill>
                                                </Rectangle>
                                            </Grid>
                                        </Border>
                                        <ContentControl Margin="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Grid>
                                                <Image Source="Images/TrendingStartPaused.png" />
                                            </Grid>
                                        </ContentControl>
                                        <Rectangle Opacity="0" IsHitTestVisible="False" Stretch="Fill" RadiusX="3" RadiusY="3" />
                                        <Rectangle Margin="1" Opacity="0" IsHitTestVisible="False" Stroke="#FF6DBDD1" Stretch="Fill" RadiusX="2" RadiusY="2" />
                                    </Grid>
                                </Grid>
                                <Grid Width="32" Height="32" Margin="0,3,0,0">
                                    <Border BorderThickness="1" CornerRadius="3">
                                        <Border.BorderBrush>
                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                <GradientStop Color="#FFA3AEB9" />
                                                <GradientStop Color="#FF8399A9" Offset="0.375" />
                                                <GradientStop Color="#FF718597" Offset="0.375" />
                                                <GradientStop Color="#FF617584" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.BorderBrush>
                                        <Grid Margin="1" Background="#FF1F3B53">
                                            <Border Opacity="0" Background="#FF448DCA" />
                                            <Rectangle Stretch="Fill">
                                                <Rectangle.Fill>
                                                    <LinearGradientBrush StartPoint="0.7,0" EndPoint="0.7,1">
                                                        <GradientStop />
                                                        <GradientStop Color="#F9FFFFFF" Offset="0.375" />
                                                        <GradientStop Color="#E5FFFFFF" Offset="0.625" />
                                                        <GradientStop Color="#C6FFFFFF" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Rectangle.Fill>
                                            </Rectangle>
                                        </Grid>
                                    </Border>
                                    <Image Margin="3" Source="Images/TrendingConfig.png" />
                                </Grid>
                                <Grid Width="32" Height="32" Margin="7,3,0,0">
                                    <Border BorderThickness="1" CornerRadius="3">
                                        <Border.BorderBrush>
                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                <GradientStop Color="#FFA3AEB9" />
                                                <GradientStop Color="#FF8399A9" Offset="0.375" />
                                                <GradientStop Color="#FF718597" Offset="0.375" />
                                                <GradientStop Color="#FF617584" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.BorderBrush>
                                        <Grid Margin="1" Background="#FF1F3B53">
                                            <Border Opacity="0" Background="#FF448DCA" />
                                            <Rectangle Stretch="Fill">
                                                <Rectangle.Fill>
                                                    <LinearGradientBrush StartPoint="0.7,0" EndPoint="0.7,1">
                                                        <GradientStop />
                                                        <GradientStop Color="#F9FFFFFF" Offset="0.375" />
                                                        <GradientStop Color="#E5FFFFFF" Offset="0.625" />
                                                        <GradientStop Color="#C6FFFFFF" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Rectangle.Fill>
                                            </Rectangle>
                                        </Grid>
                                    </Border>
                                    <Image Margin="3" Source="Images/TrendingConfigLoad.png" />
                                </Grid>
                                <Grid Width="32" Height="32" Margin="7,3,0,0">
                                    <Border BorderThickness="1" CornerRadius="3">
                                        <Border.BorderBrush>
                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                <GradientStop Color="#FFA3AEB9" />
                                                <GradientStop Color="#FF8399A9" Offset="0.375" />
                                                <GradientStop Color="#FF718597" Offset="0.375" />
                                                <GradientStop Color="#FF617584" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.BorderBrush>
                                        <Grid Margin="1" Background="#FF1F3B53">
                                            <Border Opacity="0" Background="#FF448DCA" />
                                            <Rectangle Stretch="Fill">
                                                <Rectangle.Fill>
                                                    <LinearGradientBrush StartPoint="0.7,0" EndPoint="0.7,1">
                                                        <GradientStop />
                                                        <GradientStop Color="#F9FFFFFF" Offset="0.375" />
                                                        <GradientStop Color="#E5FFFFFF" Offset="0.625" />
                                                        <GradientStop Color="#C6FFFFFF" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Rectangle.Fill>
                                            </Rectangle>
                                        </Grid>
                                    </Border>
                                    <Image Margin="3" Source="Images/TrendingConfigSave.png" />
                                </Grid>
                                <Grid Width="32" Height="32" Margin="7,3,0,0">
                                    <Border BorderThickness="1" CornerRadius="3">
                                        <Border.BorderBrush>
                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                <GradientStop Color="#FFA3AEB9" />
                                                <GradientStop Color="#FF8399A9" Offset="0.375" />
                                                <GradientStop Color="#FF718597" Offset="0.375" />
                                                <GradientStop Color="#FF617584" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.BorderBrush>
                                        <Grid Margin="1" Background="#FF1F3B53">
                                            <Border Opacity="0" Background="#FF448DCA" />
                                            <Rectangle Stretch="Fill">
                                                <Rectangle.Fill>
                                                    <LinearGradientBrush StartPoint="0.7,0" EndPoint="0.7,1">
                                                        <GradientStop />
                                                        <GradientStop Color="#F9FFFFFF" Offset="0.375" />
                                                        <GradientStop Color="#E5FFFFFF" Offset="0.625" />
                                                        <GradientStop Color="#C6FFFFFF" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Rectangle.Fill>
                                            </Rectangle>
                                        </Grid>
                                    </Border>
                                    <Image Margin="3" Source="Images/TrendingRange.png" />
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal">
                                <RepeatButton Focusable="False" Width="32" Height="32" Margin="0, 3, 0, 0">
                                    <Path Fill="#FF000000" Data="M5,10L15,5 15,15 5,10" Width="10" Height="8" Stretch="Fill" />
                                </RepeatButton>
                                <RepeatButton Focusable="False" Width="32" Height="32" Margin="0, 3, 0, 0">
                                    <Path Fill="#FF000000" Data="M15,10L5,15 5,5 15,10" Width="10" Height="8" Stretch="Fill" />
                                </RepeatButton>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>